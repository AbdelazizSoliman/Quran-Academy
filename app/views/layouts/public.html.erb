<!DOCTYPE html>
<html lang="<%= @public_site.locale %>" dir="<%= @public_site.rtl? ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for(:title) || @public_site.academy_name %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="description" content="<%= @public_site.hero_subtitle.presence || t("public.meta_description") %>">
    <meta name="theme-color" content="<%= @public_site.primary_color %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>
  <body class="min-h-screen bg-[#fbfcfa] text-slate-900 antialiased"
        style="--public-primary: <%= @public_site.primary_color %>; --public-accent: <%= @public_site.secondary_color %>">
    <a href="#main-content" class="sr-only z-50 rounded-md bg-white px-4 py-2 text-emerald-900 focus:not-sr-only focus:fixed focus:start-4 focus:top-4">
      <%= t("accessibility.skip_to_content") %>
    </a>
    <header class="border-b border-emerald-950/10 bg-white/95">
      <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
        <%= link_to localized_public_home_path(locale: @public_site.locale), class: "flex min-w-0 items-center gap-3" do %>
          <% if @public_site.logo_url.present? %>
            <%= image_tag @public_site.logo_url, alt: "", class: "size-11 rounded-xl object-contain" %>
          <% else %>
            <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-[var(--public-primary)] text-xl font-bold text-white" aria-hidden="true">خ</span>
          <% end %>
          <span class="truncate text-base font-bold text-emerald-950 sm:text-lg"><%= @public_site.academy_name %></span>
        <% end %>
        <nav aria-label="<%= t("public.navigation.label") %>" class="flex items-center gap-2 sm:gap-3">
          <% if public_programs_available? || public_programs_admin? %>
            <%= link_to t("public.navigation.programs"),
                        public_programs_available? ? public_programs_path(locale: @public_site.locale) : admin_website_programs_path,
                        class: "hidden rounded-lg px-2.5 py-2 text-sm font-semibold text-emerald-900 hover:bg-emerald-50 sm:inline-flex" %>
          <% end %>
          <%= link_to t("public.navigation.fees"), public_fees_path(locale: @public_site.locale),
                      class: "hidden rounded-lg px-2.5 py-2 text-sm font-semibold text-emerald-900 hover:bg-emerald-50 sm:inline-flex" %>
          <%= link_to t("public.navigation.contact"), public_contact_path(locale: @public_site.locale),
                      class: "hidden rounded-lg px-2.5 py-2 text-sm font-semibold text-emerald-900 hover:bg-emerald-50 md:inline-flex" %>
          <%= link_to t("public.navigation.locale_switch"),
                      localized_public_home_path(locale: @public_site.locale == "ar" ? "en" : "ar"),
                      hreflang: (@public_site.locale == "ar" ? "en" : "ar"),
                      class: "rounded-lg px-2.5 py-2 text-sm font-semibold text-emerald-900 hover:bg-emerald-50" %>
          <%= link_to t("public.navigation.login"), new_user_session_path(locale: @public_site.locale),
                      class: "hidden rounded-lg px-3 py-2 text-sm font-semibold text-emerald-900 hover:bg-emerald-50 sm:inline-flex" %>
          <%= link_to @public_site.primary_cta_label, @public_site.primary_cta_url,
                      class: "inline-flex rounded-lg bg-[var(--public-primary)] px-3.5 py-2.5 text-sm font-bold text-white shadow-sm hover:opacity-90" %>
        </nav>
      </div>
    </header>

    <main id="main-content"><%= yield %></main>

    <footer class="border-t border-emerald-950/10 bg-emerald-950 py-10 text-emerald-50">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:grid-cols-2 sm:px-6 lg:px-8">
        <div>
          <p class="text-lg font-bold"><%= @public_site.academy_name %></p>
          <p class="mt-2 max-w-md text-sm leading-6 text-emerald-100/75"><%= t("public.footer.summary") %></p>
        </div>
        <div class="flex flex-col items-start gap-2 text-sm sm:items-end">
          <%= mail_to @public_site.email, @public_site.email, class: "hover:text-white" if @public_site.email.present? %>
          <%= link_to @public_site.phone, "tel:#{@public_site.phone}", class: "hover:text-white", dir: "ltr" if @public_site.phone.present? %>
          <%= link_to t("public.footer.whatsapp"), @public_site.whatsapp_url, class: "hover:text-white", rel: "noopener" if @public_site.whatsapp.present? %>
          <% if public_programs_available? || public_programs_admin? %>
            <%= link_to t("public.navigation.programs"),
                        public_programs_available? ? public_programs_path(locale: @public_site.locale) : admin_website_programs_path,
                        class: "mt-2 hover:text-white" %>
          <% end %>
          <%= link_to t("public.navigation.fees"), public_fees_path(locale: @public_site.locale), class: "hover:text-white" %>
          <%= link_to t("public.navigation.trial"), public_trial_path(locale: @public_site.locale), class: "hover:text-white" %>
          <%= link_to t("public.navigation.contact"), public_contact_path(locale: @public_site.locale), class: "hover:text-white" %>
          <%= link_to t("public.navigation.login"), new_user_session_path(locale: @public_site.locale), class: "hover:text-white" %>
        </div>
      </div>
    </footer>
  </body>
</html>
