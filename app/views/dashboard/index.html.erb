<% content_for :title, "#{t("dashboard.title")} | #{t("app.name")}" %>
<%= render "shared/page_header",
           title: t("dashboard.title"),
           description: t("dashboard.subtitle"),
           badge: render("shared/components/badge", label: t("dashboard.placeholder_badge"), variant: :neutral) %>

<section class="ds-card relative mb-6 overflow-hidden border-app-primary bg-app-primary p-6 text-white sm:p-8" aria-labelledby="welcome-title">
  <div class="relative z-10 max-w-2xl">
    <p class="mb-2 text-sm font-medium text-emerald-100"><%= t("dashboard.welcome_eyebrow") %></p>
    <h2 id="welcome-title" class="text-2xl font-bold sm:text-3xl"><%= t("dashboard.welcome") %></h2>
    <p class="mt-3 max-w-xl text-sm leading-7 text-emerald-50"><%= t("dashboard.welcome_message") %></p>
    <div class="mt-5 flex flex-wrap gap-3">
      <%= render "shared/components/button", label: t("dashboard.view_schedule"), variant: :secondary, icon: :calendar %>
      <%= render "shared/components/button", label: t("dashboard.attendance_report"), variant: :outline, icon: :check, class: "border-white text-white hover:bg-white/10 focus-visible:outline-white" %>
    </div>
  </div>
</section>

<section aria-labelledby="statistics-title">
  <h2 id="statistics-title" class="sr-only"><%= t("dashboard.placeholder_badge") %></h2>
  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
    <% %i[students teachers lessons attendance].each do |stat| %>
      <%= render "shared/components/stat_card",
                 label: t("dashboard.statistics.#{stat}"),
                 value: t("dashboard.statistics.#{stat}_value"),
                 note: t("dashboard.statistics.#{stat}_note"),
                 icon: (stat == :lessons ? :calendar : :information) %>
    <% end %>
  </div>
</section>

<div class="mt-6 grid gap-6 xl:grid-cols-3">
  <% lessons = capture do %>
    <div class="divide-y divide-app-border">
      <% [
        [t("dashboard.lesson_one"), t("dashboard.teacher_one"), "10:00", t("dashboard.room_one"), t("dashboard.soon")],
        [t("dashboard.lesson_two"), t("dashboard.teacher_two"), "11:30", t("dashboard.room_two"), t("dashboard.upcoming")],
        [t("dashboard.lesson_three"), t("dashboard.teacher_three"), "13:00", t("dashboard.remote"), t("dashboard.upcoming")]
      ].each do |lesson, teacher, time, room, status| %>
        <article class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center">
          <time class="w-20 text-sm font-bold text-app-primary"><%= time %></time>
          <div class="min-w-0 flex-1">
            <h3 class="truncate text-sm font-semibold text-app-text"><%= lesson %></h3>
            <p class="mt-1 ds-caption"><%= teacher %> · <%= room %></p>
          </div>
          <%= render "shared/components/badge", label: status, variant: :success %>
        </article>
      <% end %>
    </div>
  <% end %>
  <div class="xl:col-span-2">
    <%= render "shared/components/card",
               title: t("dashboard.today_lessons"),
               subtitle: t("dashboard.upcoming_lessons"),
               header_action: render("shared/components/button", label: t("actions.view_all"), variant: :ghost, size: :small),
               body: lessons,
               body_class: "p-0" %>
  </div>

  <%= render "shared/components/card",
             title: t("dashboard.late_title"),
             subtitle: t("dashboard.late_subtitle"),
             body: render("shared/components/empty_state",
                          title: t("dashboard.late_empty_title"),
                          description: t("dashboard.late_empty_description"),
                          icon: :check_circle) %>
</div>

<% quick_actions = capture do %>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <% [
      [t("dashboard.record_attendance"), :check],
      [t("dashboard.add_lesson"), :plus],
      [t("dashboard.send_reminder"), :information],
      [t("dashboard.view_reports"), :arrow]
    ].each do |label, action_icon| %>
      <%= render "shared/components/button", label:, icon: action_icon, variant: :secondary, disabled: true, class: "justify-start" %>
    <% end %>
  </div>
<% end %>
<div class="mt-6">
  <%= render "shared/components/card",
             title: t("dashboard.quick_actions"),
             subtitle: t("dashboard.quick_actions_description"),
             body: quick_actions %>
</div>
