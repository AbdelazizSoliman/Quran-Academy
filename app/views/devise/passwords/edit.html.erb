<% content_for :title, t("authentication.passwords.reset_page_title", app: t("app.name")) %>
<header class="mb-6">
  <h1 class="ds-page-title"><%= t("authentication.passwords.reset_title") %></h1>
  <p class="mt-2 ds-supporting"><%= t("authentication.passwords.reset_description") %></p>
</header>

<%= form_with model: resource, as: resource_name, url: password_path(resource_name, locale: I18n.locale), method: :put, class: "space-y-5", data: { turbo: false } do |form| %>
  <%= render "devise/shared/error_messages", resource: %>
  <%= form.hidden_field :reset_password_token %>
  <div class="space-y-1.5">
    <%= form.label :password, t("authentication.fields.new_password"), class: "ds-label" %>
    <%= form.password_field :password, autofocus: true, autocomplete: "new-password", required: true, class: "ds-control" %>
    <p class="ds-caption"><%= t("authentication.passwords.minimum", count: @minimum_password_length || 8) %></p>
  </div>
  <div class="space-y-1.5">
    <%= form.label :password_confirmation, t("authentication.fields.password_confirmation"), class: "ds-label" %>
    <%= form.password_field :password_confirmation, autocomplete: "new-password", required: true, class: "ds-control" %>
  </div>
  <%= render "shared/components/button", label: t("authentication.passwords.update"), type: "submit", class: "w-full" %>
<% end %>
<%= render "devise/shared/links" %>
