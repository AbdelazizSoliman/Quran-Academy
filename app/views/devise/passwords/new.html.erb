<% content_for :title, t("authentication.passwords.forgot_page_title", app: t("app.name")) %>
<header class="mb-6">
  <h1 class="ds-page-title"><%= t("authentication.passwords.forgot_title") %></h1>
  <p class="mt-2 ds-supporting"><%= t("authentication.passwords.forgot_description") %></p>
</header>

<%= form_with model: resource, as: resource_name, url: password_path(resource_name, locale: I18n.locale), method: :post, class: "space-y-5", data: { turbo: false } do |form| %>
  <%= render "devise/shared/error_messages", resource: %>
  <div class="space-y-1.5">
    <%= form.label :email, t("authentication.fields.email"), class: "ds-label" %>
    <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "ds-control", dir: "ltr" %>
    <p class="ds-caption"><%= t("authentication.passwords.email_hint") %></p>
  </div>
  <%= render "shared/components/button", label: t("authentication.passwords.send"), type: "submit", class: "w-full" %>
<% end %>
<%= render "devise/shared/links" %>
