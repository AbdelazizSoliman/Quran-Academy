<%= render "shared/page_header", title: @expense.public_id, description: @expense.description %><%= render "admin/finance/navigation" %>
<div class="ds-card grid gap-4 p-6 sm:grid-cols-4"><div><p class="ds-caption"><%= t("finance.fields.amount") %></p><strong dir="ltr"><%= number_to_currency(@expense.amount, unit: @expense.currency) %></strong></div><div><p class="ds-caption"><%= t("finance.fields.category") %></p><strong><%= t("finance.expense_categories.#{@expense.category}") %></strong></div><div><p class="ds-caption"><%= t("finance.fields.incurred_on") %></p><strong><%= l(@expense.incurred_on) %></strong></div><div><p class="ds-caption"><%= t("finance.fields.status") %></p><strong><%= t("finance.expense_statuses.#{@expense.status}") %></strong></div></div>
<div class="mt-5 flex gap-3"><%= button_to t("finance.actions.approve"), approve_admin_finance_expense_path(@expense), method: :patch, class: button_classes if @expense.status == "draft" %><%= button_to t("finance.actions.pay"), pay_admin_finance_expense_path(@expense), method: :patch, class: button_classes if @expense.status == "approved" %><%= button_to t("finance.actions.cancel"), cancel_admin_finance_expense_path(@expense), method: :patch, class: button_classes(variant: :secondary) if @expense.status.in?(%w[draft approved]) %></div>
