<%= render "shared/page_header", title: t("academic.dashboard.admin") %><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% @metrics.each do |key, value| %><div class="ds-card p-5"><p class="ds-caption"><%= t("academic.metrics.#{key}") %></p><p class="mt-2 text-2xl font-bold"><%= value || t("academic.not_available") %></p></div><% end %></div><div class="mt-6 grid gap-6 lg:grid-cols-2"><div class="ds-card p-5"><h2 class="font-bold"><%= t("academic.highest_performers") %></h2><ol class="mt-3 space-y-2"><% @top_students.each do |progress| %><li><%= progress.student_profile.user.full_name %> — <%= progress.average_score %></li><% end %></ol></div><div class="ds-card p-5"><h2 class="font-bold"><%= t("academic.needs_attention") %></h2><ol class="mt-3 space-y-2"><% @attention_students.each do |progress| %><li><%= progress.student_profile.user.full_name %></li><% end %></ol></div></div>
