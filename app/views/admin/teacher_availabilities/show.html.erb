<%= render "shared/page_header", title: @availability.public_id, description: @availability.teacher_profile.display_name %><%= render "shared/components/card", title: t("scheduling.sections.availability") do %><dl class="grid gap-3 sm:grid-cols-2"><div><dt class="ds-caption"><%= t("scheduling.fields.weekday") %></dt><dd><%= t("scheduling.catalogs.weekdays.#{@availability.weekday}") %></dd></div><div><dt class="ds-caption"><%= t("scheduling.fields.time") %></dt><dd dir="ltr"><%= @availability.starts_at_local.strftime("%H:%M") %>–<%= @availability.ends_at_local.strftime("%H:%M") %> · <%= @availability.time_zone %></dd></div></dl><div class="mt-4 flex gap-2"><%= render "shared/components/button", label: t("actions.edit"), href: edit_admin_teacher_availability_path(@availability), variant: :secondary %><%= button_to t("actions.archive"), archive_admin_teacher_availability_path(@availability), method: :patch, class: button_classes(variant: :danger) unless @availability.archived? %></div><% end %><%= render "shared/components/card", title: t("scheduling.sections.audit") do %><% @events.each do |event| %><p class="text-sm"><%= t("scheduling.catalogs.events.#{event.event_type}") %> · <%= event.actor.full_name %></p><% end %><% end %>
