<%= render "shared/academic/errors", record: availability %>
<%= form_with model: local_assigns.fetch(:form_model, [:admin, availability]), url: local_assigns[:form_url], class: "space-y-6" do |f| %>
  <fieldset class="ds-card p-5"><legend class="ds-section-title"><%= t("scheduling.sections.availability") %></legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><% unless availability.persisted? %><div><%= f.label :teacher_profile_id, t("scheduling.fields.teacher"), class: "ds-label" %><%= f.collection_select :teacher_profile_id, teachers, :id, :display_name, { include_blank: true }, class: "ds-control mt-2" %></div><% end %><div><%= f.label :weekday, t("scheduling.fields.weekday"), class: "ds-label" %><%= f.select :weekday, TeacherAvailability::WEEKDAYS.map { |v| [t("scheduling.catalogs.weekdays.#{v}"), v] }, {}, class: "ds-control mt-2" %></div><div><%= f.label :starts_at_local, t("scheduling.fields.starts_at_local"), class: "ds-label" %><%= f.time_field :starts_at_local, class: "ds-control mt-2" %></div><div><%= f.label :ends_at_local, t("scheduling.fields.ends_at_local"), class: "ds-label" %><%= f.time_field :ends_at_local, class: "ds-control mt-2" %></div><div><%= f.label :time_zone, t("scheduling.fields.time_zone"), class: "ds-label" %><%= f.select :time_zone, ActiveSupport::TimeZone.all.map { |z| [z.name, z.name] }, {}, class: "ds-control mt-2" %></div><div><%= f.label :effective_from, t("scheduling.fields.effective_from"), class: "ds-label" %><%= f.date_field :effective_from, class: "ds-control mt-2" %></div><div><%= f.label :effective_until, t("scheduling.fields.effective_until"), class: "ds-label" %><%= f.date_field :effective_until, class: "ds-control mt-2" %></div><div><%= f.label :availability_type, t("scheduling.fields.availability_type"), class: "ds-label" %><%= f.select :availability_type, TeacherAvailability::AVAILABILITY_TYPES.map { |v| [t("scheduling.catalogs.availability_types.#{v}"), v] }, {}, class: "ds-control mt-2" %></div></div><div class="mt-4"><%= f.label :notes, t("scheduling.fields.notes"), class: "ds-label" %><%= f.text_area :notes, rows: 3, class: "ds-control mt-2" %></div></fieldset>
  <div class="flex gap-3"><%= render "shared/components/button", label: t("actions.save"), type: :submit %><%= render "shared/components/button", label: t("actions.cancel"), href: local_assigns.fetch(:cancel_url, admin_teacher_availabilities_path), variant: :secondary %></div>
<% end %>
