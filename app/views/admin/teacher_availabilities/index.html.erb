<%= render "shared/page_header", title: t("scheduling.availability.title"), description: t("scheduling.availability.description"), primary_action: render("shared/components/button", label: t("scheduling.actions.new_availability"), href: new_admin_teacher_availability_path) %>
<div class="overflow-x-auto rounded-2xl border border-app-border bg-app-surface"><table class="min-w-full text-sm"><thead class="bg-app-muted"><tr><th class="px-4 py-3 text-start"><%= t("scheduling.fields.teacher") %></th><th class="px-4 py-3 text-start"><%= t("scheduling.fields.weekday") %></th><th class="px-4 py-3 text-start"><%= t("scheduling.fields.time") %></th><th class="px-4 py-3 text-start"><%= t("scheduling.fields.status") %></th></tr></thead><tbody class="divide-y divide-app-border"><% @availabilities.each do |availability| %><tr><td class="px-4 py-3"><%= link_to availability.teacher_profile.display_name, admin_teacher_availability_path(availability), class: "text-app-primary" %></td><td class="px-4 py-3"><%= t("date.day_names")[Date::DAYNAMES.index(availability.weekday.capitalize)] rescue availability.weekday %></td><td class="px-4 py-3" dir="ltr"><%= l(availability.starts_at_local, format: :time) %>–<%= l(availability.ends_at_local, format: :time) %> · <%= availability.time_zone %></td><td class="px-4 py-3"><%= availability.status %></td></tr><% end %></tbody></table></div>
<% if @availabilities.empty? %><%= render "shared/components/empty_state", icon: :calendar, title: t("scheduling.empty.title"), description: t("scheduling.empty.description") %><% end %>
