<%= render "shared/page_header", title: t("reports.types.#{@dataset.title}"), primary_action: { label: t("reports.actions.export_csv"), href: export_admin_operational_report_path(@dataset.title, request.query_parameters) } %>
<%= form_with url: admin_operational_report_path(@dataset.title), method: :get, class: "ds-card mb-6 grid gap-4 p-4 sm:grid-cols-4" do |form| %><div><%= form.label :from, t("payroll.filters.from"), class: "ds-label" %><%= form.date_field :from, value: params[:from], class: "ds-control mt-2" %></div><div><%= form.label :to, t("payroll.filters.to"), class: "ds-label" %><%= form.date_field :to, value: params[:to], class: "ds-control mt-2" %></div><div><%= form.label :status, t("payroll.fields.status"), class: "ds-label" %><%= form.text_field :status, value: params[:status], class: "ds-control mt-2" %></div><div class="self-end"><%= render "shared/components/button", label: t("reports.actions.filter"), type: :submit %></div><% end %>
<div class="space-y-3"><% @dataset.rows.each do |row| %><article class="ds-card grid gap-2 p-4 sm:grid-cols-3"><% @dataset.headers.zip(row).each do |header, value| %><div><span class="ds-caption"><%= t("reports.columns.#{header}", default: header.humanize) %></span><p><%= value %></p></div><% end %></article><% end %></div>
