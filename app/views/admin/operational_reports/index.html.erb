<%= render "shared/page_header", title: t("reports.admin.title"), description: t("reports.admin.description") %>
<section class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4" aria-label="<%= t("reports.kpis") %>"><% @metrics.each do |key, value| %><article class="ds-card p-4"><p class="ds-caption"><%= t("reports.metrics.#{key}") %></p><p class="mt-2 text-2xl font-bold"><%= value %><%= "%" if key == :attendance_percentage %></p></article><% end %></section>
<section class="mt-8"><h2 class="text-xl font-semibold"><%= t("reports.available") %></h2><div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><% @report_types.each do |type| %><%= link_to admin_operational_report_path(type), class: "ds-card p-5 font-semibold focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" do %><%= t("reports.types.#{type}") %><% end %><% end %></div></section>
