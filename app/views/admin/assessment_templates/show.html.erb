<%= render "shared/page_header", title: @template.localized_name, description: @template.description, primary_action: render("shared/components/button", label: t("actions.edit"), href: edit_admin_assessment_template_path(@template)) %>
<div class="ds-card p-5"><h2 class="font-bold"><%= t("academic.rubrics.title") %></h2><ol class="mt-4 divide-y divide-app-border"><% @template.rubric_items.each do |item| %><li class="py-3"><strong><%= item.localized_name %></strong><p class="ds-caption"><%= item.assessment_category.localized_name %> · <%= t("academic.scoring_types.#{item.scoring_type}") %> · <%= t("academic.weight", value: item.weight) %></p></li><% end %></ol></div>
<div class="mt-6 ds-card p-5"><h2 class="font-bold"><%= t("academic.rubrics.add") %></h2><%= form_with model: [:admin, @template, AssessmentRubricItem.new], class: "mt-4 grid gap-4 sm:grid-cols-2" do |form| %><%= form.collection_select :assessment_category_id, AssessmentCategory.where(active: true).ordered, :id, ->(category) { category.localized_name }, {}, class: "ds-control" %><%= form.text_field :name_ar, placeholder: t("academic.fields.name_ar"), class: "ds-control", required: true %><%= form.text_field :name_en, placeholder: t("academic.fields.name_en"), class: "ds-control", required: true %><%= form.select :scoring_type, AssessmentRubricItem::SCORING_TYPES.map { |type| [t("academic.scoring_types.#{type}"), type] }, {}, class: "ds-control" %><%= form.number_field :maximum_score, value: 100, min: 1, class: "ds-control" %><%= form.number_field :weight, value: 1, min: 0.01, step: 0.01, class: "ds-control" %><%= render "shared/components/button", label: t("actions.save"), type: "submit" %><% end %></div>
