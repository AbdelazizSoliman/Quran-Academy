<%= render "shared/page_header", title: t("academic.templates.index"), description: t("academic.templates.description"), primary_action: render("shared/components/button", label: t("academic.actions.new_template"), href: new_admin_assessment_template_path, icon: :plus) %>
<div class="grid gap-4 sm:grid-cols-2"><% @templates.each do |template| %><article class="ds-card p-5"><h2 class="font-bold"><%= link_to template.localized_name, admin_assessment_template_path(template), class: "text-app-primary" %></h2><p class="mt-2 ds-caption"><%= t("academic.template_statuses.#{template.status}") %> · <%= t("academic.rubric_count", count: template.rubric_items.size) %></p></article><% end %></div>
