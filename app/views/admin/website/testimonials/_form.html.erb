<% if testimonial.errors.any? %><%= render "shared/components/alert", variant: :error, title: t("admin.website.shared.errors"), message: testimonial.errors.full_messages.to_sentence %><% end %>
<%= form_with model: testimonial, url: testimonial.persisted? ? admin_website_testimonial_path(testimonial) : admin_website_testimonials_path, class: "space-y-6" do |form| %>
  <%= render "shared/components/card", title: t("admin.website.shared.content"), body: capture { %>
    <div class="grid gap-5 sm:grid-cols-2"><% %i[author_name relationship].each do |field| %><div><%= form.label field, t("admin.website.testimonials.fields.#{field}"), class: "ds-label" %><%= form.text_field field, class: "ds-control mt-2" %></div><% end %><% %i[quote_ar quote_en].each do |field| %><div><%= form.label field, t("admin.website.testimonials.fields.#{field}"), class: "ds-label" %><%= form.text_area field, rows: 6, class: "ds-control mt-2 h-auto", dir: field.to_s.end_with?("_ar") ? "rtl" : "ltr" %></div><% end %></div>
    <p class="mt-4 ds-supporting"><%= t("admin.website.testimonials.privacy_hint") %></p>
  <% } %>
  <%= render "shared/components/card", title: t("admin.website.shared.publication"), body: capture { %><label class="flex gap-3"><%= form.check_box :published, class: "ds-checkbox" %><%= t("admin.website.shared.published") %></label><%= form.label :public_display_order, t("admin.website.shared.order"), class: "ds-label mt-5" %><%= form.number_field :public_display_order, min: 0, class: "ds-control mt-2" %><% } %>
  <div class="flex justify-end gap-2"><%= link_to t("actions.cancel"), admin_website_testimonials_path, class: button_classes(variant: :secondary) %><%= render "shared/components/button", label: t("actions.save"), type: "submit" %><% if testimonial.persisted? %><%= button_to t("actions.delete"), admin_website_testimonial_path(testimonial), method: :delete, class: button_classes(variant: :danger), form: { data: { turbo_confirm: t("admin.website.shared.confirm_delete") } } %><% end %></div>
<% end %>
