<% if faq.errors.any? %><%= render "shared/components/alert", variant: :error, title: t("admin.website.shared.errors"), message: faq.errors.full_messages.to_sentence %><% end %>
<%= form_with model: faq, url: faq.persisted? ? admin_website_faq_path(faq) : admin_website_faqs_path, class: "space-y-6" do |form| %>
  <%= render "shared/components/card", title: t("admin.website.shared.content"), body: capture { %>
    <div class="grid gap-5 sm:grid-cols-2"><% %i[question_ar question_en answer_ar answer_en].each do |field| %><div><%= form.label field, t("admin.website.faqs.fields.#{field}"), class: "ds-label" %><% if field.to_s.start_with?("answer") %><%= form.text_area field, rows: 6, class: "ds-control mt-2 h-auto", dir: field.to_s.end_with?("_ar") ? "rtl" : "ltr" %><% else %><%= form.text_field field, class: "ds-control mt-2", dir: field.to_s.end_with?("_ar") ? "rtl" : "ltr" %><% end %></div><% end %></div>
  <% } %>
  <%= render "shared/components/card", title: t("admin.website.shared.publication"), body: capture { %><label class="flex gap-3"><%= form.check_box :published, class: "ds-checkbox" %><%= t("admin.website.shared.published") %></label><%= form.label :public_display_order, t("admin.website.shared.order"), class: "ds-label mt-5" %><%= form.number_field :public_display_order, min: 0, class: "ds-control mt-2" %><% } %>
  <div class="flex justify-end gap-2"><%= link_to t("actions.cancel"), admin_website_faqs_path, class: button_classes(variant: :secondary) %><%= render "shared/components/button", label: t("actions.save"), type: "submit" %><% if faq.persisted? %><%= button_to t("actions.delete"), admin_website_faq_path(faq), method: :delete, class: button_classes(variant: :danger), form: { data: { turbo_confirm: t("admin.website.shared.confirm_delete") } } %><% end %></div>
<% end %>
