<%= render "shared/page_header", title: t("admin.website.legal_pages.edit_title", page: t("admin.website.legal_pages.types.#{@legal_page.page_type}")), description: t("admin.website.legal_pages.review_hint") %><%= render "admin/website/subnav" %>
<% if @legal_page.errors.any? %><%= render "shared/components/alert", variant: :error, title: t("admin.website.shared.errors"), message: @legal_page.errors.full_messages.to_sentence %><% end %>
<%= form_with model: @legal_page, url: admin_website_legal_page_path(@legal_page.page_type), method: :patch, class: "space-y-6" do |form| %>
  <%= render "shared/components/card", title: t("admin.website.shared.content"), body: capture { %><div class="grid gap-5 sm:grid-cols-2"><% %i[title_ar title_en body_ar body_en].each do |field| %><div class="<%= "sm:col-span-2" if field.to_s.start_with?("body") %>"><%= form.label field, t("admin.website.legal_pages.fields.#{field}"), class: "ds-label" %><%= field.to_s.start_with?("body") ? form.text_area(field, rows: 12, class: "ds-control mt-2 h-auto", dir: field.to_s.end_with?("_ar") ? "rtl" : "ltr") : form.text_field(field, class: "ds-control mt-2", dir: field.to_s.end_with?("_ar") ? "rtl" : "ltr") %></div><% end %></div><% } %>
  <%= render "shared/components/card", title: t("admin.website.shared.publication"), body: capture { %><label class="flex gap-3"><%= form.check_box :published, class: "ds-checkbox" %><%= t("admin.website.shared.published") %></label><div class="mt-5"><%= form.label :effective_date, t("admin.website.legal_pages.fields.effective_date"), class: "ds-label" %><%= form.date_field :effective_date, class: "ds-control mt-2" %></div><% } %>
  <div class="flex justify-end"><%= render "shared/components/button", label: t("actions.save"), type: "submit" %></div>
<% end %>
