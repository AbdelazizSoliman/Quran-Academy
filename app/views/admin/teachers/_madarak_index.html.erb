<% actions = capture do %>
  <div class="flex flex-wrap gap-2">
    <%= render "shared/components/button", label: t("teachers.actions.new"), href: new_admin_teacher_path, icon: :plus %>
    <%= render "shared/components/button", label: t("teachers.madarak.import"), href: import_admin_teachers_path, variant: :secondary %>
    <%= render "shared/components/button", label: t("teachers.madarak.export"),
                                           href: export_admin_teachers_path(request.query_parameters.except(:page)),
                                           variant: :secondary %>
  </div>
<% end %>

<%= render "shared/page_header", title: t("teachers.index.title"),
                                 description: t("teachers.index.description"),
                                 primary_action: actions %>

<% countries = TeacherProfile.where.not(country_of_residence: [nil, ""]).distinct.order(:country_of_residence).pluck(:country_of_residence) %>
<% filters = capture do %>
  <%= form_with url: admin_teachers_path, method: :get, class: "space-y-3" do |form| %>
    <div class="grid gap-3 lg:grid-cols-4 xl:grid-cols-5">
      <div class="lg:col-span-2">
        <%= form.search_field :q, value: params[:q], placeholder: t("teachers.madarak.search_placeholder"),
                                  class: "ds-control", autocomplete: "off" %>
      </div>
      <%= form.select :employment_status,
                      [[t("teachers.filters.all"), ""]] + TeacherProfile::EMPLOYMENT_STATUSES.map { |value| [t("teacher_profiles.catalogs.employment_statuses.#{value}"), value] },
                      { selected: params[:employment_status] }, class: "ds-control" %>
      <%= form.select :user_status,
                      [[t("teachers.filters.all"), ""]] + User.statuses.keys.map { |value| [t("teacher_profiles.catalogs.user_statuses.#{value}"), value] },
                      { selected: params[:user_status] }, class: "ds-control" %>
      <%= form.select :gender,
                      [[t("teachers.filters.all"), ""]] + TeacherProfile::GENDERS.map { |value| [t("teacher_profiles.catalogs.genders.#{value}"), value] },
                      { selected: params[:gender] }, class: "ds-control" %>
      <%= form.select :country,
                      [[t("teachers.madarak.all_countries"), ""]] + countries.map { |value| [value, value] },
                      { selected: params[:country] }, class: "ds-control" %>
      <%= form.select :teaching_language,
                      [[t("teachers.filters.all"), ""]] + (AcademySetting.current_or_nil&.teaching_languages || []).map { |value| [t("teacher_profiles.catalogs.teaching_languages.#{value}"), value] },
                      { selected: params[:teaching_language] }, class: "ds-control" %>
      <%= form.select :specialization,
                      [[t("teachers.filters.all"), ""]] + TeacherProfile::SPECIALIZATIONS.map { |value| [t("teacher_profiles.catalogs.specializations.#{value}"), value] },
                      { selected: params[:specialization] }, class: "ds-control" %>
      <% if release_feature_enabled?(:payroll) %>
        <%= form.select :compensation_unit,
                        [[t("teachers.filters.all"), ""]] + TeacherProfile::COMPENSATION_UNITS.map { |value| [t("teacher_profiles.catalogs.compensation_units.#{value}"), value] },
                        { selected: params[:compensation_unit] }, class: "ds-control" %>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-3">
      <p class="ds-caption"><%= t("pagination.summary", from: @pagy.from, to: @pagy.to, total: @pagy.count) %></p>
      <div class="flex gap-2">
        <%= render "shared/components/button", label: t("actions.search"), type: "submit", icon: :search %>
        <%= render "shared/components/button", label: t("teachers.filters.clear"), href: admin_teachers_path, variant: :ghost %>
      </div>
    </div>
  <% end %>
<% end %>
<%= render "shared/components/card", body: filters %>

<div class="mt-6 overflow-hidden rounded-xl border border-app-border bg-app-surface shadow-sm" data-component="admin-teachers-table">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-app-border">
      <caption class="sr-only"><%= t("teachers.index.caption") %></caption>
      <thead class="bg-app-muted">
        <tr>
          <% %i[teacher].each do |field| %>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teacher_profiles.fields.#{field}") %></th>
          <% end %>
          <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teachers.madarak.utilization") %></th>
          <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teachers.madarak.assigned_students") %></th>
          <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teacher_profiles.fields.employment_status") %></th>
          <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teacher_profiles.fields.gender") %></th>
          <th scope="col" class="min-w-56 px-4 py-3 text-start ds-table-heading"><%= t("teachers.madarak.context") %></th>
          <% if release_feature_enabled?(:payroll) %>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teachers.madarak.compensation") %></th>
          <% end %>
          <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teacher_profiles.fields.actions") %></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-app-border">
        <% @profiles.each do |profile| %>
          <% metric = @teacher_metrics.fetch(profile, {}) %>
          <tr class="hover:bg-app-muted/50">
            <th scope="row" class="px-4 py-3 text-start">
              <%= link_to profile.display_name.presence || profile.user.full_name, admin_teacher_path(profile), class: "font-semibold text-app-primary hover:underline" %>
              <p class="mt-1 ds-caption" dir="ltr"><%= profile.public_id %> Â· <%= profile.user.email %></p>
            </th>
            <td class="min-w-40 px-4 py-3">
              <% if metric[:capacity_minutes].to_i.positive? %>
                <div class="flex items-center justify-between gap-3 text-xs">
                  <strong><%= metric[:utilization_percentage] %>%</strong>
                  <span class="text-app-muted-foreground"><%= t("teachers.madarak.this_week") %></span>
                </div>
                <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-app-muted">
                  <div class="h-full rounded-full bg-app-primary" style="width: <%= metric[:utilization_bar_percentage] %>%"></div>
                </div>
              <% else %>
                <span class="ds-caption"><%= t("teachers.madarak.no_capacity") %></span>
              <% end %>
            </td>
            <td class="px-4 py-3 text-center text-sm font-bold"><%= metric[:assigned_students_count].to_i %></td>
            <td class="px-4 py-3">
              <%= teacher_employment_badge(profile) %>
              <% if profile.on_leave? %><p class="mt-1 ds-caption"><%= t("teacher_profiles.fields.on_leave") %></p><% end %>
            </td>
            <td class="px-4 py-3 text-sm"><%= t("teacher_profiles.catalogs.genders.#{profile.gender}") %></td>
            <td class="px-4 py-3 text-sm">
              <p class="font-medium"><%= profile.country_of_residence.presence || t("scheduling.not_configured") %></p>
              <p class="mt-1 ds-caption"><%= teacher_collection(profile, :teaching_languages, :teaching_languages) %></p>
              <p class="mt-1 ds-caption"><%= teacher_collection(profile, :teaching_specializations, :specializations) %></p>
            </td>
            <% if release_feature_enabled?(:payroll) %>
              <td class="whitespace-nowrap px-4 py-3 text-sm">
                <strong><%= number_to_currency(profile.default_lesson_rate, unit: profile.compensation_currency, format: "%n %u") %></strong>
                <p class="mt-1 ds-caption"><%= t("teacher_profiles.catalogs.compensation_units.#{profile.compensation_unit}") %></p>
              </td>
            <% end %>
            <td class="px-4 py-3">
              <div class="flex gap-2">
                <%= render "shared/components/button", label: t("actions.view"), href: admin_teacher_path(profile), variant: :ghost, size: :small %>
                <%= render "shared/components/button", label: t("actions.edit"), href: edit_admin_teacher_path(profile), variant: :secondary, size: :small %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @profiles.empty? %>
    <div class="p-5"><%= render "shared/components/empty_state", icon: :users, title: t("teachers.empty.title"), description: t("teachers.empty.description"), primary_action: actions %></div>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <nav class="mt-5 flex justify-end gap-2" aria-label="<%= t("accessibility.pagination") %>">
    <% if @pagy.previous %><%= link_to t("pagination.previous"), admin_teachers_path(request.query_parameters.merge(page: @pagy.previous)), class: button_classes(variant: :secondary, size: :small) %><% end %>
    <% if @pagy.next %><%= link_to t("pagination.next"), admin_teachers_path(request.query_parameters.merge(page: @pagy.next)), class: button_classes(variant: :secondary, size: :small) %><% end %>
  </nav>
<% end %>
