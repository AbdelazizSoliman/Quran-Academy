<% new_action = render("shared/components/button", label: t("teachers.actions.new"), href: new_admin_teacher_path, icon: :plus) %>
<%= render "shared/page_header", title: t("teachers.index.title"),
           description: t("teachers.index.description"), primary_action: new_action %>

<% filters = capture do %>
  <%= form_with url: admin_teachers_path, method: :get, class: "grid gap-4 md:grid-cols-3 xl:grid-cols-5" do |form| %>
    <div class="md:col-span-2"><%= form.label :q, t("teachers.filters.search"), class: "ds-label" %><%= form.search_field :q, value: params[:q], class: "ds-control mt-2", autocomplete: "off" %></div>
    <% {
      user_status: User.statuses.keys, employment_status: TeacherProfile::EMPLOYMENT_STATUSES,
      engagement_type: TeacherProfile::ENGAGEMENT_TYPES, profile_status: TeacherProfile::PROFILE_STATUSES
    }.each do |field, values| %>
      <div>
        <%= form.label field, t("teacher_profiles.fields.#{field}"), class: "ds-label" %>
        <% scope = field == :user_status ? :user_statuses : field.to_s.pluralize %>
        <%= form.select field, [[t("teachers.filters.all"), ""]] + values.map { |value| [t("teacher_profiles.catalogs.#{scope}.#{value}"), value] }, { selected: params[field] }, class: "ds-control mt-2" %>
      </div>
    <% end %>
    <% {
      teaching_language: [AcademySetting.current_or_nil&.teaching_languages || [], :teaching_languages],
      specialization: [TeacherProfile::SPECIALIZATIONS, :specializations],
      age_group: [TeacherProfile::AGE_GROUPS, :age_groups]
    }.each do |field, (values, scope)| %>
      <div><%= form.label field, t("teachers.filters.#{field}"), class: "ds-label" %><%= form.select field, [[t("teachers.filters.all"), ""]] + values.map { |value| [t("teacher_profiles.catalogs.#{scope}.#{value}"), value] }, { selected: params[field] }, class: "ds-control mt-2" %></div>
    <% end %>
    <div>
      <%= form.label :sort, t("teachers.filters.sort"), class: "ds-label" %>
      <%= form.select :sort, Admin::TeachersQuery::SORTS.keys.map { |value| [t("teachers.sorts.#{value}"), value] }, { selected: params[:sort] }, class: "ds-control mt-2" %>
    </div>
    <div class="flex items-end gap-2"><%= render "shared/components/button", label: t("actions.search"), type: "submit", icon: :search %><%= render "shared/components/button", label: t("teachers.filters.clear"), href: admin_teachers_path, variant: :ghost %></div>
  <% end %>
<% end %>
<%= render "shared/components/card", body: filters %>

<div class="mt-6 overflow-hidden rounded-xl border border-app-border bg-app-surface shadow-sm" data-component="admin-teachers-table">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-app-border">
      <caption class="sr-only"><%= t("teachers.index.caption") %></caption>
      <thead class="bg-app-muted"><tr>
        <% %i[teacher public_id employment_status profile_status teaching_languages completion actions].each do |field| %>
          <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading"><%= t("teacher_profiles.fields.#{field}") %></th>
        <% end %>
      </tr></thead>
      <tbody class="divide-y divide-app-border">
        <% @profiles.each do |profile| %>
          <tr class="hover:bg-app-muted/50">
            <th scope="row" class="px-4 py-3 text-start"><%= link_to profile.display_name.presence || profile.user.full_name, admin_teacher_path(profile), class: "font-semibold text-app-primary hover:underline" %><p class="mt-1 ds-caption" dir="ltr"><%= profile.user.email %></p></th>
            <td class="whitespace-nowrap px-4 py-3 text-sm font-semibold" dir="ltr"><%= profile.public_id %></td>
            <td class="px-4 py-3"><%= teacher_employment_badge(profile) %></td>
            <td class="px-4 py-3"><%= teacher_profile_status_badge(profile) %></td>
            <td class="px-4 py-3"><%= teacher_collection(profile, :teaching_languages, :teaching_languages) %></td>
            <td class="px-4 py-3"><span class="font-semibold"><%= profile.completion_percentage %>%</span></td>
            <td class="px-4 py-3"><%= render "shared/components/button", label: t("actions.view"), href: admin_teacher_path(profile), variant: :ghost, size: :small %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @profiles.empty? %><div class="p-5"><%= render "shared/components/empty_state", icon: :users, title: t("teachers.empty.title"), description: t("teachers.empty.description"), primary_action: new_action %></div><% end %>
</div>
<% if @pagy.pages > 1 %>
  <nav class="mt-5 flex flex-wrap justify-between gap-3" aria-label="<%= t("accessibility.pagination") %>">
    <p class="ds-caption"><%= t("pagination.summary", from: @pagy.from, to: @pagy.to, total: @pagy.count) %></p>
    <div class="flex gap-2">
      <% if @pagy.previous %><%= link_to t("pagination.previous"), admin_teachers_path(request.query_parameters.merge(page: @pagy.previous)), class: button_classes(variant: :secondary, size: :small) %><% end %>
      <% if @pagy.next %><%= link_to t("pagination.next"), admin_teachers_path(request.query_parameters.merge(page: @pagy.next)), class: button_classes(variant: :secondary, size: :small) %><% end %>
    </div>
  </nav>
<% end %>
