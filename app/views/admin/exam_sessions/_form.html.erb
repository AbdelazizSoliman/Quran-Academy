<%= form_with model: [:admin, exam], class: "ds-card grid gap-5 p-5 sm:grid-cols-2" do |form| %><div><%= form.label :title, t("academic.fields.title"), class: "ds-label" %><%= form.text_field :title, required: true, class: "ds-control mt-2" %></div><div><%= form.label :program_id, t("academic.fields.program"), class: "ds-label" %><%= form.collection_select :program_id, Program.where.not(status: "archived"), :id, :name_en, {}, class: "ds-control mt-2" %></div><div><%= form.label :course_offering_id, t("academic.fields.offering"), class: "ds-label" %><%= form.collection_select :course_offering_id, CourseOffering.where.not(status: "archived"), :id, :title_en, {}, class: "ds-control mt-2" %></div><div><%= form.label :teacher_profile_id, t("academic.fields.teacher"), class: "ds-label" %><%= form.collection_select :teacher_profile_id, TeacherProfile.includes(:user), :id, ->(profile) { profile.user.full_name }, {}, class: "ds-control mt-2" %></div><div><%= form.label :starts_at, t("academic.fields.starts_at"), class: "ds-label" %><%= form.datetime_local_field :starts_at, class: "ds-control mt-2" %></div><div><%= form.label :duration_minutes, t("academic.fields.duration"), class: "ds-label" %><%= form.number_field :duration_minutes, min: 1, max: 480, class: "ds-control mt-2" %></div><div class="sm:col-span-2"><%= form.label :notes, t("academic.fields.notes"), class: "ds-label" %><%= form.text_area :notes, rows: 4, class: "ds-control mt-2" %></div><div class="sm:col-span-2"><%= render "shared/components/button", label: t("actions.save"), type: "submit" %></div><% end %>
