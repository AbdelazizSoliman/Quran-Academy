<%= render "shared/page_header", title: @exam.title, description: @exam.public_id, primary_action: (current_user.admin? ? render("shared/components/button", label: t("actions.edit"), href: edit_admin_exam_session_path(@exam)) : nil) %><div class="ds-card p-5"><dl class="grid gap-4 sm:grid-cols-3"><% { program: @exam.program.name_en, offering: @exam.course_offering.title_en, teacher: @exam.teacher_profile.user.full_name, starts_at: l(@exam.starts_at, format: :long), duration: @exam.duration_minutes, status: t("academic.exam_statuses.#{@exam.status}") }.each do |key, value| %><div><dt class="ds-caption"><%= t("academic.fields.#{key}") %></dt><dd class="font-semibold"><%= value %></dd></div><% end %></dl><div class="mt-5 flex flex-wrap gap-2"><% if current_user.admin? %><% %i[schedule complete review publish archive].each do |action| %><%= button_to t("academic.actions.#{action}"), public_send("#{action}_admin_exam_session_path", @exam), method: :patch, class: button_classes(variant: :secondary, size: :small) %><% end %><% end %></div></div>
