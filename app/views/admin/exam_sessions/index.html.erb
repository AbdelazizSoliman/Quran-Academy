<% action = current_user.admin? ? render("shared/components/button", label: t("academic.actions.new_exam"), href: new_admin_exam_session_path, icon: :plus) : nil %><%= render "shared/page_header", title: t("academic.exams.index"), primary_action: action %><div class="grid gap-4"><% @exam_sessions.each do |exam| %><article class="ds-card p-5"><div class="flex justify-between gap-3"><h2 class="font-bold"><%= link_to exam.title, admin_exam_session_path(exam), class: "text-app-primary" %></h2><span class="ds-badge"><%= t("academic.exam_statuses.#{exam.status}") %></span></div><p class="mt-2 ds-caption"><%= l(exam.starts_at, format: :long) %> · <%= exam.teacher_profile.user.full_name %></p></article><% end %></div>
