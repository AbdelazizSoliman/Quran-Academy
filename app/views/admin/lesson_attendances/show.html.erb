<%= render "shared/page_header", title: t("attendance.admin.show.title"), description: @lesson.public_id %>
<section class="ds-card mb-6 p-5" aria-labelledby="lesson-summary"><h2 id="lesson-summary" class="ds-card-title"><%= I18n.locale == :ar ? @lesson.title_ar : @lesson.title_en %></h2><p class="mt-2"><%= @lesson.teacher_profile.display_name %></p><p class="mt-2" dir="ltr"><%= scheduling_time(@lesson.starts_at, zone: ActiveSupport::TimeZone[@lesson.academy_time_zone]) %></p><p class="mt-2" role="status"><%= t("attendance.workflow.#{@lesson.attendance_status}") %> · <%= t("attendance.unresolved", count: @lesson.unresolved_attendance_count) %></p>
  <div class="mt-4 flex flex-wrap gap-2"><% if @lesson.scheduled? %><%= button_to t("attendance.actions.check_in_override"), check_in_teacher_admin_scheduled_lesson_path(@lesson), method: :patch, params: { reason: t("attendance.defaults.admin_override") }, class: button_classes %><%= button_to t("attendance.actions.start_override"), start_admin_scheduled_lesson_path(@lesson), method: :patch, params: { reason: t("attendance.defaults.admin_override") }, class: button_classes %><% end %><% if @lesson.in_progress? %><%= button_to t("attendance.actions.complete"), complete_admin_scheduled_lesson_path(@lesson), method: :patch, params: { mark_unresolved_absent: true, reason: t("attendance.defaults.completion_confirmation") }, class: button_classes %><% end %><% if @lesson.attendance_locked? %><%= button_to t("attendance.actions.reopen"), reopen_attendance_admin_scheduled_lesson_path(@lesson), method: :patch, params: { reason: t("attendance.defaults.admin_adjustment") }, class: button_classes(variant: :secondary) %><% elsif @lesson.attendance_editable? && @lesson.unresolved_attendance_count.zero? %><%= button_to t("attendance.actions.lock"), lock_attendance_admin_scheduled_lesson_path(@lesson), method: :patch, class: button_classes(variant: :secondary) %><% end %></div>
</section>
<section aria-labelledby="participants" class="space-y-4"><h2 id="participants" class="text-xl font-semibold"><%= t("attendance.sections.participants") %></h2>
  <% @attendances.each do |attendance| %><article class="ds-card p-4"><div class="flex flex-wrap items-center justify-between gap-3"><div><h3 class="font-semibold"><%= attendance.student_profile.display_name %></h3><p class="ds-caption"><%= t("attendance.statuses.#{attendance.status}") %><% if attendance.arrival_at %> · <span dir="ltr"><%= l(attendance.arrival_at.in_time_zone(@lesson.academy_time_zone), format: :short) %></span><% end %></p></div><% if @lesson.attendance_editable? && current_user.admin? %><div class="flex flex-wrap gap-2"><%= button_to t("attendance.actions.arrival"), record_arrival_admin_scheduled_lesson_lesson_attendance_path(@lesson, attendance), method: :patch, class: button_classes(size: :small) %><%= button_to t("attendance.actions.present"), mark_present_admin_scheduled_lesson_lesson_attendance_path(@lesson, attendance), method: :patch, class: button_classes(size: :small, variant: :secondary) %><%= button_to t("attendance.actions.absent"), mark_absent_admin_scheduled_lesson_lesson_attendance_path(@lesson, attendance), method: :patch, params: { reason: t("attendance.defaults.admin_override") }, class: button_classes(size: :small, variant: :danger) %></div><% end %></div></article><% end %>
</section>
