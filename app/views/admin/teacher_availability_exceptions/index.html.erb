<%= render "shared/page_header", title: t("scheduling.exceptions.title"), description: t("scheduling.exceptions.description"), primary_action: render("shared/components/button", label: t("scheduling.actions.new_exception"), href: new_admin_teacher_availability_exception_path) %><div class="grid gap-3"><% @exceptions.each do |exception| %><%= link_to admin_teacher_availability_exception_path(exception), class: "ds-card p-4" do %><div class="flex justify-between"><strong><%= exception.teacher_profile.display_name %></strong><span><%= exception.exception_date %> · <%= t("scheduling.catalogs.exception_types.#{exception.exception_type}") %></span></div><% end %><% end %></div><% if @exceptions.empty? %><%= render "shared/components/empty_state", icon: :calendar, title: t("scheduling.empty.title"), description: t("scheduling.empty.description") %><% end %>
