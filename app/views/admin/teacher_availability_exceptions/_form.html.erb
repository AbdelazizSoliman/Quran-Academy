<%= render "shared/academic/errors", record: exception %>
<%= form_with model: local_assigns.fetch(:form_model, [:admin, exception]), url: local_assigns[:form_url], class: "space-y-6" do |f| %>
  <fieldset class="ds-card p-5"><legend class="ds-section-title"><%= t("scheduling.sections.exception") %></legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><% unless exception.persisted? %><div><%= f.label :teacher_profile_id, t("scheduling.fields.teacher"), class: "ds-label" %><%= f.collection_select :teacher_profile_id, teachers, :id, :display_name, { include_blank: true }, class: "ds-control mt-2" %></div><% end %><div><%= f.label :exception_date, t("scheduling.fields.exception_date"), class: "ds-label" %><%= f.date_field :exception_date, class: "ds-control mt-2" %></div><div><%= f.label :starts_at_local, t("scheduling.fields.starts_at_local"), class: "ds-label" %><%= f.time_field :starts_at_local, class: "ds-control mt-2" %></div><div><%= f.label :ends_at_local, t("scheduling.fields.ends_at_local"), class: "ds-label" %><%= f.time_field :ends_at_local, class: "ds-control mt-2" %></div><div><%= f.label :time_zone, t("scheduling.fields.time_zone"), class: "ds-label" %><%= f.select :time_zone, ActiveSupport::TimeZone.all.map { |z| [z.name, z.name] }, {}, class: "ds-control mt-2" %></div><div><%= f.label :exception_type, t("scheduling.fields.exception_type"), class: "ds-label" %><%= f.select :exception_type, TeacherAvailabilityException::EXCEPTION_TYPES.map { |v| [t("scheduling.catalogs.exception_types.#{v}"), v] }, {}, class: "ds-control mt-2" %></div></div><div class="mt-4"><%= f.label :reason, t("scheduling.fields.reason"), class: "ds-label" %><%= f.text_area :reason, rows: 3, class: "ds-control mt-2" %></div></fieldset>
  <%= render "shared/components/button", label: t("actions.save"), type: :submit %>
<% end %>
