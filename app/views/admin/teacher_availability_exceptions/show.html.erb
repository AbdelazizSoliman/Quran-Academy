<%= render "shared/page_header", title: @exception.public_id, description: @exception.teacher_profile.display_name %><%= render "shared/components/card", title: t("scheduling.sections.exception") do %><p><%= @exception.exception_date %> · <%= t("scheduling.catalogs.exception_types.#{@exception.exception_type}") %></p><p class="mt-2"><%= @exception.reason.presence || t("scheduling.not_configured") %></p><div class="mt-4 flex gap-2"><%= render "shared/components/button", label: t("actions.edit"), href: edit_admin_teacher_availability_exception_path(@exception), variant: :secondary %><%= button_to t("scheduling.actions.cancel_exception"), cancel_admin_teacher_availability_exception_path(@exception), method: :patch, class: button_classes(variant: :danger) if @exception.active? %></div><% end %><%= render "shared/components/card", title: t("scheduling.sections.audit") do %><% @events.each do |event| %><p class="text-sm"><%= t("scheduling.catalogs.events.#{event.event_type}") %> · <%= event.actor.full_name %></p><% end %><% end %>
