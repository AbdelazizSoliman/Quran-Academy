<%= render "shared/page_header", title: t("finance.reports.title"), description: t("finance.reports.description") %><%= render "admin/finance/navigation" %>
<%= form_with url: admin_financial_reports_path, method: :get, class: "ds-card mb-6 grid gap-4 p-4 sm:grid-cols-3" do |form| %><div><%= form.label :from, t("payroll.filters.from"), class: "ds-label" %><%= form.date_field :from, value: @summary.from, class: "ds-control mt-2" %></div><div><%= form.label :to, t("payroll.filters.to"), class: "ds-label" %><%= form.date_field :to, value: @summary.to, class: "ds-control mt-2" %></div><div class="self-end"><%= render "shared/components/button", label: t("reports.actions.filter"), type: :submit %></div><% end %>
<% @summary.by_currency.each do |currency, metrics| %><section class="mb-6"><h2 class="mb-3 text-lg font-bold"><%= currency %></h2><div class="grid gap-3 sm:grid-cols-2 xl:grid-cols-4"><% metrics.each do |key, amount| %><article class="ds-card p-4"><p class="ds-caption"><%= t("finance.metrics.#{key}") %></p><p class="mt-2 text-xl font-bold" dir="ltr"><%= number_to_currency(amount, unit: currency) %></p></article><% end %></div></section><% end %>
<section class="mt-8"><h2 class="text-xl font-semibold"><%= t("finance.trends.title") %></h2><p class="mt-1 ds-caption"><%= t("finance.trends.description") %></p><% @monthly_trends.each do |currency, rows| %><div class="ds-card mt-4 overflow-x-auto"><h3 class="p-4 font-bold"><%= currency %></h3><table class="min-w-full text-sm"><thead><tr class="border-y"><th class="p-3 text-start"><%= t("finance.trends.month") %></th><th class="p-3 text-start"><%= t("finance.metrics.collected") %></th><th class="p-3 text-start"><%= t("finance.metrics.payroll_paid") %></th><th class="p-3 text-start"><%= t("finance.metrics.expenses") %></th><th class="p-3 text-start"><%= t("finance.metrics.net_profit") %></th></tr></thead><tbody><% rows.each do |row| %><tr class="border-b last:border-0"><td class="p-3"><%= l(row.month, format: "%B %Y") %></td><td class="p-3" dir="ltr"><%= number_to_currency(row.collected, unit: currency) %></td><td class="p-3" dir="ltr"><%= number_to_currency(row.payroll_paid, unit: currency) %></td><td class="p-3" dir="ltr"><%= number_to_currency(row.expenses, unit: currency) %></td><td class="p-3 font-bold" dir="ltr"><%= number_to_currency(row.net_profit, unit: currency) %></td></tr><% end %></tbody></table></div><% end %></section>
<section class="mt-8"><h2 class="text-xl font-semibold"><%= t("finance.reports.available") %></h2><div class="mt-4 grid gap-4 sm:grid-cols-2 xl:grid-cols-3"><% @report_types.each do |type| %><%= link_to admin_financial_report_path(type, from: @summary.from, to: @summary.to), class: "ds-card p-5 font-semibold" do %><%= t("finance.report_types.#{type}") %><% end %><% end %></div></section>
