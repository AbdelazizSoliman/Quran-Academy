<%= render "shared/page_header", title: t("finance.report_types.#{@dataset.title}"), primary_action: { label: t("reports.actions.export"), href: export_admin_financial_report_path(@dataset.title, request.query_parameters) } %><%= render "admin/finance/navigation" %>
<div class="ds-card overflow-x-auto"><table class="min-w-full text-sm"><thead><tr class="border-b"><% @dataset.headers.each do |header| %><th class="p-4 text-start"><%= t("finance.report_headers.#{header}", default: header.humanize) %></th><% end %></tr></thead><tbody><% @dataset.rows.each do |row| %><tr class="border-b last:border-0"><% row.each do |value| %><td class="p-4"><%= value %></td><% end %></tr><% end %></tbody></table></div>
