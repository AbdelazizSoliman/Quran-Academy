<%= render "shared/page_header", title: t("lesson_reports.admin.show.title"), description: @report.public_id %>
<section class="ds-card p-5"><h2 class="ds-card-title"><%= @report.scheduled_lesson.title_en %></h2><p class="mt-2" role="status"><%= t("lesson_reports.statuses.#{@report.status}") %></p><p class="mt-4"><%= @report.lesson_summary %></p><div class="mt-4 flex flex-wrap gap-2"><%= render "shared/components/button", label: t("lesson_reports.actions.edit"), href: edit_admin_lesson_report_path(@report), variant: :secondary %><% if @report.submitted? %><%= button_to t("lesson_reports.actions.review"), review_admin_lesson_report_path(@report), method: :patch, class: button_classes %><% end %><% if @report.status.in?(%w[submitted reviewed]) %><%= button_to t("lesson_reports.actions.lock"), lock_admin_lesson_report_path(@report), method: :patch, class: button_classes %><% end %><% if @report.locked? %><%= button_to t("lesson_reports.actions.reopen"), reopen_admin_lesson_report_path(@report), method: :patch, params: { reason: t("lesson_reports.defaults.reopening_reason") }, class: button_classes(variant: :secondary) %><% end %><% if @report.reopened? %><%= button_to t("lesson_reports.actions.relock"), relock_admin_lesson_report_path(@report), method: :patch, class: button_classes %><% end %></div></section>
<section class="mt-6 space-y-4" aria-labelledby="student-entries"><h2 id="student-entries" class="text-xl font-semibold"><%= t("lesson_reports.sections.students") %></h2><% @entries.each do |entry| %><article class="ds-card p-4"><div class="flex flex-wrap justify-between gap-3"><div><h3 class="font-semibold"><%= entry.student_profile.display_name %></h3><p><%= t("lesson_reports.student_statuses.#{entry.status}") %></p></div><%= render "shared/components/button", label: t("lesson_reports.actions.edit"), href: edit_admin_lesson_report_student_report_path(@report, entry), size: :small, variant: :secondary %></div><div class="mt-3 flex flex-wrap gap-2"><%= button_to t("communications.actions.student_email"), admin_lesson_report_communications_path(@report), method: :post, params: { entry_id: entry.id, channel: "email", template_type: "student_progress", recipient_type: "student" }, class: button_classes(size: :small, variant: :secondary) %><%= button_to t("communications.actions.guardian_email"), admin_lesson_report_communications_path(@report), method: :post, params: { entry_id: entry.id, channel: "email", template_type: "guardian_progress", recipient_type: "guardian" }, class: button_classes(size: :small, variant: :secondary) %></div></article><% end %></section>
