<%= render "shared/page_header", title: t("lesson_reports.admin.index.title"), description: t("lesson_reports.admin.index.description") %>
<div class="space-y-3"><% @reports.each do |report| %><%= link_to admin_lesson_report_path(report), class: "ds-card grid gap-2 p-4 sm:grid-cols-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" do %><strong><%= I18n.locale == :ar ? report.scheduled_lesson.title_ar : report.scheduled_lesson.title_en %></strong><span><%= report.teacher_profile.display_name %></span><span dir="ltr"><%= l(report.scheduled_lesson.starts_at.in_time_zone(current_user.time_zone), format: :short) %></span><span><%= t("lesson_reports.statuses.#{report.status}") %> · <%= report.lesson_student_reports.count(&:completed?) %>/<%= report.lesson_student_reports.size %></span><% end %><% end %></div>
