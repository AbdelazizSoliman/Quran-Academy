<% action = render("shared/components/button", label: t("programs.actions.new"), href: new_admin_program_path, icon: :plus) %>
<%= render "shared/page_header", title: t("programs.index.title"), description: t("programs.index.description"), primary_action: action %>
<% filters = capture do %><%= form_with url: admin_programs_path, method: :get, class: "grid gap-4 md:grid-cols-4" do |f| %><div><%= f.label :q, t("actions.search"), class: "ds-label" %><%= f.search_field :q, value: params[:q], class: "ds-control mt-2" %></div><div><%= f.label :category, t("programs.fields.category"), class: "ds-label" %><%= f.select :category, [["—",""]] + Program::CATEGORIES.map { |v| [t("academic.catalogs.program_categories.#{v}"), v] }, { selected: params[:category] }, class: "ds-control mt-2" %></div><div><%= f.label :status, t("programs.fields.status"), class: "ds-label" %><%= f.select :status, [["—",""]] + Program::STATUSES.map { |v| [t("academic.catalogs.program_statuses.#{v}"), v] }, { selected: params[:status] }, class: "ds-control mt-2" %></div><div class="flex items-end"><%= render "shared/components/button", label: t("actions.search"), type: "submit" %></div><% end %><% end %><%= render "shared/components/card", body: filters %>
<div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3"><% @programs.each do |program| %><%= link_to admin_program_path(program), class: "ds-card p-5 focus-visible:outline" do %><div class="flex justify-between gap-2"><h2 class="ds-card-title"><%= localized_program_name(program) %></h2><%= program_status_badge(program) %></div><p class="mt-2 ds-caption" dir="ltr"><%= program.code %> · <%= program.public_id %></p><p class="mt-3 text-sm"><%= academic_badge(:program_categories, program.category) %></p><p class="mt-3 ds-caption"><%= t("programs.offerings_count", count: program.course_offerings.size) %></p><% end %><% end %></div>
<% if @programs.empty? %><div class="mt-6"><%= render "shared/components/empty_state", icon: :reports, title: t("programs.empty.title"), description: t("programs.empty.description"), primary_action: action %></div><% end %>
