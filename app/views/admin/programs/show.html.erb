<% actions = capture do %><div class="flex flex-wrap gap-2"><%= render "shared/components/button", label: t("actions.edit"), href: edit_admin_program_path(@program), variant: :secondary %><% Admin::Programs::Transition::RULES.each do |action, rule| %><% next unless @program.status.in?(rule[:from]) %><%= button_to t("actions.#{action}"), public_send("#{action}_admin_program_path", @program), method: :patch, class: button_classes(variant: action == :archive ? :danger : :ghost, size: :small) %><% end %></div><% end %>
<%= render "shared/page_header", title: localized_program_name(@program), description: "#{@program.code} · #{@program.public_id}", badge: program_status_badge(@program), primary_action: actions %>
<%= render "shared/academic/errors", record: @program %>
<div class="grid gap-6 lg:grid-cols-2"><% details = capture do %><dl class="grid gap-4 sm:grid-cols-2"><% %i[category default_learning_language entry_level completion_level default_lesson_duration_minutes recommended_lessons_per_week estimated_duration_weeks allows_minor_students allows_adult_students requires_placement].each do |field| %><div><dt class="ds-caption"><%= t("programs.fields.#{field}") %></dt><dd class="mt-1"><%= academic_value(@program.public_send(field)) %></dd></div><% end %></dl><% end %><%= render "shared/components/card", title: t("programs.sections.details"), body: details %>
<% descriptions = capture do %><div class="space-y-4"><p class="whitespace-pre-line"><%= academic_value(I18n.locale == :ar ? @program.description_ar : @program.description_en) %></p><div class="flex flex-wrap gap-2"><% @program.supported_learning_languages.each do |v| %><%= render "shared/components/badge", label: t("academy.languages.#{v}"), variant: :information %><% end %><% @program.target_age_groups.each do |v| %><%= academic_badge(:age_groups, v) %><% end %></div></div><% end %><%= render "shared/components/card", title: t("programs.sections.description"), body: descriptions %></div>
<div class="mt-6"><% offerings = capture do %><div class="space-y-3"><% @offerings.each do |offering| %><%= link_to localized_offering_title(offering), admin_course_offering_path(offering), class: "block rounded-xl border p-3 font-semibold text-app-primary" %><% end %><%= render "shared/components/button", label: t("course_offerings.actions.new"), href: new_admin_course_offering_path(program_id: @program.id), icon: :plus %></div><% end %><%= render "shared/components/card", title: t("programs.sections.offerings"), body: offerings %></div>
<div class="mt-6"><% history = capture do %><ol class="divide-y"><% @events.each do |event| %><li class="py-3"><%= t("programs.audit.#{event.event_type}", actor: event.actor.full_name) %></li><% end %></ol><% end %><%= render "shared/components/card", title: t("programs.sections.audit"), body: history %></div>
