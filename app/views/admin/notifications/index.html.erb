<%= render "shared/page_header", title: t("notifications.admin.title"), description: t("notifications.admin.description"), primary_action: (current_user.admin? ? render("shared/components/button", label: t("notifications.actions.new"), href: new_admin_notification_path) : nil) %>
<%= form_with url: admin_notifications_path, method: :get, class: "ds-card mb-6 grid gap-4 p-4 sm:grid-cols-4" do |form| %><%= form.select :channel, [[t("actions.all"), ""]] + Notification::CHANNELS.map { |value| [t("notifications.channels.#{value}"), value] }, { selected: params[:channel] }, class: "ds-control" %><%= form.select :status, [[t("actions.all"), ""]] + Notification::STATUSES.map { |value| [t("notifications.statuses.#{value}"), value] }, { selected: params[:status] }, class: "ds-control" %><%= form.date_field :from, value: params[:from], class: "ds-control" %><%= render "shared/components/button", label: t("actions.filter"), type: "submit" %><% end %>
<%= render "shared/notifications/list", notifications: @notifications, path: ->(notification) { admin_notification_path(notification) } %><%== @pagy.series_nav if @pagy.pages > 1 %>
