<%= render "shared/academic/errors", record: @lesson %><%= render "shared/page_header", title: I18n.locale == :ar ? @lesson.title_ar : @lesson.title_en, description: @lesson.public_id, badge: scheduling_status_badge(@lesson) %><div class="grid gap-6 lg:grid-cols-2"><%= render "shared/components/card", title: t("scheduling.sections.lesson") do %><dl class="grid gap-3"><div><dt class="ds-caption"><%= t("scheduling.fields.teacher") %></dt><dd><%= @lesson.teacher_profile.display_name %></dd></div><div><dt class="ds-caption"><%= t("scheduling.fields.offering") %></dt><dd><%= @lesson.course_offering.title_en %></dd></div><div><dt class="ds-caption"><%= t("scheduling.fields.time") %></dt><dd dir="ltr"><%= scheduling_time(@lesson.starts_at, zone: ActiveSupport::TimeZone[@lesson.academy_time_zone]) %> – <%= @lesson.ends_at.in_time_zone(@lesson.academy_time_zone).strftime("%H:%M") %></dd></div><div><dt class="ds-caption"><%= t("scheduling.fields.delivery_mode") %></dt><dd><%= t("scheduling.catalogs.delivery_modes.#{@lesson.delivery_mode}") %></dd></div></dl><div class="mt-4 flex flex-wrap gap-2"><% if @lesson.draft? %><%= button_to t("scheduling.actions.schedule"), schedule_admin_scheduled_lesson_path(@lesson), method: :patch, class: button_classes %><% end %><% if @lesson.scheduled? %><%= button_to t("scheduling.actions.start"), start_admin_scheduled_lesson_path(@lesson), method: :patch, class: button_classes %><%= render "shared/components/button", label: t("scheduling.actions.reschedule"), href: reschedule_admin_scheduled_lesson_path(@lesson), variant: :secondary %><% end %><% if @lesson.in_progress? %><%= button_to t("scheduling.actions.complete"), complete_admin_scheduled_lesson_path(@lesson), method: :patch, class: button_classes %><% end %><% if %w[draft scheduled in_progress].include?(@lesson.status) %><%= button_to t("scheduling.actions.cancel"), cancel_admin_scheduled_lesson_path(@lesson), method: :patch, params: { cancellation_reason: t("scheduling.defaults.admin_cancellation") }, class: button_classes(variant: :danger) %><% end %></div><% end %><%= render "shared/components/card", title: t("scheduling.sections.participants") do %><ul class="space-y-2"><% @participants.each do |participant| %><li class="flex justify-between"><span><%= participant.enrollment.student_profile.display_name %></span><span><%= t("scheduling.catalogs.participation_statuses.#{participant.participation_status}") %></span></li><% end %></ul><% end %></div><div class="mt-6"><%= render "shared/components/card", title: t("scheduling.sections.audit") do %><% @events.each do |event| %><p class="text-sm"><%= t("scheduling.catalogs.events.#{event.event_type}") %> · <%= event.actor.full_name %></p><% end %><% end %></div>
<div class="mt-6 ds-card p-5"><h2 class="ds-card-title"><%= t("scheduling.sections.add_participant") %></h2><% if @available_enrollments.any? %><%= form_with url: admin_scheduled_lesson_participants_path(@lesson), method: :post, class: "mt-4 flex flex-wrap items-end gap-3" do |f| %><div><%= f.label :enrollment_id, t("scheduling.fields.enrollment"), class: "ds-label" %><%= f.collection_select :enrollment_id, @available_enrollments, :id, ->(enrollment) { "#{enrollment.student_profile.display_name} (#{enrollment.public_id})" }, {}, class: "ds-control mt-2" %></div><%= render "shared/components/button", label: t("scheduling.actions.add_participant"), type: :submit %><% end %><% else %><p class="mt-3 ds-caption"><%= t("scheduling.no_eligible_participants") %></p><% end %></div>
