<%= render "shared/academic/errors", record: lesson %><%= form_with model: [:admin, lesson], class: "space-y-6" do |f| %><fieldset class="ds-card p-5"><legend class="ds-section-title"><%= t("scheduling.sections.lesson") %></legend><div class="mt-4 grid gap-4 sm:grid-cols-2"><div><%= f.label :course_offering_id, t("scheduling.fields.offering"), class: "ds-label" %><%= f.collection_select :course_offering_id, offerings, :id, :title_en, { include_blank: true }, class: "ds-control mt-2" %></div><div><%= f.label :teacher_profile_id, t("scheduling.fields.teacher"), class: "ds-label" %><%= f.collection_select :teacher_profile_id, teachers, :id, :display_name, { include_blank: true }, class: "ds-control mt-2" %></div><% %i[title_ar title_en].each do |field| %><div><%= f.label field, t("scheduling.fields.#{field}"), class: "ds-label" %><%= f.text_field field, class: "ds-control mt-2" %></div><% end %><div><%= f.label :starts_at, t("scheduling.fields.starts_at"), class: "ds-label" %><%= f.datetime_local_field :starts_at, class: "ds-control mt-2" %></div><div><%= f.label :ends_at, t("scheduling.fields.ends_at"), class: "ds-label" %><%= f.datetime_local_field :ends_at, class: "ds-control mt-2" %></div><div><%= f.label :academy_time_zone, t("scheduling.fields.time_zone"), class: "ds-label" %><%= f.select :academy_time_zone, ActiveSupport::TimeZone.all.map { |z| [z.name, z.name] }, {}, class: "ds-control mt-2" %></div><div><%= f.label :delivery_mode, t("scheduling.fields.delivery_mode"), class: "ds-label" %><%= f.select :delivery_mode, ScheduledLesson::DELIVERY_MODES.map { |v| [t("scheduling.catalogs.delivery_modes.#{v}"), v] }, {}, class: "ds-control mt-2" %></div><div><%= f.label :location_name, t("scheduling.fields.location_name"), class: "ds-label" %><%= f.text_field :location_name, class: "ds-control mt-2" %></div><div><%= f.label :online_meeting_url, t("scheduling.fields.online_meeting_url"), class: "ds-label" %><%= f.url_field :online_meeting_url, class: "ds-control mt-2", dir: "ltr" %></div></div></fieldset><div class="flex gap-3"><%= render "shared/components/button", label: t("actions.save"), type: :submit %><%= render "shared/components/button", label: t("actions.cancel"), href: admin_scheduled_lessons_path, variant: :secondary %></div><% end %>
