<%= render "shared/page_header", title: t("scheduling.actions.reschedule") %><%= form_with url: apply_reschedule_admin_scheduled_lesson_path(@lesson), method: :patch, class: "ds-card grid gap-4 p-5 sm:grid-cols-2" do |f| %><div><%= f.label :starts_at, t("scheduling.fields.starts_at"), class: "ds-label" %><%= f.datetime_local_field :starts_at, value: @lesson.starts_at&.strftime("%Y-%m-%dT%H:%M"), class: "ds-control mt-2" %></div><div><%= f.label :ends_at, t("scheduling.fields.ends_at"), class: "ds-label" %><%= f.datetime_local_field :ends_at, value: @lesson.ends_at&.strftime("%Y-%m-%dT%H:%M"), class: "ds-control mt-2" %></div><div class="sm:col-span-2"><%= render "shared/components/button", label: t("scheduling.actions.reschedule"), type: :submit %></div><% end %>
