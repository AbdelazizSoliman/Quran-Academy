<%= render "shared/page_header", title: t("scheduling.lessons.title"), description: t("scheduling.lessons.description"), primary_action: render("shared/components/button", label: t("scheduling.actions.new_lesson"), href: new_admin_scheduled_lesson_path) %><%= form_with url: admin_scheduled_lessons_path, method: :get, class: "ds-card mb-6 grid gap-4 p-5 md:grid-cols-4" do |f| %><div><%= f.label :q, t("actions.search"), class: "ds-label" %><%= f.search_field :q, value: params[:q], class: "ds-control mt-2" %></div><div><%= f.label :from, t("scheduling.fields.from"), class: "ds-label" %><%= f.date_field :from, value: params[:from], class: "ds-control mt-2" %></div><div><%= f.label :to, t("scheduling.fields.to"), class: "ds-label" %><%= f.date_field :to, value: params[:to], class: "ds-control mt-2" %></div><div class="flex items-end"><%= render "shared/components/button", label: t("actions.search"), type: :submit %></div><% end %><div class="grid gap-3"><% @lessons.each do |lesson| %><%= link_to admin_scheduled_lesson_path(lesson), class: "ds-card p-5" do %><div class="flex flex-wrap justify-between gap-3"><div><h2 class="ds-card-title"><%= I18n.locale == :ar ? lesson.title_ar : lesson.title_en %></h2><p class="ds-caption"><%= lesson.public_id %> · <%= lesson.teacher_profile.display_name %></p></div><%= scheduling_status_badge(lesson) %></div><p class="mt-3 text-sm" dir="ltr"><%= scheduling_time(lesson.starts_at, zone: ActiveSupport::TimeZone[lesson.academy_time_zone]) %> – <%= lesson.ends_at.in_time_zone(lesson.academy_time_zone).strftime("%H:%M") %></p><% end %><% end %></div><% if @lessons.empty? %><%= render "shared/components/empty_state", icon: :calendar, title: t("scheduling.empty.lessons_title"), description: t("scheduling.empty.lessons_description") %><% end %><% unless @lessons.empty? %><div class="mt-6"><%== @pagy.series_nav %></div><% end %>
