<% week_days = (@week_start..@week_end).to_a %>
<% preserved_filters = request.query_parameters.slice("q", "teacher_profile_id", "course_offering_id", "status") %>

<%= render "shared/page_header",
           title: t("scheduling.lessons.title"),
           description: t("scheduling.weekly.description", from: l(@week_start, format: :long), to: l(@week_end, format: :long)),
           primary_action: render("shared/components/button", label: t("scheduling.actions.new_lesson"),
                                                              href: new_admin_scheduled_lesson_path,
                                                              icon: :plus) %>

<div class="mb-4 flex flex-wrap items-center justify-between gap-3">
  <div class="flex flex-wrap items-center gap-2">
    <%= render "shared/components/button",
               label: t("scheduling.weekly.previous"),
               href: admin_scheduled_lessons_path(preserved_filters.merge(week: (@week_start - 7.days).iso8601)),
               variant: :secondary,
               size: :small %>
    <%= render "shared/components/button",
               label: t("scheduling.weekly.today"),
               href: admin_scheduled_lessons_path(preserved_filters.merge(week: Date.current.iso8601)),
               variant: :secondary,
               size: :small %>
    <%= render "shared/components/button",
               label: t("scheduling.weekly.next"),
               href: admin_scheduled_lessons_path(preserved_filters.merge(week: (@week_start + 7.days).iso8601)),
               variant: :secondary,
               size: :small %>
  </div>
  <p class="ds-caption" dir="ltr"><%= @week_start.iso8601 %> – <%= @week_end.iso8601 %></p>
</div>

<%= form_with url: admin_scheduled_lessons_path, method: :get,
              class: "ds-card mb-6 grid gap-4 p-5 md:grid-cols-2 xl:grid-cols-5" do |form| %>
  <%= form.hidden_field :week, value: @week_start.iso8601 %>
  <div>
    <%= form.label :q, t("actions.search"), class: "ds-label" %>
    <%= form.search_field :q, value: params[:q], class: "ds-control mt-2" %>
  </div>
  <div>
    <%= form.label :teacher_profile_id, t("scheduling.fields.teacher"), class: "ds-label" %>
    <%= form.collection_select :teacher_profile_id, @teachers, :id, :display_name,
                               { include_blank: t("actions.all"), selected: params[:teacher_profile_id] },
                               class: "ds-control mt-2" %>
  </div>
  <div>
    <%= form.label :course_offering_id, t("scheduling.fields.offering"), class: "ds-label" %>
    <%= form.collection_select :course_offering_id, @offerings, :id, :title_en,
                               { include_blank: t("actions.all"), selected: params[:course_offering_id] },
                               class: "ds-control mt-2" %>
  </div>
  <div>
    <%= form.label :status, t("scheduling.fields.status"), class: "ds-label" %>
    <%= form.select :status,
                    ScheduledLesson::STATUSES.map { |status| [t("scheduling.catalogs.statuses.#{status}"), status] },
                    { include_blank: t("actions.all"), selected: params[:status] },
                    class: "ds-control mt-2" %>
  </div>
  <div class="flex items-end gap-2">
    <%= render "shared/components/button", label: t("actions.filter"), type: :submit %>
    <%= render "shared/components/button", label: t("actions.reset"),
                                                  href: admin_scheduled_lessons_path(week: @week_start.iso8601),
                                                  variant: :secondary %>
  </div>
<% end %>

<section class="ds-card overflow-x-auto" aria-label="<%= t("scheduling.weekly.calendar_label") %>">
  <div class="grid min-w-[1120px] grid-cols-7 divide-x divide-x-reverse divide-app-border">
    <% week_days.each do |day| %>
      <% lessons = @lessons_by_day.fetch(day, []) %>
      <section class="min-h-[28rem] bg-app-surface">
        <header class="sticky top-0 z-10 border-b border-app-border bg-app-surface-muted px-3 py-3 text-center">
          <h2 class="font-semibold"><%= t("scheduling.catalogs.weekdays.#{day.strftime('%A').downcase}") %></h2>
          <p class="mt-1 text-sm <%= "font-bold text-app-primary" if day == Date.current %>" dir="ltr">
            <%= day.strftime("%d/%m") %>
          </p>
          <p class="mt-1 ds-caption"><%= t("scheduling.weekly.lessons_count", count: lessons.size) %></p>
        </header>

        <div class="space-y-3 p-3">
          <% lessons.each do |lesson| %>
            <% local_start = lesson.starts_at.in_time_zone(lesson.academy_time_zone) %>
            <% local_end = lesson.ends_at.in_time_zone(lesson.academy_time_zone) %>
            <%= link_to admin_scheduled_lesson_path(lesson),
                        class: "block rounded-lg border border-app-border bg-white p-3 shadow-sm transition hover:border-app-primary hover:shadow-md focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" do %>
              <div class="flex items-start justify-between gap-2">
                <strong class="text-sm"><%= I18n.locale == :ar ? lesson.title_ar : lesson.title_en %></strong>
                <%= scheduling_status_badge(lesson) %>
              </div>
              <p class="mt-2 font-semibold text-app-primary" dir="ltr">
                <%= local_start.strftime("%H:%M") %> – <%= local_end.strftime("%H:%M") %>
              </p>
              <dl class="mt-3 space-y-2 text-xs">
                <div>
                  <dt class="ds-caption"><%= t("scheduling.fields.teacher") %></dt>
                  <dd class="mt-0.5 font-medium"><%= lesson.teacher_profile.display_name %></dd>
                </div>
                <div>
                  <dt class="ds-caption"><%= t("scheduling.weekly.students") %></dt>
                  <dd class="mt-0.5">
                    <%= lesson.scheduled_lesson_enrollments.filter_map { |item| item.student_profile&.display_name }.first(2).to_sentence.presence || t("scheduling.weekly.no_students") %>
                    <% if lesson.enrollments.size > 2 %>
                      <span class="text-app-primary">+<%= lesson.enrollments.size - 2 %></span>
                    <% end %>
                  </dd>
                </div>
                <div>
                  <dt class="ds-caption"><%= t("scheduling.fields.offering") %></dt>
                  <dd class="mt-0.5"><%= lesson.course_offering&.title_en %></dd>
                </div>
              </dl>
            <% end %>
          <% end %>

          <% if lessons.empty? %>
            <p class="rounded-lg border border-dashed border-app-border p-4 text-center ds-caption">
              <%= t("scheduling.weekly.no_lessons") %>
            </p>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
</section>