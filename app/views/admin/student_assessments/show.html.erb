<%= render "shared/page_header", title: @assessment.public_id, description: @assessment.assessment_template.localized_name,
           primary_action: (@assessment.draft? && current_user.admin? ? render("shared/components/button", label: t("actions.edit"), href: edit_admin_student_assessment_path(@assessment)) : nil) %>
<div class="grid gap-6 lg:grid-cols-2">
  <div class="ds-card p-5"><dl class="grid gap-4 sm:grid-cols-2"><% { student: @assessment.student_profile.user.full_name, teacher: @assessment.teacher_profile.user.full_name, date: l(@assessment.assessment_date), score: @assessment.overall_score, grade: @assessment.letter_grade, status: t("academic.statuses.#{@assessment.status}") }.each do |key, value| %><div><dt class="ds-caption"><%= t("academic.fields.#{key}") %></dt><dd class="font-semibold"><%= value || t("academic.not_available") %></dd></div><% end %></dl></div>
  <div class="ds-card p-5"><h2 class="font-bold"><%= t("academic.actions.lifecycle") %></h2><div class="mt-4 flex flex-wrap gap-2"><% %i[submit review publish archive].each do |action| %><% if current_user.admin? %><%= button_to t("academic.actions.#{action}"), public_send("#{action}_admin_student_assessment_path", @assessment), method: :patch, class: button_classes(variant: :secondary, size: :small) %><% end %><% end %></div></div>
</div>
<div class="mt-6 ds-card p-5"><h2 class="font-bold"><%= t("academic.scores.title") %></h2><div class="mt-4 grid gap-3"><% @scores.each do |score| %><p><strong><%= score.assessment_rubric_item.localized_name %>:</strong> <%= score.numeric_score || t("academic.ratings.#{score.rating}", default: t("academic.not_available")) %></p><% end %></div></div>
<div class="mt-6 ds-card p-5"><h2 class="font-bold"><%= t("academic.audit") %></h2><ol class="mt-3 divide-y divide-app-border"><% @events.each do |event| %><li class="py-2"><%= t("academic.events.#{event.event_type}") %> · <%= event.actor.full_name %></li><% end %></ol></div>
