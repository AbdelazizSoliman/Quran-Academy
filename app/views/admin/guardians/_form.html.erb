<%= render "shared/student_profiles/errors", profile: guardian %>
<%= form_with model: [:admin, guardian], class: "space-y-6" do |f| %>
  <fieldset class="ds-card p-5"><legend class="ds-section-title"><%= t("guardians.sections.identity") %></legend><div class="mt-4 grid gap-4 sm:grid-cols-2">
    <div><%= f.label :full_name, t("guardians.fields.full_name"), class: "ds-label" %><%= f.text_field :full_name, class: "ds-control mt-2" %></div>
    <div><%= f.label :gender, t("guardians.fields.gender"), class: "ds-label" %><%= f.select :gender, Guardian::GENDERS.map { |v| [t("student_profiles.catalogs.genders.#{v}"), v] }, {}, class: "ds-control mt-2" %></div>
    <% %i[email phone_number whatsapp_number country city occupation].each do |field| %><div><%= f.label field, t("guardians.fields.#{field}"), class: "ds-label" %><%= f.text_field field, class: "ds-control mt-2", dir: field.in?(%i[email phone_number whatsapp_number]) ? "ltr" : nil %></div><% end %>
    <div><%= f.label :preferred_contact_method, t("guardians.fields.preferred_contact_method"), class: "ds-label" %><%= f.select :preferred_contact_method, Guardian::CONTACT_METHODS.map { |v| [t("guardians.catalogs.contact_methods.#{v}"), v] }, {}, class: "ds-control mt-2" %></div>
    <div><%= f.label :preferred_language, t("guardians.fields.preferred_language"), class: "ds-label" %><%= f.select :preferred_language, Guardian::LANGUAGES.map { |v| [t("academy.languages.#{v}"), v] }, {}, class: "ds-control mt-2" %></div>
    <div class="sm:col-span-2"><%= f.label :internal_notes, t("guardians.fields.internal_notes"), class: "ds-label" %><%= f.text_area :internal_notes, rows: 3, class: "ds-control mt-2" %></div>
  </div></fieldset><div class="flex gap-3"><%= render "shared/components/button", label: t("actions.save"), type: "submit" %><%= render "shared/components/button", label: t("actions.cancel"), href: admin_guardians_path, variant: :secondary %></div>
<% end %>
