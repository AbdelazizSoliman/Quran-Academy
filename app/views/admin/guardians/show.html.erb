<% action = render("shared/components/button", label: t("actions.edit"), href: edit_admin_guardian_path(@guardian), variant: :secondary) %>
<%= render "shared/page_header", title: @guardian.full_name, description: @guardian.public_id, badge: guardian_status_badge(@guardian), primary_action: action %>
<%= render "shared/student_profiles/errors", profile: @guardian %>
<div class="grid gap-6 lg:grid-cols-2"><% details = capture do %><dl class="grid gap-4 sm:grid-cols-2"><% %i[email phone_number whatsapp_number preferred_contact_method preferred_language country city occupation].each do |f| %><div><dt class="ds-caption"><%= t("guardians.fields.#{f}") %></dt><dd class="mt-1"><%= student_value(@guardian.public_send(f)) %></dd></div><% end %></dl><% end %><%= render "shared/components/card", title: t("guardians.sections.contact"), body: details %>
<% links = capture do %><div class="space-y-3"><% @guardianships.each do |link| %><div class="rounded-xl border p-3"><%= link_to link.student_profile.display_name, admin_student_path(link.student_profile), class: "font-semibold text-app-primary" %><p class="ds-caption"><%= guardianship_label(link) %></p></div><% end %></div><% end %><%= render "shared/components/card", title: t("guardians.sections.students"), body: links %></div>
<div class="mt-6 flex gap-3"><% if @guardian.archived? %><%= button_to t("actions.restore"), restore_admin_guardian_path(@guardian), method: :patch, class: button_classes %><% else %><%= button_to t("actions.archive"), archive_admin_guardian_path(@guardian), method: :patch, class: button_classes(variant: :danger) %><% end %></div>
<div class="mt-6"><% history = capture do %><ol><% @events.each do |e| %><li class="border-b py-3"><%= t("guardians.audit.#{e.event_type}", actor: e.actor.full_name) %></li><% end %></ol><% end %><%= render "shared/components/card", title: t("guardians.sections.audit"), body: history %></div>
