<% action = render("shared/components/button", label: t("guardians.actions.new"), href: new_admin_guardian_path, icon: :plus) %>
<%= render "shared/page_header", title: t("guardians.index.title"), description: t("guardians.index.description"), primary_action: action %>
<% filters = capture do %><%= form_with url: admin_guardians_path, method: :get, class: "grid gap-4 md:grid-cols-4" do |f| %><div><%= f.label :q, t("actions.search"), class: "ds-label" %><%= f.search_field :q, value: params[:q], class: "ds-control mt-2" %></div><div><%= f.label :status, t("guardians.fields.status"), class: "ds-label" %><%= f.select :status, [["—",""]] + Guardian::STATUSES.map { |v| [t("guardians.catalogs.statuses.#{v}"), v] }, { selected: params[:status] }, class: "ds-control mt-2" %></div><div><%= f.label :sort, t("students.filters.sort"), class: "ds-label" %><%= f.select :sort, Admin::GuardiansQuery::SORT_COLUMNS.keys.map { |v| [v.humanize, v] }, { selected: params[:sort] }, class: "ds-control mt-2" %></div><div class="flex items-end"><%= render "shared/components/button", label: t("actions.search"), type: "submit" %></div><% end %><% end %><%= render "shared/components/card", body: filters %>
<div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-3"><% @guardians.each do |g| %><%= link_to admin_guardian_path(g), class: "ds-card p-5 focus-visible:outline" do %><div class="flex justify-between gap-2"><h2 class="ds-card-title"><%= g.full_name %></h2><%= guardian_status_badge(g) %></div><p class="mt-2 ds-caption" dir="ltr"><%= g.public_id %></p><p class="mt-2 text-sm"><%= student_value(g.email || g.phone_number || g.whatsapp_number) %></p><% end %><% end %></div>
<% if @guardians.empty? %><div class="mt-6"><%= render "shared/components/empty_state", icon: :users, title: t("guardians.empty.title"), description: t("guardians.empty.description"), primary_action: action %></div><% end %>
