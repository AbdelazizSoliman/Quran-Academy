<%= render "shared/page_header", title: t("academic.actions.issue_certificate") %><%= form_with model: [:admin, @certificate], class: "ds-card grid gap-5 p-5 sm:grid-cols-2" do |form| %><div><%= form.label :student_profile_id, t("academic.fields.student"), class: "ds-label" %><%= form.collection_select :student_profile_id, StudentProfile.includes(:user), :id, ->(profile) { profile.user.full_name }, {}, class: "ds-control mt-2" %></div><div><%= form.label :certificate_type, t("academic.fields.certificate_type"), class: "ds-label" %><%= form.select :certificate_type, Certificate::TYPES.map { |type| [t("academic.certificate_types.#{type}"), type] }, {}, class: "ds-control mt-2" %></div><div><%= form.label :issued_on, t("academic.fields.issue_date"), class: "ds-label" %><%= form.date_field :issued_on, class: "ds-control mt-2" %></div><div><%= form.label :enrollment_id, t("academic.fields.enrollment"), class: "ds-label" %><%= form.collection_select :enrollment_id, Enrollment.includes(student_profile: :user), :id, :public_id, { include_blank: true }, class: "ds-control mt-2" %></div><div><%= form.label :exam_session_id, t("academic.fields.exam"), class: "ds-label" %><%= form.collection_select :exam_session_id, ExamSession.where(status: %w[completed reviewed published]), :id, :title, { include_blank: true }, class: "ds-control mt-2" %></div><div class="sm:col-span-2"><%= form.label :notes, t("academic.fields.notes"), class: "ds-label" %><%= form.text_area :notes, rows: 3, class: "ds-control mt-2" %></div><%= render "shared/components/button", label: t("actions.save"), type: "submit" %><% end %>
