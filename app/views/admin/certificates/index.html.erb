<% action = current_user.admin? ? render("shared/components/button", label: t("academic.actions.issue_certificate"), href: new_admin_certificate_path, icon: :plus) : nil %><%= render "shared/page_header", title: t("academic.certificates.index"), primary_action: action %><div class="grid gap-4 sm:grid-cols-2"><% @certificates.each do |certificate| %><article class="ds-card p-5"><h2 class="font-bold"><%= link_to certificate.public_id, admin_certificate_path(certificate), class: "text-app-primary" %></h2><p class="mt-2"><%= certificate.student_profile.user.full_name %></p><p class="ds-caption"><%= t("academic.certificate_types.#{certificate.certificate_type}") %> · <%= l(certificate.issued_on) %></p></article><% end %></div>
