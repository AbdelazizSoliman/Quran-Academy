<div class="grid gap-3 sm:grid-cols-2">
  <% fields.each do |field| %>
    <label class="flex items-start gap-3 rounded-xl border border-app-border p-4">
      <%= form.check_box field, class: "ds-checkbox mt-1" %>
      <span><span class="block text-sm font-semibold"><%= t("admin.settings.fields.#{field}") %></span>
      <span class="mt-1 block ds-caption"><%= t("admin.settings.hints.#{field}", default: t("admin.settings.hints.readiness_only")) %></span></span>
    </label>
  <% end %>
</div>
