<% actions = capture do %><div class="flex flex-wrap gap-2"><%= render "shared/components/button", label: t("actions.edit"), href: edit_admin_course_offering_path(@offering), variant: :secondary %><% course_offering_actions(@offering).each do |action| %><%= button_to t("actions.#{action}"), public_send("#{action}_admin_course_offering_path", @offering), method: :patch, class: button_classes(variant: action.in?(%i[cancel archive]) ? :danger : :ghost, size: :small) %><% end %></div><% end %>
<%= render "shared/page_header", title: localized_offering_title(@offering), description: "#{@offering.code} · #{@offering.public_id}", badge: offering_status_badge(@offering), primary_action: actions %>
<%= render "shared/academic/errors", record: @offering %>
<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><%= render "shared/components/stat_card", label: t("course_offerings.capacity.used"), value: @offering.capacity_used, icon: :users %><%= render "shared/components/stat_card", label: t("course_offerings.capacity.available"), value: academic_value(@offering.capacity_available), icon: :check_circle %><%= render "shared/components/stat_card", label: t("academic.catalogs.enrollment_statuses.waitlisted"), value: @status_counts["waitlisted"].to_i, icon: :warning %><%= render "shared/components/stat_card", label: t("academic.catalogs.enrollment_statuses.pending"), value: @status_counts["pending"].to_i, icon: :reports %></div>
<div class="mt-6 grid gap-6 lg:grid-cols-2"><% details = capture do %><dl class="grid gap-4 sm:grid-cols-2"><% %i[learning_language delivery_mode enrollment_opens_on enrollment_closes_on planned_start_on planned_end_on default_lesson_duration_minutes intended_lessons_per_week placement_required].each do |field| %><div><dt class="ds-caption"><%= t("course_offerings.fields.#{field}") %></dt><dd class="mt-1"><%= academic_value(@offering.public_send(field)) %></dd></div><% end %></dl><% end %><%= render "shared/components/card", title: t("course_offerings.sections.operation"), body: details %>
<% context = capture do %><p><%= link_to localized_program_name(@offering.program), admin_program_path(@offering.program), class: "font-semibold text-app-primary" %></p><p class="mt-4 text-sm"><strong><%= t("course_offerings.madarak.teachers") %>:</strong> <%= @offering.teacher_profiles.any? ? @offering.teacher_profiles.map(&:display_name).to_sentence : t("course_offerings.madarak.unassigned") %></p><div class="mt-4 flex flex-wrap gap-3"><%= render "shared/components/button", label: t("enrollments.actions.new"), href: new_admin_enrollment_path(course_offering_id: @offering.id), icon: :plus %><%= render "shared/components/button", label: t("enrollments.index.title"), href: admin_enrollments_path(course_offering_id: @offering.id), variant: :secondary %><%= render "shared/components/button", label: t("course_offerings.madarak.schedule"), href: admin_scheduled_lessons_path(course_offering_id: @offering.id), variant: :secondary %></div><% end %><%= render "shared/components/card", title: t("course_offerings.sections.enrollments"), body: context %></div>
<div class="mt-6"><% history = capture do %><ol class="divide-y"><% @events.each do |event| %><li class="py-3"><%= t("course_offerings.audit.#{event.event_type}", actor: event.actor.full_name) %></li><% end %></ol><% end %><%= render "shared/components/card", title: t("course_offerings.sections.audit"), body: history %></div>
