<% action = render("shared/components/button", label: t("course_offerings.actions.new"), href: new_admin_course_offering_path, icon: :plus) %>
<%= render "shared/page_header", title: t("course_offerings.index.title"), description: t("course_offerings.index.description"), primary_action: action %>
<%= form_with url: admin_course_offerings_path, method: :get, class: "ds-card grid gap-4 p-5 md:grid-cols-4" do |f| %><div><%= f.label :q, t("actions.search"), class: "ds-label" %><%= f.search_field :q, value: params[:q], class: "ds-control mt-2" %></div><div><%= f.label :status, t("course_offerings.fields.status"), class: "ds-label" %><%= f.select :status, [["—",""]] + CourseOffering::STATUSES.map { |v| [t("academic.catalogs.offering_statuses.#{v}"), v] }, { selected: params[:status] }, class: "ds-control mt-2" %></div><div><%= f.label :program_id, t("course_offerings.fields.program"), class: "ds-label" %><%= f.collection_select :program_id, Program.order(:name_en), :id, :name_en, { include_blank: true }, class: "ds-control mt-2" %></div><div class="flex items-end"><%= render "shared/components/button", label: t("actions.search"), type: "submit" %></div><% end %>
<div class="mt-6 overflow-x-auto rounded-xl border"><table class="min-w-full divide-y"><thead><tr><% %i[title code program status capacity planned_start actions].each do |field| %><th class="px-4 py-3 text-start ds-table-heading"><%= t("course_offerings.fields.#{field}") %></th><% end %></tr></thead><tbody class="divide-y"><% @offerings.each do |o| %><tr><th class="px-4 py-3 text-start"><%= link_to localized_offering_title(o), admin_course_offering_path(o), class: "font-semibold text-app-primary" %></th><td class="px-4 py-3" dir="ltr"><%= o.code %></td><td class="px-4 py-3"><%= localized_program_name(o.program) %></td><td class="px-4 py-3"><%= offering_status_badge(o) %></td><td class="px-4 py-3"><%= academic_value(o.capacity) %></td><td class="px-4 py-3"><%= academic_value(o.planned_start_on) %></td><td class="px-4 py-3"><%= link_to t("actions.view"), admin_course_offering_path(o), class: button_classes(variant: :ghost, size: :small) %></td></tr><% end %></tbody></table></div>
<% if @offerings.empty? %><div class="mt-6"><%= render "shared/components/empty_state", icon: :calendar, title: t("course_offerings.empty.title"), description: t("course_offerings.empty.description"), primary_action: action %></div><% end %>
