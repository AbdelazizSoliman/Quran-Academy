<%= render "shared/page_header", title: t("communications.admin.show.title"), description: @log.public_id %><section class="ds-card p-5"><dl class="grid gap-3 sm:grid-cols-2"><div><dt class="ds-caption"><%= t("communications.fields.recipient") %></dt><dd><%= @log.recipient_address_masked %></dd></div><div><dt class="ds-caption"><%= t("communications.fields.status") %></dt><dd><%= t("communications.statuses.#{@log.status}") %></dd></div></dl><h2 class="mt-5 font-semibold"><%= t("communications.fields.preview") %></h2><p class="mt-2 whitespace-pre-line"><%= @log.message_snapshot %></p><div class="mt-5 flex flex-wrap gap-2"><% if @log.status.in?(%w[prepared opened]) && @log.external_url.present? %><%= link_to t("communications.actions.open_#{@log.channel}"), mark_opened_admin_communication_log_path(@log), data: { turbo_method: :patch }, target: "_blank", rel: "noopener", class: button_classes %><%= button_to t("communications.actions.confirm_sent"), confirm_sent_admin_communication_log_path(@log), method: :patch, class: button_classes(variant: :secondary) %><% end %></div></section>
