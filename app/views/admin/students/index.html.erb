<% action = render("shared/components/button", label: t("students.actions.new"), href: new_admin_student_path, icon: :plus) %>
<%= render "shared/page_header", title: t("students.index.title"), description: t("students.index.description"), primary_action: action %>
<% filters = capture do %>
  <%= form_with url: admin_students_path, method: :get, class: "grid gap-4 md:grid-cols-3 xl:grid-cols-5" do |f| %>
    <div class="md:col-span-2"><%= f.label :q, t("actions.search"), class: "ds-label" %><%= f.search_field :q, value: params[:q], class: "ds-control mt-2" %></div>
    <% { student_type: StudentProfile::STUDENT_TYPES, profile_status: StudentProfile::PROFILE_STATUSES, learning_status: StudentProfile::LEARNING_STATUSES }.each do |field, values| %>
      <div><%= f.label field, t("student_profiles.fields.#{field}"), class: "ds-label" %><%= f.select field, [["—", ""]] + values.map { |v| [t("student_profiles.catalogs.#{field.to_s.pluralize}.#{v}"), v] }, { selected: params[field] }, class: "ds-control mt-2" %></div>
    <% end %>
    <div><%= f.label :guardian, t("students.filters.guardian"), class: "ds-label" %><%= f.select :guardian, [[t("students.filters.all"), ""], [t("students.filters.has_guardian"), "present"], [t("students.filters.missing_guardian"), "missing"]], { selected: params[:guardian] }, class: "ds-control mt-2" %></div>
    <div><%= f.label :sort, t("students.filters.sort"), class: "ds-label" %><%= f.select :sort, Admin::StudentsQuery::SORT_COLUMNS.keys.map { |v| [t("students.sorts.#{v}", default: v.humanize), v] }, { selected: params[:sort] }, class: "ds-control mt-2" %></div>
    <div class="flex items-end gap-2"><%= render "shared/components/button", label: t("actions.search"), type: "submit" %><%= render "shared/components/button", label: t("students.filters.clear"), href: admin_students_path, variant: :ghost %></div>
  <% end %>
<% end %><%= render "shared/components/card", body: filters %>
<div class="mt-6 overflow-hidden rounded-xl border border-app-border bg-app-surface"><div class="overflow-x-auto"><table class="min-w-full divide-y divide-app-border">
  <thead class="bg-app-muted"><tr><% %i[student public_id student_type profile_status learning_status completion actions].each do |f| %><th class="px-4 py-3 text-start ds-table-heading"><%= t("student_profiles.fields.#{f}") %></th><% end %></tr></thead>
  <tbody class="divide-y divide-app-border"><% @profiles.each do |p| %><tr>
    <th class="px-4 py-3 text-start"><%= link_to p.display_name.presence || p.user.full_name, admin_student_path(p), class: "font-semibold text-app-primary" %><p class="ds-caption" dir="ltr"><%= p.user.email %></p></th>
    <td class="px-4 py-3" dir="ltr"><%= p.public_id %></td><td class="px-4 py-3"><%= student_catalog_badge(:student_types, p.student_type) %></td><td class="px-4 py-3"><%= student_profile_status_badge(p) %></td><td class="px-4 py-3"><%= student_learning_status_badge(p) %></td><td class="px-4 py-3"><%= p.completion_percentage %>%</td><td class="px-4 py-3"><%= link_to t("actions.view"), admin_student_path(p), class: button_classes(variant: :ghost, size: :small) %></td>
  </tr><% end %></tbody></table></div>
  <% if @profiles.empty? %><div class="p-6"><%= render "shared/components/empty_state", icon: :users, title: t("students.empty.title"), description: t("students.empty.description"), primary_action: action %></div><% end %>
</div>
<% if @pagy.pages > 1 %><div class="mt-5 flex justify-end gap-2"><% if @pagy.previous %><%= link_to t("pagination.previous"), admin_students_path(request.query_parameters.merge(page: @pagy.previous)), class: button_classes(variant: :secondary, size: :small) %><% end %><% if @pagy.next %><%= link_to t("pagination.next"), admin_students_path(request.query_parameters.merge(page: @pagy.next)), class: button_classes(variant: :secondary, size: :small) %><% end %></div><% end %>
