<% actions = capture do %><div class="flex flex-wrap gap-2"><%= render "shared/components/button", label: t("actions.edit"), href: edit_admin_student_path(@profile), variant: :secondary %><% if @profile.archived? %><%= button_to t("actions.restore"), restore_admin_student_path(@profile), method: :patch, class: button_classes %><% else %><%= button_to t("actions.verify"), verify_admin_student_path(@profile), method: :patch, class: button_classes %><%= button_to t("actions.archive"), archive_admin_student_path(@profile), method: :patch, class: button_classes(variant: :danger) %><% end %></div><% end %>
<%= render "shared/page_header", title: @profile.display_name.presence || @profile.user.full_name, description: @profile.public_id, badge: student_profile_status_badge(@profile), primary_action: actions %>
<%= render "shared/student_profiles/errors", profile: @profile %>
<div class="grid gap-6 lg:grid-cols-2">
  <% summary = capture do %><dl class="grid gap-4 sm:grid-cols-2">
    <% { user: link_to(@profile.user.full_name, admin_user_path(@profile.user), class: "text-app-primary"), student_type: student_catalog_badge(:student_types, @profile.student_type), learning_status: student_learning_status_badge(@profile), date_of_birth: student_value(@profile.date_of_birth), age: student_value(@profile.age), completion: "#{@profile.completion_percentage}%" }.each do |f,v| %><div><dt class="ds-caption"><%= t("student_profiles.fields.#{f}") %></dt><dd class="mt-1"><%= v %></dd></div><% end %>
  </dl><% if @profile.age_type_mismatch? %><p class="mt-4 text-sm text-amber-700"><%= t("student_profiles.completeness.age_mismatch") %></p><% end %><% end %>
  <%= render "shared/components/card", title: t("student_profiles.sections.identity"), body: summary %>
  <% learning = capture do %><dl class="grid gap-4 sm:grid-cols-2"><% %i[preferred_learning_language current_quran_level reading_level tajweed_level memorization_level memorized_juz_count learning_goals].each do |f| %><div><dt class="ds-caption"><%= t("student_profiles.fields.#{f}") %></dt><dd class="mt-1 whitespace-pre-line"><%= student_value(@profile.public_send(f)) %></dd></div><% end %></dl><% end %>
  <%= render "shared/components/card", title: t("student_profiles.sections.learning"), body: learning %>
  <% contact = capture do %><dl class="grid gap-4 sm:grid-cols-2"><% %i[phone_number whatsapp_number country_of_residence city emergency_contact_name emergency_contact_phone].each do |f| %><div><dt class="ds-caption"><%= t("student_profiles.fields.#{f}") %></dt><dd class="mt-1"><%= student_value(@profile.public_send(f)) %></dd></div><% end %></dl><% end %>
  <%= render "shared/components/card", title: t("student_profiles.sections.contact"), body: contact %>
  <% sensitive = capture do %><dl class="space-y-4"><% %i[special_learning_needs medical_notes safeguarding_notes internal_notes].each do |f| %><div><dt class="ds-caption"><%= t("student_profiles.fields.#{f}") %></dt><dd class="mt-1 whitespace-pre-line"><%= student_value(@profile.public_send(f)) %></dd></div><% end %></dl><% end %>
  <%= render "shared/components/card", title: t("student_profiles.sections.sensitive"), body: sensitive %>
</div>
<div class="mt-6"><% guardian_body = capture do %>
  <div class="space-y-4"><% @guardianships.each do |link| %><div class="rounded-xl border border-app-border p-4"><div class="flex flex-wrap justify-between gap-2"><div><%= link_to link.guardian.full_name, admin_guardian_path(link.guardian), class: "font-semibold text-app-primary" %><p class="ds-caption"><%= guardianship_label(link) %></p></div><div class="flex gap-2"><% if link.primary_contact? %><%= render "shared/components/badge", label: t("guardianships.primary"), variant: :success %><% elsif link.active? %><%= button_to t("guardianships.actions.make_primary"), make_primary_admin_student_guardianship_path(@profile, link), method: :patch, class: button_classes(variant: :secondary, size: :small) %><% end %><% if link.active? %><%= button_to t("guardianships.actions.end"), end_admin_student_guardianship_path(@profile, link), method: :patch, class: button_classes(variant: :danger, size: :small) %><% end %></div></div></div><% end %>
  <%= form_with url: admin_student_guardianships_path(@profile), method: :post, scope: :student_guardianship, class: "grid gap-3 md:grid-cols-3" do |f| %><%= f.collection_select :guardian_id, Guardian.where.not(status: "archived").order(:full_name), :id, :full_name, { include_blank: t("guardianships.form.select_guardian") }, class: "ds-control" %><%= f.select :relationship_type, StudentGuardianship::RELATIONSHIP_TYPES.map { |v| [t("guardianships.relationships.#{v}"), v] }, {}, class: "ds-control" %><%= render "shared/components/button", label: t("guardianships.actions.attach"), type: "submit" %><% end %>
  <details class="rounded-xl border border-app-border p-4"><summary class="cursor-pointer font-semibold text-app-primary"><%= t("guardianships.actions.create_and_attach") %></summary>
    <%= form_with url: create_guardian_admin_student_guardianships_path(@profile), method: :post, class: "mt-4 grid gap-3 md:grid-cols-2" do |f| %>
      <%= fields_for :guardian do |g| %><%= g.text_field :full_name, placeholder: t("guardians.fields.full_name"), class: "ds-control" %><%= g.email_field :email, placeholder: t("guardians.fields.email"), class: "ds-control", dir: "ltr" %><%= g.hidden_field :gender, value: "unspecified" %><%= g.hidden_field :preferred_contact_method, value: "email" %><%= g.hidden_field :preferred_language, value: I18n.locale %><% end %>
      <%= fields_for :student_guardianship do |l| %><%= l.select :relationship_type, StudentGuardianship::RELATIONSHIP_TYPES.map { |v| [t("guardianships.relationships.#{v}"), v] }, {}, class: "ds-control" %><%= render "shared/components/button", label: t("guardianships.actions.create_and_attach"), type: "submit" %><% end %>
    <% end %>
  </details>
  </div><% end %><%= render "shared/components/card", title: t("student_profiles.sections.guardians"), body: guardian_body %></div>
<div class="mt-6">
  <% enrollment_body = capture do %>
    <div class="space-y-3">
      <% @profile.enrollments.includes(course_offering: :program).recent_first.limit(5).each do |enrollment| %>
        <%= link_to admin_enrollment_path(enrollment), class: "flex items-center justify-between rounded-xl border border-app-border p-3" do %>
          <span><strong><%= localized_program_name(enrollment.course_offering.program) %></strong><span class="block ds-caption"><%= enrollment.public_id %></span></span>
          <%= enrollment_status_badge(enrollment) %>
        <% end %>
      <% end %>
      <div class="flex flex-wrap gap-3">
        <%= render "shared/components/button", label: t("enrollments.actions.new"), href: new_admin_enrollment_path(student_profile_id: @profile.id), icon: :plus %>
        <%= render "shared/components/button", label: t("enrollments.index.title"), href: admin_enrollments_path(student_profile_id: @profile.id), variant: :secondary %>
      </div>
    </div>
  <% end %>
  <%= render "shared/components/card", title: t("enrollments.index.title"), body: enrollment_body %>
</div>
<div class="mt-6"><% history = capture do %><ol class="divide-y divide-app-border"><% @events.each do |e| %><li class="py-3"><%= t("student_profiles.audit.#{e.event_type}", actor: e.actor.full_name) %><p class="ds-caption"><%= localized_datetime(e.created_at) %></p></li><% end %></ol><% end %><%= render "shared/components/card", title: t("student_profiles.sections.audit"), body: history %></div>
