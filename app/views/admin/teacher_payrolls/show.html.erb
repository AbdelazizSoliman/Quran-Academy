<%= render "shared/page_header", title: @payroll.teacher_profile.display_name, description: @payroll.public_id %>
<section class="ds-card p-5"><dl class="grid gap-4 sm:grid-cols-3"><% %i[calculation_strategy rate base_amount bonus_amount deduction_amount manual_adjustment_amount net_amount status].each do |field| %><div><dt class="ds-caption"><%= t("payroll.fields.#{field}") %></dt><dd><%= field == :status ? t("payroll.statuses.#{@payroll.status}") : @payroll.public_send(field) %></dd></div><% end %></dl><% if current_user.admin? %><div class="mt-5 flex flex-wrap gap-2"><%= render "shared/components/button", label: t("payroll.actions.adjust"), href: edit_admin_teacher_payroll_path(@payroll), variant: :secondary if @payroll.draft? %><%= button_to t("payroll.actions.prepare"), prepare_admin_teacher_payroll_path(@payroll), method: :patch, class: button_classes if @payroll.draft? %><%= button_to t("payroll.actions.approve"), approve_admin_teacher_payroll_path(@payroll), method: :patch, class: button_classes if @payroll.prepared? %><%= button_to t("payroll.actions.mark_paid"), mark_paid_admin_teacher_payroll_path(@payroll), method: :patch, class: button_classes if @payroll.approved? %><%= button_to t("payroll.actions.reopen"), reopen_admin_teacher_payroll_path(@payroll), method: :patch, params: { reason: t("payroll.defaults.reopen_reason") }, class: button_classes(variant: :secondary) if @payroll.status.in?(%w[prepared approved]) %><%= button_to t("payroll.actions.cancel"), cancel_admin_teacher_payroll_path(@payroll), method: :patch, params: { reason: t("payroll.defaults.cancel_reason") }, class: button_classes(variant: :danger) if @payroll.status.in?(%w[draft prepared approved]) %></div><% end %></section>
<section class="mt-6"><h2 class="text-xl font-semibold"><%= t("payroll.sections.lessons") %></h2><div class="mt-3 space-y-2"><% @items.each do |item| %><article class="ds-card grid gap-2 p-4 sm:grid-cols-4"><span><%= item.scheduled_lesson.title_en %></span><span dir="ltr"><%= l(item.scheduled_lesson.starts_at, format: :short) %></span><span><%= item.duration_minutes %> min</span><span><%= item.amount %> <%= @payroll.currency %></span></article><% end %></div></section>
<section class="mt-6"><h2 class="text-xl font-semibold"><%= t("payroll.sections.audit") %></h2><div class="mt-3 space-y-2"><% @events.each do |event| %><p class="ds-card p-3"><%= t("payroll.events.#{event.event_type}") %> · <%= event.actor.full_name %> · <span dir="ltr"><%= l(event.created_at, format: :short) %></span></p><% end %></div></section>
