<%= render "shared/page_header", title: t("finance.ledger.title"), description: t("finance.ledger.description") %><%= render "admin/finance/navigation" %>
<div class="ds-card overflow-x-auto"><table class="min-w-full text-sm"><thead><tr class="border-b"><th class="p-4 text-start"><%= t("finance.fields.date") %></th><th class="p-4 text-start"><%= t("finance.fields.type") %></th><th class="p-4 text-start"><%= t("finance.fields.account") %></th><th class="p-4 text-start"><%= t("finance.fields.direction") %></th><th class="p-4 text-start"><%= t("finance.fields.amount") %></th><th class="p-4 text-start"><%= t("finance.fields.source") %></th></tr></thead><tbody><% @entries.each do |entry| %><tr class="border-b last:border-0"><td class="p-4"><%= l(entry.occurred_on) %></td><td class="p-4"><%= t("finance.entry_types.#{entry.entry_type}") %></td><td class="p-4"><%= t("finance.accounts.#{entry.account}") %></td><td class="p-4"><%= t("finance.directions.#{entry.direction}") %></td><td class="p-4" dir="ltr"><%= number_to_currency(entry.amount, unit: entry.currency) %></td><td class="p-4" dir="ltr"><%= entry.source.try(:public_id) %></td></tr><% end %></tbody></table></div>
