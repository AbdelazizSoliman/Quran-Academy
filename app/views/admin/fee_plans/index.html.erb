<header class="mb-6 flex items-start justify-between gap-4">
  <div>
    <h1 class="ds-page-title"><%= t("fee_plans.index.title") %></h1>
    <p class="mt-2 ds-supporting"><%= t("fee_plans.index.description") %></p>
  </div>
  <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-app-primary-soft text-app-primary">
    <%= icon :wallet, size: 6 %>
  </span>
</header>
<%= render "admin/finance/navigation" %>

<div class="ds-card p-5">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="ds-section-title"><%= t("fee_plans.recurring.title") %></h2>
      <p class="mt-1 ds-caption"><%= t("fee_plans.recurring.description") %></p>
    </div>
    <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-app-primary-soft text-app-primary">
      <%= icon :layers %>
    </span>
  </div>

  <%= form_with model: [:admin, @fee_plan] do |form| %>
    <div class="mt-5 flex flex-wrap items-center gap-2">
      <div class="min-w-[14rem] flex-1">
        <%= form.text_field :name, placeholder: t("fee_plans.fields.name"), required: true, class: "ds-control" %>
      </div>
      <div class="w-32">
        <%= form.number_field :amount, min: 0, step: 0.01, placeholder: t("fee_plans.fields.amount"), required: true,
                                       class: "ds-control" %>
      </div>
      <div class="w-24">
        <%= form.select :currency, %w[EGP USD SAR AED], {}, class: "ds-control" %>
      </div>
      <div class="w-28">
        <%= form.select :billing_cycle,
                         FeePlan::BILLING_CYCLES.map { |cycle| [t("fee_plans.billing_cycles.#{cycle}"), cycle] },
                         {}, class: "ds-control" %>
      </div>
      <div class="w-20">
        <%= form.number_field :tax_percentage, min: 0, max: 100, step: 0.01, title: t("fee_plans.fields.tax_percentage"),
                                               class: "ds-control" %>
      </div>
      <div class="w-20">
        <%= form.number_field :invoice_day, min: 1, max: 31, title: t("fee_plans.fields.invoice_day"), class: "ds-control" %>
      </div>
      <%= render "shared/components/button", label: t("fee_plans.actions.create"), type: "submit", icon: :plus %>
    </div>
  <% end %>

  <% if @fee_plans.any? %>
    <div class="mt-5 overflow-x-auto rounded-2xl border border-app-border">
      <table class="min-w-full text-sm">
        <thead class="bg-app-muted">
          <tr>
            <th class="px-4 py-3 text-start"><%= t("fee_plans.fields.name") %></th>
            <th class="px-4 py-3 text-start"><%= t("fee_plans.fields.amount") %></th>
            <th class="px-4 py-3 text-start"><%= t("fee_plans.fields.billing_cycle") %></th>
            <th class="px-4 py-3 text-start"><%= t("fee_plans.fields.tax_percentage") %></th>
            <th class="px-4 py-3 text-start"><%= t("fee_plans.students") %></th>
            <th class="px-4 py-3 text-start"><%= t("fee_plans.fields.active") %></th>
            <th class="px-4 py-3"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-app-border">
          <% @fee_plans.each do |fee_plan| %>
            <tr>
              <td class="px-4 py-3 font-semibold">
                <%= link_to fee_plan.name, edit_admin_fee_plan_path(fee_plan), class: "text-app-primary" %>
              </td>
              <td class="px-4 py-3"><%= number_to_currency(fee_plan.amount, unit: fee_plan.currency_symbol, format: "%n %u", precision: 2) %></td>
              <td class="px-4 py-3"><%= t("fee_plans.billing_cycles.#{fee_plan.billing_cycle}") %></td>
              <td class="px-4 py-3"><%= number_to_percentage(fee_plan.tax_percentage, precision: 0) %></td>
              <td class="px-4 py-3"><%= fee_plan.student_profiles.size %></td>
              <td class="px-4 py-3">
                <span class="<%= badge_classes(fee_plan.active? ? :success : :neutral) %>">
                  <%= fee_plan.active? ? t("fee_plans.active") : t("fee_plans.inactive") %>
                </span>
              </td>
              <td class="px-4 py-3 text-end">
                <%= button_to t("actions.delete"), admin_fee_plan_path(fee_plan), method: :delete,
                                                   class: "text-xs font-semibold text-app-danger",
                                                   form: { data: { turbo_confirm: t("fee_plans.messages.confirm_delete") } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="mt-5">
      <%= render "shared/components/empty_state", icon: :wallet, title: t("fee_plans.empty.title"),
                                                   description: t("fee_plans.empty.description") %>
    </div>
  <% end %>
</div>
