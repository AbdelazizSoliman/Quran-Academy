<% new_action = render("shared/components/button", label: t("admin.users.actions.new"), href: new_admin_user_path, icon: :plus) %>
<%= render "shared/page_header",
           title: t("admin.users.index.title"),
           description: t("admin.users.index.description"),
           primary_action: new_action %>

<% filters_body = capture do %>
  <%= form_with url: admin_users_path, method: :get, class: "grid gap-4 lg:grid-cols-6", data: { component: "user-filters" } do |form| %>
    <div class="lg:col-span-2">
      <%= form.label :query, t("admin.users.filters.query"), class: "ds-label" %>
      <%= form.search_field :query, value: params[:query], class: "ds-control mt-2", autocomplete: "off" %>
    </div>
    <% { role: User.roles.keys, status: User.statuses.keys, preferred_locale: %w[ar en] }.each do |field, values| %>
      <div>
        <%= form.label field, t("admin.users.fields.#{field}"), class: "ds-label" %>
        <%= form.select field,
                        [[t("admin.users.filters.all"), ""]] + values.map { |value| [t(field == :preferred_locale ? "admin.users.locales.#{value}" : "#{field.to_s.pluralize}.#{value}"), value] },
                        { selected: params[field] }, class: "ds-control mt-2" %>
      </div>
    <% end %>
    <div class="flex items-end gap-2">
      <%= render "shared/components/button", label: t("actions.search"), type: "submit", icon: :search %>
      <%= render "shared/components/button", label: t("admin.users.filters.clear"), href: admin_users_path, variant: :ghost %>
    </div>
  <% end %>
<% end %>
<%= render "shared/components/card", body: filters_body %>

<div class="mt-6 overflow-hidden rounded-xl border border-app-border bg-app-surface shadow-sm" data-component="admin-users-table">
  <div class="overflow-x-auto">
    <table class="min-w-full divide-y divide-app-border">
      <caption class="sr-only"><%= t("admin.users.index.caption") %></caption>
      <thead class="bg-app-muted">
        <tr>
          <% %w[name email role status preferred_locale time_zone sign_in_count last_sign_in_at created_at actions].each do |field| %>
            <th scope="col" class="whitespace-nowrap px-4 py-3 text-start ds-table-heading">
              <% if field.in?(Admin::UsersQuery::SORTS.keys) %>
                <% direction = params[:sort] == field && params[:direction] != "asc" ? "asc" : "desc" %>
                <%= link_to t("admin.users.fields.#{field}"), admin_users_path(request.query_parameters.merge(sort: field, direction:)), class: "hover:text-app-primary" %>
              <% else %>
                <%= t("admin.users.fields.#{field}") %>
              <% end %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-app-border">
        <% @users.each do |user| %>
          <tr class="hover:bg-app-muted/50">
            <th scope="row" class="whitespace-nowrap px-4 py-3 text-start text-sm font-semibold"><%= link_to user.full_name, admin_user_path(user), class: "text-app-primary hover:underline" %></th>
            <td class="whitespace-nowrap px-4 py-3 text-sm"><%= user.email %></td>
            <td class="px-4 py-3"><%= user_role_badge(user) %></td>
            <td class="px-4 py-3"><%= user_status_badge(user) %></td>
            <td class="px-4 py-3 text-sm"><%= t("admin.users.locales.#{user.preferred_locale}") %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm"><%= user.time_zone %></td>
            <td class="px-4 py-3 text-sm"><%= user.sign_in_count %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm"><%= localized_datetime(user.last_sign_in_at) %></td>
            <td class="whitespace-nowrap px-4 py-3 text-sm"><%= localized_datetime(user.created_at) %></td>
            <td class="px-4 py-3">
              <%= render "shared/components/dropdown",
                         icon_only: true,
                         aria_label: t("accessibility.row_actions"),
                         items: [
                           { label: t("actions.view"), href: admin_user_path(user), icon: :users },
                           { label: t("actions.edit"), href: edit_admin_user_path(user), icon: :settings }
                         ] %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if @users.empty? %>
    <div class="p-5"><%= render "shared/components/empty_state", icon: :users, title: t("admin.users.empty.title"), description: t("admin.users.empty.description") %></div>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <nav class="mt-5 flex flex-wrap justify-between gap-3" aria-label="<%= t("accessibility.pagination") %>">
    <p class="ds-caption"><%= t("pagination.summary", from: @pagy.from, to: @pagy.to, total: @pagy.count) %></p>
    <div class="flex gap-2">
      <% if @pagy.previous %><%= link_to t("pagination.previous"), admin_users_path(request.query_parameters.merge(page: @pagy.previous)), class: button_classes(variant: :secondary, size: :small) %><% end %>
      <% if @pagy.next %><%= link_to t("pagination.next"), admin_users_path(request.query_parameters.merge(page: @pagy.next)), class: button_classes(variant: :secondary, size: :small) %><% end %>
    </div>
  </nav>
<% end %>
