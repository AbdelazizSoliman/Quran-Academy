<%= render "shared/page_header",
           title: t("admin.users.password.title", name: @user.full_name),
           description: t("admin.users.password.description"),
           breadcrumbs: [
             { label: t("admin.users.index.title"), href: admin_users_path },
             { label: @user.full_name, href: admin_user_path(@user) },
             { label: t("admin.users.actions.reset_password") }
           ] %>
<% password_body = capture do %>
  <% if @user.errors.any? %>
    <%= render "shared/components/alert", variant: :error, title: t("admin.users.form.errors_title"), message: @user.errors.full_messages.to_sentence %>
  <% end %>
  <%= form_with model: @user, url: reset_password_admin_user_path(@user), method: :patch, class: "mt-5 space-y-5", data: { component: "admin-password-reset" } do |form| %>
    <div>
      <%= form.label :password, t("admin.users.fields.password"), class: "ds-label" %>
      <%= form.password_field :password, class: "ds-control mt-2", required: true, autocomplete: "new-password", value: nil %>
    </div>
    <div>
      <%= form.label :password_confirmation, t("admin.users.fields.password_confirmation"), class: "ds-label" %>
      <%= form.password_field :password_confirmation, class: "ds-control mt-2", required: true, autocomplete: "new-password", value: nil %>
    </div>
    <p class="ds-supporting"><%= t("admin.users.password.session_warning") %></p>
    <div class="flex justify-end gap-3 border-t border-app-border pt-5">
      <%= render "shared/components/button", label: t("actions.cancel"), href: admin_user_path(@user), variant: :secondary %>
      <%= render "shared/components/button", label: t("admin.users.actions.reset_password"), type: "submit", variant: :danger %>
    </div>
  <% end %>
<% end %>
<%= render "shared/components/card", body: password_body %>
