<% if user.errors.any? %>
  <%= render "shared/components/alert",
             variant: :error,
             title: t("admin.users.form.errors_title"),
             message: user.errors.full_messages.to_sentence %>
<% end %>

<%= form_with model: [:admin, user], class: "mt-5 space-y-6", data: { component: "admin-user-form" } do |form| %>
  <div class="grid gap-5 sm:grid-cols-2">
    <% { first_name: "given-name", last_name: "family-name", email: "email" }.each do |field, autocomplete| %>
      <div>
        <%= form.label field, t("admin.users.fields.#{field}"), class: "ds-label" %>
        <%= form.public_send(field == :email ? :email_field : :text_field, field,
                             class: "ds-control mt-2", required: true, autocomplete:,
                             aria: { invalid: user.errors[field].any? }) %>
        <% if user.errors[field].any? %><p class="mt-1 text-sm text-app-danger"><%= user.errors[field].to_sentence %></p><% end %>
      </div>
    <% end %>

    <% if user.new_record? %>
      <div>
        <%= label_tag "user_phone_number", t("admin.users.fields.phone_number"), class: "ds-label" %>
        <%= tag.input type: "tel", name: "user[phone_number]", id: "user_phone_number",
                      value: contact_fields[:phone_number], class: "ds-control mt-2", required: true,
                      autocomplete: "tel" %>
      </div>
      <div>
        <%= label_tag "user_whatsapp_number", t("admin.users.fields.whatsapp_number"), class: "ds-label" %>
        <%= tag.input type: "tel", name: "user[whatsapp_number]", id: "user_whatsapp_number",
                      value: contact_fields[:whatsapp_number], class: "ds-control mt-2", autocomplete: "tel" %>
        <p class="mt-1 ds-caption"><%= t("admin.users.form.whatsapp_fallback_hint") %></p>
      </div>
    <% end %>

    <div>
      <%= form.label :role, t("admin.users.fields.role"), class: "ds-label" %>
      <%= form.select :role, User.roles.keys.map { |role| [t("roles.#{role}"), role] }, {}, class: "ds-control mt-2" %>
    </div>

    <% unless user.new_record? %>
      <div>
        <span class="ds-label"><%= t("admin.users.fields.status") %></span>
        <div class="mt-3"><%= user_status_badge(user) %></div>
        <p class="mt-2 ds-caption"><%= t("admin.users.form.status_hint") %></p>
      </div>
    <% end %>

    <div>
      <%= form.label :preferred_locale, t("admin.users.fields.preferred_locale"), class: "ds-label" %>
      <% locale_options = [[t("admin.users.form.locale_automatic"), ""]] + I18n.available_locales.map { |locale| [t("admin.users.locales.#{locale}"), locale] } %>
      <%= form.select :preferred_locale, locale_options, {}, class: "ds-control mt-2" %>
    </div>

    <div>
      <%= form.label :time_zone, t("admin.users.fields.time_zone"), class: "ds-label" %>
      <%= form.time_zone_select :time_zone, ActiveSupport::TimeZone.all, { default: "Cairo" }, class: "ds-control mt-2" %>
    </div>

  </div>

  <% if user.new_record? %>
    <%= render "shared/components/alert", variant: :information, title: t("invitations.admin.creation_title"),
               message: t("invitations.admin.creation_hint") %>
  <% end %>

  <div class="flex flex-wrap justify-end gap-3 border-t border-app-border pt-5">
    <%= render "shared/components/button", label: t("actions.cancel"), href: admin_users_path, variant: :secondary %>
    <%= render "shared/components/button", label: t("actions.save"), type: "submit" %>
  </div>
<% end %>
