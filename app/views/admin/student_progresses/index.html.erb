<%= render "shared/page_header", title: t("academic.progress.index") %><div class="grid gap-4"><% @progresses.each do |progress| %><article class="ds-card p-5"><div class="flex justify-between gap-3"><h2 class="font-bold"><%= link_to progress.student_profile.user.full_name, admin_student_progress_path(progress), class: "text-app-primary" %></h2><span class="ds-badge"><%= t("academic.trends.#{progress.trend}") %></span></div><p class="mt-2 ds-caption"><%= t("academic.average", value: progress.average_score || t("academic.not_available")) %></p></article><% end %></div>
