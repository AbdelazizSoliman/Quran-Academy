<%= render "shared/page_header", title: @progress.student_profile.user.full_name, description: t("academic.progress.title") %><%= form_with model: [:admin, @progress], class: "ds-card grid gap-5 p-5 sm:grid-cols-3" do |form| %><% %i[current_surah current_page current_ayah memorization_progress revision_progress completion_percentage].each do |field| %><div><%= form.label field, t("academic.fields.#{field}"), class: "ds-label" %><%= field == :current_surah ? form.text_field(field, class: "ds-control mt-2") : form.number_field(field, min: 0, max: 604, step: 0.01, class: "ds-control mt-2") %></div><% end %><label class="flex items-center gap-2"><%= form.check_box :ijazah_ready, class: "ds-checkbox" %><%= t("academic.fields.ijazah_ready") %></label><div class="sm:col-span-3"><%= render "shared/components/button", label: t("actions.save"), type: "submit" %></div><% end %><div class="mt-6"><%= render "shared/academic/assessment_list", assessments: @assessments, path: ->(assessment) { admin_student_assessment_path(assessment) } %></div>
