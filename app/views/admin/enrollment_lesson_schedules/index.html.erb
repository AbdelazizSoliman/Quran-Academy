<%= render "shared/page_header", title: t("recurring_schedules.title"), description: @enrollment.public_id, primary_action: render("shared/components/button", label: t("recurring_schedules.actions.new"), href: new_admin_enrollment_lesson_schedule_path(@enrollment)) %>
<div class="grid gap-3"><% @schedules.each do |schedule| %><%= link_to admin_enrollment_lesson_schedule_path(@enrollment, schedule), class: "ds-card p-4" do %><strong><%= schedule.teacher_profile.display_name %></strong> · <%= schedule.starts_on %> · <%= schedule.status %> · <%= schedule.weekly_lesson_count %><% end %><% end %></div>
