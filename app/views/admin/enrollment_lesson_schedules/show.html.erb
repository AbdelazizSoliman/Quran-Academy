<%= render "shared/page_header", title: @schedule.public_id, description: @enrollment.public_id, primary_action: (@schedule.active? ? render("shared/components/button", label: t("recurring_schedules.actions.change"), href: new_change_admin_enrollment_lesson_schedule_path(@enrollment, @schedule)) : nil) %>
<%= render "shared/components/card", title: t("recurring_schedules.title") do %><p><%= @schedule.teacher_profile.display_name %> · <%= @schedule.time_zone %> · <%= @schedule.lesson_duration_minutes %> min · <%= @schedule.status %></p><ul class="mt-3"><% @schedule.slots.each do |slot| %><li><%= slot.weekday %> <span dir="ltr"><%= l(slot.starts_at_local, format: :time) %></span></li><% end %></ul><% if @schedule.active? %><%= button_to t("recurring_schedules.actions.cancel"), cancel_admin_enrollment_lesson_schedule_path(@enrollment, @schedule), method: :patch, class: button_classes(variant: :danger), form_class: "mt-4" %><% end %><% end %>
<%= render "shared/components/card", title: t("recurring_schedules.issues") do %><% @issues.each do |issue| %><p><%= issue.recurrence_date %> · <%= issue.reason_code %></p><% end %><%= render "shared/components/empty_state", icon: :calendar, title: t("recurring_schedules.no_issues"), description: "" if @issues.empty? %><% end %>
<%= render "shared/components/card", title: t("recurring_schedules.upcoming") do %><% @lessons.each do |lesson| %><p><%= link_to lesson.starts_at.in_time_zone(@schedule.time_zone).to_fs(:long), admin_scheduled_lesson_path(lesson), class: "text-app-primary" %> · <%= lesson.status %></p><% end %><% end %>
