<%= form_with model: [:admin, category], class: "ds-card grid gap-5 p-5 sm:grid-cols-2" do |form| %><div><%= form.label :code, t("academic.fields.code"), class: "ds-label" %><%= form.select :code, AssessmentCategory::CODES.map { |code| [t("academic.categories.#{code}"), code] }, {}, class: "ds-control mt-2" %></div><% %i[name_ar name_en].each do |field| %><div><%= form.label field, t("academic.fields.#{field}"), class: "ds-label" %><%= form.text_field field, required: true, class: "ds-control mt-2" %></div><% end %><div><%= form.label :display_order, t("academic.fields.display_order"), class: "ds-label" %><%= form.number_field :display_order, min: 0, class: "ds-control mt-2" %></div><label class="flex items-center gap-2"><%= form.check_box :active, class: "ds-checkbox" %><%= t("academic.fields.active") %></label><div class="sm:col-span-2"><%= render "shared/components/button", label: t("actions.save"), type: "submit" %></div><% end %>
