<%= render "shared/page_header", title: t("academic.categories_title"), primary_action: render("shared/components/button", label: t("academic.actions.new_category"), href: new_admin_assessment_category_path, icon: :plus) %><div class="grid gap-4 sm:grid-cols-2"><% @categories.each do |category| %><article class="ds-card p-5"><h2 class="font-bold"><%= link_to category.localized_name, admin_assessment_category_path(category), class: "text-app-primary" %></h2><p class="ds-caption"><%= category.code %> · <%= category.active? ? t("academic.active") : t("academic.inactive") %></p></article><% end %></div>
