<% if assessment.errors.any? %>
  <%= render "shared/components/alert", variant: :error, title: t("academic.errors.title"),
                                         message: assessment.errors.full_messages.to_sentence %>
<% end %>

<%= form_with model: [:teacher, assessment], url: teacher_assessments_path, class: "space-y-4" do |form| %>
  <%= form.hidden_field :assessment_template_id %>
  <%= form.hidden_field :scheduled_lesson_id if assessment.scheduled_lesson_id.present? %>

  <div class="grid gap-4 md:grid-cols-2">
      <% if assessment.student_profile.present? && assessment.scheduled_lesson.present? %>
        <div class="min-w-0">
          <span class="ds-label"><%= t("madarak_evaluations.fields.student") %></span>
          <p class="mt-2"><%= assessment.student_profile.display_name %></p>
          <%= form.hidden_field :student_profile_id %>
          <%= form.hidden_field :enrollment_id if assessment.enrollment_id.present? %>
        </div>
      <% else %>
        <div>
          <%= form.label :student_profile_id, t("madarak_evaluations.fields.student"), class: "ds-label" %>
          <%= form.collection_select :student_profile_id, students, :id, :display_name,
                                     { include_blank: true }, class: "ds-control mt-2", required: true %>
        </div>
      <% end %>
      <div class="min-w-0">
        <%= form.label :assessment_date, t("academic.fields.date"), class: "ds-label" %>
        <%= form.date_field :assessment_date, class: "ds-control mt-2", required: true %>
      </div>
  </div>

  <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
      <% Assessments::MadarakTemplate::CATEGORIES.each_key do |code| %>
        <div>
          <%= label_tag "quick_scores_#{code}", class: "ds-label" do %>
            <%= t("madarak_evaluations.fields.#{code}") %>
            <span class="font-normal text-app-subtle">(0–100)</span>
          <% end %>
          <%= number_field_tag "quick_scores[#{code}]", quick_scores[code] || 80,
                               id: "quick_scores_#{code}", min: 0, max: 100, step: 1,
                               class: "ds-control mt-2 bg-app-muted", required: true %>
        </div>
      <% end %>
  </div>

  <%= form.text_area :notes, class: "ds-control bg-app-muted", rows: 3,
                             placeholder: "#{t('academic.fields.notes')} (#{I18n.locale == :ar ? 'اختياري' : 'optional'})" %>

  <div>
    <%= render "shared/components/button", label: t("madarak_evaluations.actions.save_draft"), type: :submit, icon: :check %>
  </div>
<% end %>
