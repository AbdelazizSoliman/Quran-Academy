<%= render "shared/page_header", title: @assessment.public_id, description: @assessment.student_profile.user.full_name, primary_action: (@assessment.draft? ? render("shared/components/button", label: t("actions.edit"), href: edit_teacher_assessment_path(@assessment)) : nil) %><div class="ds-card p-5"><p><%= @assessment.assessment_template.localized_name %></p><p class="mt-2"><%= t("academic.fields.score") %>: <%= @assessment.overall_score || t("academic.not_available") %></p><% if @assessment.draft? %><div class="mt-5"><%= button_to t("academic.actions.submit"), submit_teacher_assessment_path(@assessment), method: :patch, class: button_classes %></div><% end %></div>
