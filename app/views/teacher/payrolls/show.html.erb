<%= render "shared/page_header", title: t("payroll.teacher.show.title"), description: @payroll.public_id %><section class="ds-card p-5"><dl class="grid gap-4 sm:grid-cols-3"><div><dt class="ds-caption"><%= t("payroll.fields.period") %></dt><dd dir="ltr"><%= @payroll.period_starts_on %> – <%= @payroll.period_ends_on %></dd></div><div><dt class="ds-caption"><%= t("payroll.fields.net_amount") %></dt><dd><%= @payroll.net_amount %> <%= @payroll.currency %></dd></div><div><dt class="ds-caption"><%= t("payroll.fields.status") %></dt><dd><%= t("payroll.statuses.#{@payroll.status}") %></dd></div></dl></section><section class="mt-6 space-y-2"><h2 class="text-xl font-semibold"><%= t("payroll.sections.lessons") %></h2><% @payroll.items.each do |item| %><article class="ds-card grid gap-2 p-4 sm:grid-cols-3"><span><%= item.scheduled_lesson.title_en %></span><span><%= item.duration_minutes %> min</span><span><%= item.amount %> <%= @payroll.currency %></span></article><% end %></section>
