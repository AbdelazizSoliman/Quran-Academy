<%= render "shared/page_header", title: t("payroll.teacher.index.title"), description: t("payroll.teacher.index.description") %><div class="space-y-3"><% @payrolls.each do |payroll| %><%= link_to teacher_payroll_path(payroll), class: "ds-card grid gap-2 p-4 sm:grid-cols-4" do %><span dir="ltr"><%= payroll.period_starts_on %> – <%= payroll.period_ends_on %></span><span><%= t("payroll.strategies.#{payroll.calculation_strategy}") %></span><span><%= payroll.net_amount %> <%= payroll.currency %></span><span><%= t("payroll.statuses.#{payroll.status}") %></span><% end %><% end %></div>
