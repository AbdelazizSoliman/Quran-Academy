<%= render "shared/page_header", title: t("lesson_reports.teacher.title"), description: @report.public_id %>
<section class="ds-card p-5"><p role="status"><%= t("lesson_reports.statuses.#{@report.status}") %></p><h2 class="mt-3 text-lg font-semibold"><%= t("lesson_reports.fields.lesson_summary") %></h2><p class="mt-2"><%= @report.lesson_summary.presence || t("lesson_reports.empty.summary") %></p><div class="mt-4 flex flex-wrap gap-2"><% if @report.teacher_editable? %><%= render "shared/components/button", label: t("lesson_reports.actions.edit"), href: edit_teacher_schedule_report_path(@lesson), variant: :secondary %><%= button_to t("lesson_reports.actions.submit"), submit_teacher_schedule_report_path(@lesson), method: :patch, class: button_classes %><% end %></div></section>
<section class="mt-6 space-y-4"><h2 class="text-xl font-semibold"><%= t("lesson_reports.sections.students") %></h2><% @entries.each do |entry| %><article class="ds-card p-4"><div class="flex flex-wrap justify-between gap-3"><div><h3 class="font-semibold"><%= entry.student_profile.display_name %></h3><p><%= t("lesson_reports.student_statuses.#{entry.status}") %></p><p class="ds-caption"><%= t("attendance.statuses.#{entry.scheduled_lesson_enrollment.lesson_attendance&.status || 'pending'}") %></p></div><% if @report.teacher_editable? %><%= render "shared/components/button", label: t("lesson_reports.actions.edit"), href: edit_teacher_schedule_report_student_path(@lesson, entry), size: :small, variant: :secondary %><% end %></div><% if entry.completed? %><div class="mt-3"><%= button_to t("communications.actions.student_whatsapp"), teacher_schedule_report_communications_path(@lesson), method: :post, params: { entry_id: entry.id, channel: "whatsapp", template_type: "student_progress" }, class: button_classes(size: :small) %></div><% end %></article><% end %></section>
