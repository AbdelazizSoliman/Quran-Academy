<%= render "shared/page_header", title: t("lesson_reports.teacher.title"), description: @report.public_id %>

<section class="ds-card p-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <p role="status"><%= t("lesson_reports.statuses.#{@report.status}") %></p>
    <% if @report.teacher_editable? %>
      <%= render "shared/components/button", label: t("lesson_reports.actions.edit"), href: edit_teacher_schedule_report_path(@lesson), variant: :secondary %>
    <% end %>
  </div>

  <dl class="mt-5 grid gap-5 sm:grid-cols-2">
    <% {
      lesson_summary: @report.lesson_summary,
      topics_covered: @report.topics_covered,
      general_homework: @report.general_homework,
      next_lesson_plan: @report.next_lesson_plan
    }.each do |field, value| %>
      <div>
        <dt class="ds-label"><%= t("lesson_reports.fields.#{field}") %></dt>
        <dd class="mt-2 whitespace-pre-wrap"><%= value.presence || t("lesson_reports.empty.not_provided") %></dd>
      </div>
    <% end %>
    <div>
      <dt class="ds-label"><%= t("lesson_reports.fields.engagement") %></dt>
      <dd class="mt-2"><%= t("lesson_reports.engagement.#{@report.overall_engagement}") %></dd>
    </div>
    <div>
      <dt class="ds-label"><%= t("lesson_reports.fields.progress") %></dt>
      <dd class="mt-2"><%= t("lesson_reports.performance.#{@report.overall_progress}") %></dd>
    </div>
  </dl>

  <% if @report.teacher_editable? %>
    <div class="mt-5">
      <% if @report.unresolved_entries? %>
        <div role="alert" class="rounded-xl border border-amber-200 bg-amber-50 p-4 text-sm text-amber-900">
          <%= t("lesson_reports.messages.complete_students_before_submit") %>
        </div>
      <% else %>
        <%= button_to t("lesson_reports.actions.submit"), submit_teacher_schedule_report_path(@lesson), method: :patch, class: button_classes %>
      <% end %>
    </div>
  <% end %>
</section>

<section class="mt-6 space-y-4">
  <h2 class="text-xl font-semibold"><%= t("lesson_reports.sections.students") %></h2>
  <% @entries.each do |entry| %>
    <article class="ds-card p-4">
      <div class="flex flex-wrap justify-between gap-3">
        <div>
          <h3 class="font-semibold"><%= entry.student_profile.display_name %></h3>
          <p><%= t("lesson_reports.student_statuses.#{entry.status}") %></p>
          <p class="ds-caption"><%= t("attendance.statuses.#{entry.scheduled_lesson_enrollment.lesson_attendance&.status || 'pending'}") %></p>
        </div>
        <div class="flex flex-wrap gap-2">
          <% if @report.teacher_editable? %>
            <%= render "shared/components/button", label: t("lesson_reports.actions.complete_student_entry"), href: edit_teacher_schedule_report_student_path(@lesson, entry), size: :small, variant: :secondary %>
          <% end %>
          <% if @lesson.completed? %>
            <% if (assessment = @assessments_by_student_id[entry.student_profile.id]) %>
              <% if assessment.editable? %>
                <%= render "shared/components/button", label: t("academic.actions.continue_student_assessment"), href: evaluate_teacher_assessment_path(assessment), size: :small %>
              <% else %>
                <%= render "shared/components/button", label: t("academic.actions.view_assessment"), href: teacher_assessment_path(assessment), size: :small %>
              <% end %>
            <% else %>
              <%= render "shared/components/button", label: t("academic.actions.evaluate_student"), href: new_teacher_assessment_path(enrollment_id: entry.scheduled_lesson_enrollment.enrollment_id, student_profile_id: entry.student_profile.id, scheduled_lesson_id: @lesson.id), size: :small %>
            <% end %>
          <% end %>
        </div>
      </div>

      <% if entry.completed? %>
        <dl class="mt-4 grid gap-4 border-t pt-4 sm:grid-cols-2">
          <% { strengths: entry.strengths, areas_for_improvement: entry.areas_for_improvement,
               homework: entry.homework, next_lesson_target: entry.next_lesson_target }.each do |field, value| %>
            <div>
              <dt class="ds-label"><%= t("lesson_reports.fields.#{field}") %></dt>
              <dd class="mt-1 whitespace-pre-wrap"><%= value.presence || t("lesson_reports.empty.not_provided") %></dd>
            </div>
          <% end %>
        </dl>
      <% end %>
    </article>
  <% end %>
</section>
