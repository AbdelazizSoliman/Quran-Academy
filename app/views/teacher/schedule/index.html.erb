<%= render "shared/page_header", title: t("scheduling.teacher.schedule") %><div class="grid gap-3"><% @lessons.each do |lesson| %><%= link_to teacher_schedule_path(lesson), class: "ds-card p-4" do %><div class="flex justify-between"><strong><%= I18n.locale == :ar ? lesson.title_ar : lesson.title_en %></strong><%= scheduling_status_badge(lesson) %></div><p class="mt-2" dir="ltr"><%= scheduling_time(lesson.starts_at, zone: ActiveSupport::TimeZone[lesson.academy_time_zone]) %></p><% end %><% end %></div>
