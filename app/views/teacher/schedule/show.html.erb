<%= render "shared/page_header", title: I18n.locale == :ar ? @lesson.title_ar : @lesson.title_en, description: @lesson.public_id, badge: scheduling_status_badge(@lesson) %><%= render "shared/components/card", title: t("scheduling.sections.lesson") do %><p dir="ltr"><%= scheduling_time(@lesson.starts_at, zone: ActiveSupport::TimeZone[@lesson.academy_time_zone]) %></p><p class="mt-3"><%= @lesson.course_offering.title_en %></p><div class="mt-4 flex flex-wrap gap-2"><%= render "shared/components/button", label: t("attendance.actions.manage"), href: attendance_teacher_schedule_path(@lesson) %><% if @lesson.status.in?(%w[in_progress completed]) %><%= render "shared/components/button", label: t("lesson_reports.actions.open"), href: teacher_schedule_report_path(@lesson), variant: :secondary %><% end %></div><% end %>
