<%= render "shared/page_header", title: t("attendance.teacher.title"), description: @lesson.public_id %>
<div class="ds-card mb-6 p-5"><p role="status"><%= t("attendance.workflow.#{@lesson.attendance_status}") %> · <%= t("attendance.unresolved", count: @lesson.unresolved_attendance_count) %></p><p class="mt-2 ds-caption"><%= t("attendance.teacher.automatic_hint") %></p><div class="mt-4 flex flex-wrap gap-2"><% if @lesson.in_progress? %><%= button_to t("attendance.actions.complete_and_evaluate"), complete_teacher_schedule_path(@lesson), method: :patch, params: { mark_unresolved_absent: true }, class: button_classes %><% end %></div></div>
<div class="space-y-4"><% @attendances.each do |attendance| %><article class="ds-card p-4"><h2 class="font-semibold"><%= attendance.student_profile.display_name %></h2><p class="mt-1"><%= t("attendance.statuses.#{attendance.status}") %></p></article><% end %></div>
