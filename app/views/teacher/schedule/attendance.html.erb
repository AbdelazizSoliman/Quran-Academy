<%= render "shared/page_header", title: t("attendance.teacher.title"), description: @lesson.public_id %>
<div class="ds-card mb-6 p-5"><p role="status"><%= t("attendance.workflow.#{@lesson.attendance_status}") %> · <%= t("attendance.unresolved", count: @lesson.unresolved_attendance_count) %></p><div class="mt-4 flex flex-wrap gap-2"><% unless @lesson.teacher_checked_in_at? %><%= button_to t("attendance.actions.check_in"), check_in_teacher_schedule_path(@lesson), method: :patch, class: button_classes %><% end %><% if @lesson.scheduled? %><%= button_to t("attendance.actions.start"), start_teacher_schedule_path(@lesson), method: :patch, class: button_classes %><% end %><% if @lesson.in_progress? %><%= button_to t("attendance.actions.complete"), complete_teacher_schedule_path(@lesson), method: :patch, params: { mark_unresolved_absent: true }, class: button_classes(variant: :secondary) %><% end %></div></div>
<div class="space-y-4"><% @attendances.each do |attendance| %><article class="ds-card p-4"><h2 class="font-semibold"><%= attendance.student_profile.display_name %></h2><p class="mt-1"><%= t("attendance.statuses.#{attendance.status}") %></p><% if @lesson.attendance_editable? %><div class="mt-3 flex flex-wrap gap-2"><%= button_to t("attendance.actions.arrival"), record_arrival_teacher_schedule_lesson_attendance_path(@lesson, attendance), method: :patch, class: button_classes(size: :small) %><%= button_to t("attendance.actions.present"), mark_present_teacher_schedule_lesson_attendance_path(@lesson, attendance), method: :patch, class: button_classes(size: :small, variant: :secondary) %><%= button_to t("attendance.actions.absent"), mark_absent_teacher_schedule_lesson_attendance_path(@lesson, attendance), method: :patch, class: button_classes(size: :small, variant: :danger) %></div><% else %><p class="mt-2 text-sm" role="status"><%= t("attendance.messages.locked") %></p><% end %></article><% end %></div>
