<% content_for :title, t("public.home.page_title", academy: @public_site.academy_name) %>
<% content_for :meta_description, @public_site.hero_subtitle if @public_site.hero_subtitle.present? %>

<section class="relative overflow-hidden bg-gradient-to-b from-emerald-50 to-[#fbfcfa]">
  <div class="absolute inset-x-0 top-0 h-1 bg-[var(--public-accent)]" aria-hidden="true"></div>
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-20 sm:px-6 sm:py-28 lg:grid-cols-[1.2fr_0.8fr] lg:px-8 lg:py-32">
    <div>
      <p class="mb-5 text-sm font-bold tracking-wide text-[var(--public-primary)]"><%= t("public.home.eyebrow") %></p>
      <h1 class="max-w-4xl text-4xl font-bold leading-tight tracking-tight text-emerald-950 sm:text-5xl lg:text-6xl"><%= @public_site.hero_title %></h1>
      <% if @public_site.hero_subtitle.present? %>
        <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600"><%= @public_site.hero_subtitle %></p>
      <% end %>
      <div class="mt-8 flex flex-wrap gap-3">
        <%= link_to @public_site.primary_cta_label, @public_site.primary_cta_url,
                    class: "inline-flex rounded-xl bg-[var(--public-primary)] px-6 py-3.5 font-bold text-white shadow-lg shadow-emerald-900/10 hover:opacity-90" %>
        <% if @public_site.whatsapp_cta_enabled? %>
          <%= link_to t("public.home.whatsapp_cta"), @public_site.whatsapp_url,
                      class: "inline-flex rounded-xl border border-emerald-900/20 bg-white px-6 py-3.5 font-bold text-emerald-950 hover:bg-emerald-50", rel: "noopener" %>
        <% end %>
      </div>
    </div>
    <div class="rounded-[2rem] border border-emerald-900/10 bg-white p-6 shadow-xl shadow-emerald-950/5 sm:p-8" id="trust-values">
      <div class="grid gap-4">
        <% t("public.home.values").each do |value| %>
          <div class="flex gap-4 rounded-2xl bg-emerald-50/70 p-4">
            <span class="mt-1 size-2.5 shrink-0 rounded-full bg-[var(--public-accent)]"></span>
            <p class="font-semibold leading-7 text-emerald-950"><%= value %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>

<section class="py-16 sm:py-24" id="about">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
    <div>
      <p class="text-sm font-bold text-[var(--public-primary)]"><%= t("public.home.about.eyebrow") %></p>
      <h2 class="mt-3 text-3xl font-bold tracking-tight text-emerald-950"><%= t("public.home.about.title") %></h2>
    </div>
    <p class="text-lg leading-8 text-slate-600"><%= @public_site.about_text.presence || t("public.home.about.fallback") %></p>
  </div>
</section>

<% if public_programs_available? && @featured_programs.any? %>
  <section class="bg-white px-4 py-16 sm:px-6 sm:py-24 lg:px-8" id="programs">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-sm font-bold text-[var(--public-primary)]"><%= t("public.home.programs.eyebrow") %></p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-emerald-950"><%= t("public.home.programs.title") %></h2>
        </div>
        <%= link_to t("public.home.programs.all"), public_programs_path(locale: public_locale),
                    class: "text-sm font-bold text-[var(--public-primary)] hover:underline" %>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% @featured_programs.each do |program| %>
          <%= render "public/programs/card", program: program %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<section class="bg-emerald-950 py-16 text-white sm:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="max-w-2xl">
      <p class="text-sm font-bold text-amber-300"><%= t("public.home.how_it_works.eyebrow") %></p>
      <h2 class="mt-3 text-3xl font-bold"><%= t("public.home.how_it_works.title") %></h2>
    </div>
    <ol class="mt-10 grid gap-5 md:grid-cols-3">
      <% t("public.home.how_it_works.steps").each_with_index do |step, index| %>
        <li class="rounded-2xl border border-white/10 bg-white/5 p-6">
          <span class="text-sm font-bold text-amber-300"><%= format("%02d", index + 1) %></span>
          <h3 class="mt-4 text-xl font-bold"><%= step[:title] %></h3>
          <p class="mt-2 leading-7 text-emerald-100/75"><%= step[:description] %></p>
        </li>
      <% end %>
    </ol>
  </div>
</section>

<% if @featured_fee_plans.any? %>
  <section class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8" id="fees">
    <div class="mx-auto max-w-7xl">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div class="max-w-2xl">
          <p class="text-sm font-bold text-[var(--public-primary)]"><%= t("public.home.fees.eyebrow") %></p>
          <h2 class="mt-3 text-3xl font-bold tracking-tight text-emerald-950"><%= t("public.home.fees.title") %></h2>
        </div>
        <%= link_to t("public.home.fees.all"), public_fees_path(locale: public_locale),
                    class: "text-sm font-bold text-[var(--public-primary)] hover:underline" %>
      </div>
      <div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% @featured_fee_plans.each do |fee_plan| %>
          <%= render "public/fees/plan", fee_plan: fee_plan %>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if @testimonials.any? %>
  <section class="bg-emerald-950 px-4 py-16 text-white sm:px-6 sm:py-24 lg:px-8" id="testimonials">
    <div class="mx-auto max-w-7xl">
      <p class="text-sm font-bold text-amber-300"><%= t("public.home.testimonials.eyebrow") %></p>
      <h2 class="mt-3 text-3xl font-bold"><%= t("public.home.testimonials.title") %></h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <% @testimonials.each do |testimonial| %>
          <figure class="rounded-2xl border border-white/10 bg-white/5 p-6">
            <blockquote class="whitespace-pre-line text-lg leading-8 text-emerald-50">“<%= testimonial.quote %>”</blockquote>
            <figcaption class="mt-5 border-t border-white/10 pt-4"><span class="font-bold"><%= testimonial.author_label %></span><% if testimonial.relationship != testimonial.author_label %><span class="block text-sm text-emerald-100/70"><%= testimonial.relationship %></span><% end %></figcaption>
          </figure>
        <% end %>
      </div>
    </div>
  </section>
<% end %>

<% if @faqs.any? %>
  <section class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8" id="faq">
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-wrap items-end justify-between gap-4"><div><p class="text-sm font-bold text-[var(--public-primary)]"><%= t("public.home.faq.eyebrow") %></p><h2 class="mt-3 text-3xl font-bold text-emerald-950"><%= t("public.home.faq.title") %></h2></div><%= link_to t("public.home.faq.all"), public_faqs_path(locale: public_locale), class: "text-sm font-bold text-[var(--public-primary)] hover:underline" %></div>
      <div class="mt-8 space-y-4"><%= render partial: "public/faqs/faq", collection: @faqs %></div>
    </div>
  </section>
<% end %>

<section class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-5xl rounded-[2rem] bg-emerald-50 px-6 py-12 text-center sm:px-12">
    <h2 class="text-3xl font-bold text-emerald-950"><%= t("public.home.final_cta.title") %></h2>
    <p class="mx-auto mt-4 max-w-2xl leading-7 text-slate-600"><%= t("public.home.final_cta.description") %></p>
    <%= link_to @public_site.primary_cta_label, @public_site.primary_cta_url,
                class: "mt-7 inline-flex rounded-xl bg-[var(--public-primary)] px-6 py-3.5 font-bold text-white hover:opacity-90" %>
  </div>
</section>
