<% content_for :title, t("public.faq.page_title", academy: @public_site.academy_name) %>
<% content_for :meta_description, t("public.faq.description") %>
<section class="px-4 py-16 sm:px-6 sm:py-24 lg:px-8"><div class="mx-auto max-w-4xl">
  <p class="text-sm font-bold text-[var(--public-primary)]"><%= t("public.faq.eyebrow") %></p>
  <h1 class="mt-3 text-4xl font-bold text-emerald-950"><%= t("public.faq.title") %></h1>
  <p class="mt-4 text-lg leading-8 text-slate-600"><%= t("public.faq.description") %></p>
  <div class="mt-10 space-y-4"><%= render partial: "public/faqs/faq", collection: @faqs %></div>
</div></section>
