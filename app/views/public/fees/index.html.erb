<% content_for :title, t("public.fees.index.page_title", academy: @public_site.academy_name) %>

<section class="bg-gradient-to-b from-emerald-50 to-[#fbfcfa] px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <p class="text-sm font-bold tracking-wide text-[var(--public-primary)]"><%= t("public.fees.index.eyebrow") %></p>
    <h1 class="mt-3 max-w-3xl text-4xl font-bold leading-tight tracking-tight text-emerald-950 sm:text-5xl"><%= t("public.fees.index.title") %></h1>
    <p class="mt-5 max-w-2xl text-lg leading-8 text-slate-600"><%= t("public.fees.index.description") %></p>
  </div>
</section>

<section class="px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto max-w-7xl">
    <% if @fee_plans.any? %>
      <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        <% @fee_plans.each do |fee_plan| %>
          <%= render "public/fees/plan", fee_plan: fee_plan %>
        <% end %>
      </div>
    <% else %>
      <div class="mx-auto max-w-xl rounded-2xl border border-dashed border-emerald-900/20 bg-white px-6 py-12 text-center">
        <h2 class="text-xl font-bold text-emerald-950"><%= t("public.fees.empty.title") %></h2>
        <p class="mt-3 leading-7 text-slate-600"><%= t("public.fees.empty.description") %></p>
      </div>
    <% end %>
  </div>
</section>
