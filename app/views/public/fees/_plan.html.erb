<article class="flex h-full flex-col rounded-2xl border border-emerald-900/10 bg-white p-6 shadow-sm">
  <h3 class="text-xl font-bold text-emerald-950"><%= fee_plan.name %></h3>
  <p class="mt-4 text-3xl font-bold text-[var(--public-primary)]">
    <%= number_to_currency(fee_plan.amount, unit: fee_plan.currency_symbol, format: "%n %u", precision: 0) %>
  </p>
  <p class="mt-1 text-sm font-semibold text-slate-500"><%= fee_plan.billing_cycle_label %></p>
  <% if fee_plan.price_note.present? %>
    <p class="mt-2 text-sm leading-6 text-slate-500"><%= fee_plan.price_note %></p>
  <% end %>
  <% if fee_plan.description.present? %>
    <p class="mt-4 leading-7 text-slate-600"><%= fee_plan.description %></p>
  <% end %>
  <% if fee_plan.features.any? %>
    <h4 class="mt-6 text-sm font-bold text-emerald-950"><%= t("public.fees.features") %></h4>
    <ul class="mt-3 grid gap-2 text-sm leading-6 text-slate-600">
      <% fee_plan.features.each do |feature| %>
        <li class="flex gap-3">
          <span class="mt-2 size-1.5 shrink-0 rounded-full bg-[var(--public-accent)]" aria-hidden="true"></span>
          <span><%= feature %></span>
        </li>
      <% end %>
    </ul>
  <% end %>
  <div class="mt-6 flex-1"></div>
  <%= link_to fee_plan.cta_label, @public_site.primary_cta_url,
              class: "inline-flex w-fit rounded-xl bg-[var(--public-primary)] px-5 py-3 text-sm font-bold text-white hover:opacity-90" %>
</article>
