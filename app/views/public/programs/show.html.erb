<% content_for :title, t("public.programs.detail.page_title", academy: @public_site.academy_name, program: @program.name) %>
<% content_for :meta_description, @program.short_description if @program.short_description.present? %>

<section class="bg-gradient-to-b from-emerald-50 to-[#fbfcfa] px-4 py-16 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto max-w-4xl">
    <%= link_to t("public.navigation.programs"), public_programs_path(locale: public_locale),
                class: "text-sm font-semibold text-[var(--public-primary)] hover:underline" %>
    <p class="mt-6 text-sm font-bold tracking-wide text-[var(--public-primary)]"><%= @program.category_label %></p>
    <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight text-emerald-950 sm:text-5xl"><%= @program.name %></h1>
    <% if @program.short_description.present? %>
      <p class="mt-5 text-lg leading-8 text-slate-600"><%= @program.short_description %></p>
    <% end %>
    <div class="mt-8 flex flex-wrap gap-3">
      <%= link_to @public_site.primary_cta_label, @public_site.primary_cta_url,
                  class: "inline-flex rounded-xl bg-[var(--public-primary)] px-6 py-3.5 font-bold text-white shadow-lg shadow-emerald-900/10 hover:opacity-90" %>
      <%= link_to t("public.navigation.fees"), public_fees_path(locale: public_locale),
                  class: "inline-flex rounded-xl border border-emerald-900/20 bg-white px-6 py-3.5 font-bold text-emerald-950 hover:bg-emerald-50" %>
    </div>
  </div>
</section>

<section class="px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto grid max-w-4xl gap-10 lg:grid-cols-[1.15fr_0.85fr]">
    <% if @program.description.present? %>
      <div>
        <h2 class="text-2xl font-bold text-emerald-950"><%= t("public.programs.detail.overview") %></h2>
        <p class="mt-4 whitespace-pre-line leading-8 text-slate-600"><%= @program.description %></p>
      </div>
    <% end %>

    <div class="rounded-2xl border border-emerald-900/10 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-bold text-emerald-950"><%= t("public.programs.detail.summary") %></h2>
      <dl class="mt-4 grid gap-4 text-sm">
        <% [
             [t("public.programs.fields.lesson_duration"), t("public.programs.values.lesson_duration", count: @program.lesson_duration_minutes)],
             [t("public.programs.fields.lessons_per_week"), t("public.programs.values.lessons_per_week", count: @program.lessons_per_week)],
             [t("public.programs.fields.entry_level"), @program.entry_level_label],
             [t("public.programs.fields.completion_level"), @program.completion_level_label],
             [t("public.programs.fields.age_groups"), @program.age_group_labels.to_sentence],
             [t("public.programs.fields.languages"), @program.language_labels.to_sentence],
             (@program.estimated_duration_weeks.present? ? [t("public.programs.fields.estimated_duration"), t("public.programs.values.estimated_duration", count: @program.estimated_duration_weeks)] : nil),
             [t("public.programs.fields.placement"), @program.placement_required? ? t("public.programs.values.placement_required") : t("public.programs.values.placement_not_required")]
           ].compact.each do |label, value| %>
          <div>
            <dt class="font-semibold text-emerald-950"><%= label %></dt>
            <dd class="mt-1 leading-6 text-slate-600"><%= value %></dd>
          </div>
        <% end %>
      </dl>
    </div>
  </div>
</section>
