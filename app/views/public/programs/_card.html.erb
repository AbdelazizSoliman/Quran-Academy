<article class="flex h-full flex-col rounded-2xl border border-emerald-900/10 bg-white p-6 shadow-sm">
  <p class="text-xs font-bold tracking-wide text-[var(--public-primary)]"><%= program.category_label %></p>
  <h3 class="mt-2 text-xl font-bold leading-8 text-emerald-950"><%= program.name %></h3>
  <% if program.short_description.present? %>
    <p class="mt-3 leading-7 text-slate-600"><%= program.short_description %></p>
  <% end %>
  <dl class="mt-5 grid gap-1.5 text-sm text-slate-600">
    <div class="flex flex-wrap gap-x-2">
      <dt class="font-semibold text-emerald-950"><%= t("public.programs.fields.lesson_duration") %>:</dt>
      <dd><%= t("public.programs.values.lesson_duration", count: program.lesson_duration_minutes) %></dd>
    </div>
    <div class="flex flex-wrap gap-x-2">
      <dt class="font-semibold text-emerald-950"><%= t("public.programs.fields.lessons_per_week") %>:</dt>
      <dd><%= t("public.programs.values.lessons_per_week", count: program.lessons_per_week) %></dd>
    </div>
    <div class="flex flex-wrap gap-x-2">
      <dt class="font-semibold text-emerald-950"><%= t("public.programs.fields.entry_level") %>:</dt>
      <dd><%= program.entry_level_label %></dd>
    </div>
  </dl>
  <div class="mt-6 flex-1"></div>
  <%= link_to t("public.programs.view"), public_program_path(locale: public_locale, slug: program.slug),
              class: "inline-flex w-fit rounded-xl border border-emerald-900/20 px-4 py-2.5 text-sm font-bold text-emerald-950 hover:bg-emerald-50" %>
</article>
