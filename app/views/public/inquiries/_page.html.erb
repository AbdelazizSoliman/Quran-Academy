<section class="bg-gradient-to-b from-emerald-50 to-[#fbfcfa] px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
  <div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[0.8fr_1.2fr]">
    <div>
      <p class="text-sm font-bold tracking-wide text-[var(--public-primary)]"><%= t("public.#{type}.eyebrow") %></p>
      <h1 class="mt-3 text-4xl font-bold leading-tight tracking-tight text-emerald-950"><%= t("public.#{type}.title") %></h1>
      <p class="mt-5 leading-7 text-slate-600"><%= t("public.#{type}.description") %></p>
      <% if @public_site.whatsapp_cta_enabled? %>
        <%= link_to t("public.home.whatsapp_cta"), @public_site.whatsapp_url,
                    class: "mt-6 inline-flex rounded-xl border border-emerald-900/20 bg-white px-5 py-3 font-bold text-emerald-950 hover:bg-emerald-50",
                    rel: "noopener" %>
      <% end %>
    </div>
    <div class="rounded-2xl border border-emerald-900/10 bg-white p-6 shadow-sm sm:p-8">
      <%= render "public/inquiries/form", inquiry:, url: %>
    </div>
  </div>
</section>
