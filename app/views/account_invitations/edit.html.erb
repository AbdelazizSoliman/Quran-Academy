<% content_for :title, t("invitations.accept.title") %>
<h1 class="text-2xl font-bold"><%= t("invitations.accept.title") %></h1>
<% if @invitation.expired? %>
  <%= render "shared/components/alert", variant: :warning, title: t("invitations.expired.title"),
             message: t("invitations.expired.message") %>
<% elsif @invitation.cancelled? || @invitation.accepted? %>
  <%= render "shared/components/alert", variant: :error, title: t("invitations.invalid.title"),
             message: t("invitations.invalid.message") %>
<% else %>
  <p class="mt-2 ds-supporting"><%= t("invitations.accept.description", academy: AcademySetting.current.academy_name) %></p>
  <p class="mt-3 ds-caption"><%= t("invitations.accept.expires", time: l(@invitation.expires_at, format: :long)) %></p>
  <% if @invitation.errors.any? %>
    <div class="mt-4"><%= render "shared/components/alert", variant: :error,
                                  title: t("invitations.accept.errors_title"),
                                  message: @invitation.errors.full_messages.to_sentence %></div>
  <% end %>
  <%= form_with url: account_invitation_path(token: params[:token], locale: I18n.locale), method: :patch,
                scope: :account_invitation, class: "mt-6 space-y-5" do |form| %>
    <div>
      <%= form.label :password, t("invitations.accept.password"), class: "ds-label" %>
      <%= form.password_field :password, required: true, minlength: 6, autocomplete: "new-password",
                                         class: "ds-control mt-2" %>
    </div>
    <div>
      <%= form.label :password_confirmation, t("invitations.accept.password_confirmation"), class: "ds-label" %>
      <%= form.password_field :password_confirmation, required: true, minlength: 6,
                                                      autocomplete: "new-password", class: "ds-control mt-2" %>
    </div>
    <%= render "shared/components/button", label: t("invitations.accept.action"), type: "submit",
               classes: "w-full justify-center" %>
  <% end %>
<% end %>
