<%= render "shared/page_header", title: t("student_enrollments.index.title"), description: t("student_enrollments.index.description") %>
<div class="grid gap-4 md:grid-cols-2"><% @enrollments.each do |enrollment| %><%= link_to student_enrollment_path(enrollment), class: "ds-card p-5" do %><div class="flex justify-between gap-3"><h2 class="ds-card-title"><%= localized_program_name(enrollment.course_offering.program) %></h2><%= enrollment_status_badge(enrollment) %></div><p class="mt-2 ds-supporting"><%= localized_offering_title(enrollment.course_offering) %></p><p class="mt-3 ds-caption"><%= enrollment.public_id %></p><% end %><% end %></div>
<% if @enrollments.empty? %><%= render "shared/components/empty_state", icon: :reports, title: t("student_enrollments.empty.title"), description: t("student_enrollments.empty.description") %><% end %>
