<%= render "shared/page_header", title: localized_program_name(@enrollment.course_offering.program), description: @enrollment.public_id, badge: enrollment_status_badge(@enrollment) %>
<%= render "shared/components/card", title: localized_offering_title(@enrollment.course_offering) do %>
  <dl class="grid gap-4 sm:grid-cols-2"><div><dt class="ds-caption"><%= t("enrollments.fields.learning_language") %></dt><dd><%= t("academy.languages.#{@enrollment.course_offering.learning_language}") %></dd></div><div><dt class="ds-caption"><%= t("enrollments.fields.placement_status") %></dt><dd><%= academic_badge(:placement_statuses, @enrollment.placement_status) %></dd></div><div><dt class="ds-caption"><%= t("course_offerings.fields.planned_start_on") %></dt><dd><%= @enrollment.course_offering.planned_start_on || t("academic.not_configured") %></dd></div><div><dt class="ds-caption"><%= t("course_offerings.fields.planned_end_on") %></dt><dd><%= @enrollment.course_offering.planned_end_on || t("academic.not_configured") %></dd></div></dl>
<% end %>
