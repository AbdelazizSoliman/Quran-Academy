<%= render "shared/page_header", title: t("academic.transcript.title"), description: current_user.full_name %><div class="grid gap-6"><div class="ds-card p-5"><h2 class="font-bold"><%= t("academic.transcript.programs") %></h2><ul class="mt-3 space-y-2"><% @enrollments.each do |enrollment| %><li><%= enrollment.course_offering.program.name_en %> · <%= enrollment.public_id %></li><% end %></ul></div><%= render "shared/academic/assessment_list", assessments: @assessments, path: ->(assessment) { student_assessment_path(assessment) } %><div class="ds-card p-5"><h2 class="font-bold"><%= t("academic.certificates.student") %></h2><p class="mt-2"><%= @certificates.count %></p></div></div>
