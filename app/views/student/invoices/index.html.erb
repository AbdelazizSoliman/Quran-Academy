<%= render "shared/page_header", title: t("finance.invoices.title") %>
<div class="space-y-3"><% @invoices.each do |invoice| %><%= link_to student_invoice_path(invoice), class: "ds-card grid gap-2 p-4 sm:grid-cols-4" do %><strong dir="ltr"><%= invoice.public_id %></strong><span><%= l(invoice.due_on) %></span><span><%= t("finance.invoice_statuses.#{invoice.effective_status}") %></span><span dir="ltr"><%= number_to_currency(invoice.balance_due, unit: invoice.currency) %></span><% end %><% end %></div>
