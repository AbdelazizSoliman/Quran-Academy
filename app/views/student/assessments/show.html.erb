<%= render "shared/page_header", title: @assessment.assessment_template.localized_name, description: l(@assessment.assessment_date) %><div class="ds-card p-5"><p class="text-2xl font-bold"><%= @assessment.overall_score || t("academic.not_available") %><%= "%" if @assessment.overall_score %> · <%= @assessment.letter_grade || t("academic.not_available") %></p><div class="mt-5 grid gap-3"><% @assessment.scores.each do |score| %><% result = score.numeric_score || (t("academic.ratings.#{score.rating}") if score.rating.present?) %><p><strong><%= score.assessment_rubric_item.localized_name %>:</strong> <%= result || t("academic.not_available") %></p><% end %></div><% if @assessment.notes.present? %><p class="mt-5"><%= @assessment.notes %></p><% end %></div>
