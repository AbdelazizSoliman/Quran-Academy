<%= render "shared/page_header", title: t("academic.progress.title") %><% if @progress %><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><% { average_score: @progress.average_score, highest_score: @progress.highest_score, lowest_score: @progress.lowest_score, trend: t("academic.trends.#{@progress.trend}") }.each do |key, value| %><div class="ds-card p-5"><p class="ds-caption"><%= t("academic.fields.#{key}") %></p><p class="text-xl font-bold"><%= value || t("academic.not_available") %></p></div><% end %></div><% else %><%= render "shared/components/empty_state", icon: :reports, title: t("academic.empty"), description: "" %><% end %>
