<%= render "shared/page_header", title: (I18n.locale == :ar ? @attendance.scheduled_lesson.title_ar : @attendance.scheduled_lesson.title_en), description: @attendance.public_id %>
<%= render "shared/components/card", title: t("attendance.student.outcome") do %><dl class="grid gap-3"><div><dt class="ds-caption"><%= t("attendance.fields.status") %></dt><dd><%= t("attendance.statuses.#{@attendance.status}") %></dd></div><% if @attendance.arrival_at %><div><dt class="ds-caption"><%= t("attendance.fields.arrival") %></dt><dd dir="ltr"><%= l(@attendance.arrival_at.in_time_zone(current_user.time_zone), format: :short) %></dd></div><div><dt class="ds-caption"><%= t("attendance.fields.minutes_late") %></dt><dd><%= @attendance.minutes_late %></dd></div><% end %><div><dt class="ds-caption"><%= t("attendance.fields.teacher") %></dt><dd><%= @attendance.scheduled_lesson.teacher_profile.display_name %></dd></div></dl><% end %>
