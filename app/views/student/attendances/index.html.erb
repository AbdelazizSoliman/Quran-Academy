<%= render "shared/page_header", title: t("attendance.student.index_title"), description: t("attendance.student.description") %>
<div class="space-y-4"><% @attendances.each do |attendance| %><%= link_to student_attendance_path(attendance), class: "ds-card block p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" do %><h2 class="font-semibold"><%= I18n.locale == :ar ? attendance.scheduled_lesson.title_ar : attendance.scheduled_lesson.title_en %></h2><p class="mt-1"><%= attendance.scheduled_lesson.teacher_profile.display_name %></p><p class="mt-1" dir="ltr"><%= l(attendance.scheduled_lesson.starts_at.in_time_zone(current_user.time_zone), format: :short) %></p><p class="mt-2"><%= t("attendance.statuses.#{attendance.status}") %></p><% end %><% end %></div>
