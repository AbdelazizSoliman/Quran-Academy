<%= render "shared/page_header", title: t("scheduling.student.schedule") %><div class="grid gap-3"><% @lessons.each do |lesson| %><%= link_to student_schedule_path(lesson), class: "ds-card p-4" do %><div class="flex justify-between"><strong><%= I18n.locale == :ar ? lesson.title_ar : lesson.title_en %></strong><%= scheduling_status_badge(lesson) %></div><p class="mt-2" dir="ltr"><%= scheduling_time(lesson.starts_at, zone: ActiveSupport::TimeZone[current_user.time_zone]) %></p><% end %><% end %><% if @lessons.empty? %><%= render "shared/components/empty_state", icon: :calendar, title: t("scheduling.empty.lessons_title"), description: t("scheduling.empty.lessons_description") %><% end %></div>
