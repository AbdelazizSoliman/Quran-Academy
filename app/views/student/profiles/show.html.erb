<% action = render("shared/components/button", label: t("actions.edit"), href: edit_student_profile_path) %>
<%= render "shared/page_header", title: @profile.display_name, description: @profile.public_id, badge: student_profile_status_badge(@profile), primary_action: action %>
<div class="grid gap-6 lg:grid-cols-2"><% safe = capture do %><dl class="grid gap-4 sm:grid-cols-2"><% %i[student_type phone_number whatsapp_number country_of_residence city preferred_learning_language current_quran_level reading_level tajweed_level memorization_level memorized_juz_count learning_goals learning_status].each do |f| %><div><dt class="ds-caption"><%= t("student_profiles.fields.#{f}") %></dt><dd class="mt-1 whitespace-pre-line"><%= student_value(@profile.public_send(f)) %></dd></div><% end %></dl><% end %><%= render "shared/components/card", title: t("student_profiles.sections.profile"), body: safe %>
<% completion = capture do %><p class="text-3xl font-bold"><%= @profile.completion_percentage %>%</p><% if @profile.missing_required_fields.any? %><p class="mt-2 ds-caption"><%= t("student_profiles.completeness.missing", fields: @profile.missing_required_fields.map { |f| t("student_profiles.fields.#{f}") }.to_sentence) %></p><% end %><% end %><%= render "shared/components/card", title: t("student_profiles.sections.completeness"), body: completion %></div>
<% if @profile.minor? && @profile.active_guardianships.any? %><div class="mt-6"><% guardian_summary = capture do %><ul class="space-y-2"><% @profile.active_guardianships.each do |link| %><li><span class="font-semibold"><%= link.guardian.full_name %></span> · <%= guardianship_label(link) %> <% if link.primary_contact? %><%= t("guardianships.primary") %><% end %></li><% end %></ul><% end %><%= render "shared/components/card", title: t("student_profiles.sections.guardians"), body: guardian_summary %></div><% end %>
