<%= render "shared/page_header", title: t("lesson_reports.student.index_title"), description: t("lesson_reports.student.description") %><div class="space-y-4"><% @entries.each do |entry| %><%= link_to student_report_path(entry), class: "ds-card block p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" do %><h2 class="font-semibold"><%= I18n.locale == :ar ? entry.scheduled_lesson.title_ar : entry.scheduled_lesson.title_en %></h2><p class="mt-1"><%= entry.scheduled_lesson.teacher_profile.display_name %></p><p class="mt-1" dir="ltr"><%= l(entry.scheduled_lesson.starts_at.in_time_zone(current_user.time_zone), format: :short) %></p><% end %><% end %></div>
