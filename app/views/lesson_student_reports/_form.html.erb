<%= form_with model: entry, url:, class: "space-y-5" do |form| %>
  <fieldset class="space-y-4"><legend class="text-lg font-semibold"><%= t("lesson_reports.sections.reading") %></legend><div><%= form.label :reading_material, t("lesson_reports.fields.material"), class: "ds-label" %><%= form.text_field :reading_material, class: "ds-control mt-2" %></div><%= form.select :reading_quality, LessonStudentReport::READING_QUALITIES.map { |value| [t("lesson_reports.reading_quality.#{value}"), value] }, {}, class: "ds-control" %><%= form.text_area :reading_notes, rows: 2, class: "ds-control" %></fieldset>
  <fieldset class="space-y-4"><legend class="text-lg font-semibold"><%= t("lesson_reports.sections.memorization") %></legend><%= form.text_field :memorization_material, class: "ds-control" %><%= form.select :memorization_result, LessonStudentReport::MEMORIZATION_RESULTS.map { |value| [t("lesson_reports.memorization.#{value}"), value] }, {}, class: "ds-control" %></fieldset>
  <fieldset class="space-y-4"><legend class="text-lg font-semibold"><%= t("lesson_reports.sections.revision") %></legend><%= form.text_field :revision_material, class: "ds-control" %><%= form.select :revision_result, LessonStudentReport::REVISION_RESULTS.map { |value| [t("lesson_reports.revision.#{value}"), value] }, {}, class: "ds-control" %></fieldset>
  <fieldset><legend class="text-lg font-semibold"><%= t("lesson_reports.sections.tajweed") %></legend><div class="mt-3 grid gap-2 sm:grid-cols-2"><%= form.collection_check_boxes :tajweed_topics, LessonStudentReport::TAJWEED_TOPICS, :to_s, ->(value) { t("lesson_reports.tajweed.#{value}") } do |box| %><label class="flex min-h-11 items-center gap-2"><%= box.check_box %><%= box.text %></label><% end %></div><%= form.text_area :tajweed_observations, rows: 2, class: "ds-control mt-3" %></fieldset>
  <% %i[strengths areas_for_improvement homework next_lesson_target student_visible_notes guardian_visible_notes private_teacher_notes].each do |field| %><div><%= form.label field, t("lesson_reports.fields.#{field}"), class: "ds-label" %><%= form.text_area field, rows: 2, class: "ds-control mt-2" %></div><% end %>
  <% statuses = current_user.admin? ? LessonStudentReport::STATUSES : %w[pending completed not_applicable] %>
  <div><%= form.label :status, t("lesson_reports.fields.status"), class: "ds-label" %><%= form.select :status, statuses.map { |value| [t("lesson_reports.student_statuses.#{value}"), value] }, {}, class: "ds-control mt-2" %></div>
  <%= render "shared/components/button", label: t("lesson_reports.actions.save"), type: :submit %>
<% end %>
