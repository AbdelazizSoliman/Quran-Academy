<aside id="application-sidebar"
       data-sidebar-target="panel"
       class="fixed inset-y-0 start-0 z-40 flex w-72 <%= I18n.locale == :ar ? "translate-x-full" : "-translate-x-full" %> flex-col border-e border-slate-200 bg-white shadow-xl transition-transform duration-200 ease-out lg:translate-x-0 lg:shadow-none"
       aria-label="التنقل الرئيسي">
  <div class="flex h-20 items-center justify-between border-b border-slate-100 px-5">
    <%= link_to root_path, class: "flex items-center gap-3 rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-500" do %>
      <span class="grid size-10 place-items-center rounded-xl bg-emerald-700 text-lg font-bold text-white shadow-sm">ق</span>
      <span>
        <span class="block text-base font-bold text-slate-900"><%= t("app.name") %></span>
        <span class="block text-xs text-slate-500">إدارة الأكاديمية</span>
      </span>
    <% end %>
    <button type="button"
            data-action="sidebar#close"
            class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 focus-visible:outline focus-visible:outline-2 focus-visible:outline-emerald-500 lg:hidden"
            aria-label="إغلاق القائمة">
      <span aria-hidden="true" class="text-2xl">×</span>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-4 py-6">
    <p class="mb-3 px-3 text-xs font-semibold text-slate-400">القائمة الرئيسية</p>
    <ul class="space-y-1">
      <% [
        [t("navigation.dashboard"), "⌂", root_path, true],
        [t("navigation.students"), "♙", "#", false],
        [t("navigation.teachers"), "♜", "#", false],
        [t("navigation.schedule"), "▦", "#", false],
        [t("navigation.attendance"), "✓", "#", false],
        [t("navigation.whatsapp"), "◉", "#", false],
        [t("navigation.payroll"), "◫", "#", false],
        [t("navigation.reports"), "▥", "#", false],
        [t("navigation.settings"), "⚙", "#", false]
      ].each do |label, icon, path, active| %>
        <li>
          <%= link_to path, class: nav_item_classes(active: active), aria: (active ? { current: "page" } : {}) do %>
            <span class="grid size-8 place-items-center rounded-lg bg-slate-100 text-base text-slate-600 group-hover:bg-white" aria-hidden="true"><%= icon %></span>
            <span><%= label %></span>
            <% unless active %>
              <span class="ms-auto text-[10px] font-normal text-slate-400"><%= t("navigation.coming_soon") %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="border-t border-slate-100 p-4">
    <div class="rounded-xl bg-emerald-50 p-3">
      <p class="text-xs font-semibold text-emerald-800"><%= t("app.academy_placeholder") %></p>
      <p class="mt-1 text-xs text-emerald-700">العام الدراسي الحالي</p>
    </div>
  </div>
</aside>
