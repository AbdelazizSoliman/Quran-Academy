<aside id="application-sidebar"
       data-sidebar-target="panel"
       class="fixed inset-y-0 start-0 z-40 flex w-72 <%= I18n.locale == :ar ? "translate-x-full" : "-translate-x-full" %> flex-col border-e border-app-border bg-app-surface shadow-xl transition-transform duration-200 ease-out lg:translate-x-0 lg:shadow-none"
       aria-label="<%= t("navigation.main") %>">
  <div class="flex h-20 items-center justify-between border-b border-app-border px-5">
    <%= link_to root_path, class: "flex items-center gap-3 rounded-lg" do %>
      <span class="grid size-10 place-items-center rounded-xl bg-app-primary text-lg font-bold text-white shadow-sm"><%= I18n.locale == :ar ? "ق" : "Q" %></span>
      <span>
        <span class="block text-base font-bold text-app-text"><%= t("app.name") %></span>
        <span class="block ds-caption"><%= t("app.management") %></span>
      </span>
    <% end %>
    <button type="button"
            data-action="sidebar#close"
            class="rounded-lg p-2 text-app-subtle hover:bg-app-muted lg:hidden"
            aria-label="<%= t("accessibility.close_menu") %>">
      <%= icon :close %>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-4 py-6">
    <p class="mb-3 px-3 text-xs font-semibold text-app-subtle"><%= t("navigation.main") %></p>
    <ul class="space-y-1">
      <% navigation_items_for(current_user).each do |key, item| %>
        <% active = key == :dashboard %>
        <% path = active ? root_path : "#" %>
        <li>
          <%= link_to path, class: nav_item_classes(active: active), aria: (active ? { current: "page" } : {}) do %>
            <span class="grid size-8 place-items-center rounded-lg bg-app-muted text-app-secondary group-hover:bg-white"><%= icon item[:icon], size: 4 %></span>
            <span><%= t("navigation.#{key}") %></span>
            <% unless active %>
              <span class="ms-auto text-[10px] font-normal text-app-subtle"><%= t("navigation.coming_soon") %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="border-t border-app-border p-4">
    <div class="rounded-xl bg-app-primary-soft p-3">
      <p class="text-xs font-semibold text-app-primary"><%= t("app.academy_placeholder") %></p>
      <p class="mt-1 text-xs text-app-primary"><%= t("app.academic_year") %></p>
    </div>
  </div>
</aside>
