<aside id="application-sidebar"
       data-sidebar-target="panel"
       class="fixed inset-y-0 start-0 z-40 flex w-72 flex-col border-e border-emerald-950/60 text-white shadow-xl lg:shadow-none"
       style="background-color: color-mix(in srgb, var(--color-primary) 66%, black)"
       hidden
       aria-label="<%= t("navigation.main") %>">
  <div class="flex h-20 items-center justify-between border-b border-white/10 px-5">
    <%= link_to root_path, class: "flex items-center gap-3 rounded-lg" do %>
      <% if academy_setting&.logo_url.present? %>
        <%= image_tag academy_setting.logo_url, alt: academy_brand_name,
                                                class: "size-10 rounded-xl bg-white object-contain p-1 shadow-sm" %>
      <% else %>
        <span class="grid size-10 place-items-center rounded-xl bg-app-primary text-lg font-bold text-white shadow-sm"><%= academy_brand_name.first.upcase %></span>
      <% end %>
      <span>
        <span class="block text-base font-bold text-white"><%= academy_brand_name %></span>
        <span class="block text-xs text-emerald-100/65"><%= t("app.management") %></span>
      </span>
    <% end %>
    <button type="button"
            data-action="sidebar#close"
            class="rounded-lg p-2 text-emerald-100 hover:bg-white/10 lg:hidden"
            aria-label="<%= t("accessibility.close_menu") %>">
      <%= icon :close %>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto px-4 py-6">
    <p class="mb-3 px-3 text-xs font-semibold text-emerald-100/55"><%= t("navigation.main") %></p>
    <ul class="space-y-1">
      <% navigation_items_for(current_user).each do |key, item| %>
        <% active = (key == :dashboard && current_page?(root_path)) ||
                    (key == :users && controller_path.start_with?("admin/users")) ||
                    (key == :students && controller_path.start_with?("admin/students")) ||
                    (key == :guardians && controller_path.start_with?("admin/guardians")) ||
                    (key == :teachers && controller_path.start_with?("admin/teachers")) ||
                    (key == :teacher_profile && controller_path.start_with?("teacher/profiles")) ||
                    (key == :student_profile && controller_path.start_with?("student/profiles")) ||
                    (key == :guardian_children && controller_path == "parent/students") ||
                    (key == :guardian_schedule && controller_path == "parent/schedule") ||
                    (key == :guardian_attendance && controller_path == "parent/attendances") ||
                    (key == :guardian_reports && controller_path == "parent/reports") ||
                    (key == :guardian_notifications && controller_path == "parent/notifications") ||
                    (key == :guardian_profile && controller_path == "parent/profiles") ||
                    (key == :fee_plans && controller_path == "admin/fee_plans") ||
                    (key == :programs && controller_path == "admin/programs") ||
                    (key == :course_offerings && controller_path == "admin/course_offerings") ||
                    (key == :enrollments && controller_path == "admin/enrollments") ||
                    (key == :my_enrollments && controller_path == "student/enrollments") ||
                    (key == :schedule && controller_path.start_with?("admin/scheduled_lessons")) ||
                    (key == :profits_analytics && controller_path == "admin/academic_dashboard") ||
                    (key == :finance && controller_path == "admin/teacher_payrolls") ||
                    (key == :financial_reports && controller_path == "admin/operational_reports") ||
                    (key == :teacher_availability && controller_path.start_with?("admin/teacher_availability")) ||
                    (key == :teacher_schedule && controller_path == "teacher/schedule") ||
                    (key == :teacher_availability_self && controller_path.start_with?("teacher/availabilities")) ||
                    (key == :student_schedule && controller_path == "student/schedule") ||
                    (key == :payroll && controller_path.end_with?("payrolls")) ||
                    (key == :reports && controller_path.end_with?("reports")) ||
                    (key == :settings && controller_path == "admin/academy_settings") %>
        <% path = navigation_path(key, item) %>
        <li>
          <%= link_to path, class: nav_item_classes(active: active), aria: (active ? { current: "page" } : {}) do %>
            <span class="grid size-8 place-items-center rounded-lg bg-white/10 text-emerald-50 group-hover:bg-white/15"><%= icon item[:icon], size: 4 %></span>
            <span><%= t("navigation.#{key}") %></span>
            <% if item.fetch(:coming_soon, false) && !active %>
              <span class="ms-auto text-[10px] font-normal text-app-subtle"><%= t("navigation.coming_soon") %></span>
            <% end %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </nav>

  <div class="border-t border-white/10 p-4">
    <div class="rounded-xl bg-white/10 p-3">
      <p class="text-xs font-semibold text-white"><%= academy_brand_name %></p>
      <p class="mt-1 text-xs text-emerald-100/65"><%= t("app.academic_year") %></p>
    </div>
  </div>
</aside>
