<div class="space-y-3">
  <% notifications.each do |notification| %>
    <%= link_to path.call(notification), class: "ds-card block p-4 focus-visible:outline focus-visible:outline-2 focus-visible:outline-app-primary" do %>
      <div class="flex flex-wrap items-center justify-between gap-2"><strong><%= notification.recipient_guardian&.full_name || notification.recipient_user.full_name %> · <%= t("notifications.types.#{notification.notification_type}") %></strong><span class="ds-badge"><%= t("notifications.statuses.#{notification.status}") %></span></div>
      <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-3">
        <div><dt class="ds-caption"><%= t("notifications.fields.channel") %></dt><dd><%= t("notifications.channels.#{notification.channel}") %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.provider") %></dt><dd><%= t("notifications.providers.#{notification.provider}", default: notification.provider) %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.attempts") %></dt><dd><%= notification.attempt_count %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.sent_at") %></dt><dd><%= notification.sent_at ? l(notification.sent_at, format: :short) : t("notifications.not_available") %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.scheduled_at") %></dt><dd><%= notification.scheduled_at ? l(notification.scheduled_at, format: :short) : t("notifications.not_available") %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.queued_at") %></dt><dd><%= notification.queued_at ? l(notification.queued_at, format: :short) : t("notifications.not_available") %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.provider_id") %></dt><dd class="break-all"><%= notification.provider_message_id.presence || t("notifications.not_available") %></dd></div>
        <div><dt class="ds-caption"><%= t("notifications.fields.response") %></dt><dd><%= notification.provider_status.presence || t("notifications.not_available") %></dd></div>
      </dl>
    <% end %>
  <% end %>
</div>
