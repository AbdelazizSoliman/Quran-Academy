<% if assessment.errors.any? %><%= render "shared/components/alert", variant: :error, title: t("academic.errors.title"), message: assessment.errors.full_messages.to_sentence %><% end %>
<%= form_with model: form_model, url: local_assigns[:form_url], class: "space-y-6" do |form| %>
  <%= form.hidden_field :lock_version if assessment.persisted? %>
  <div class="ds-card grid gap-5 p-5 sm:grid-cols-2">
    <% unless assessment.persisted? %>
      <div><%= form.label :enrollment_id, t("academic.fields.enrollment"), class: "ds-label" %><%= form.collection_select :enrollment_id, enrollments, :id, ->(e) { "#{e.public_id} — #{e.student_profile.user.full_name}" }, {}, class: "ds-control mt-2" %></div>
      <% if admin %><div><%= form.label :teacher_profile_id, t("academic.fields.teacher"), class: "ds-label" %><%= form.collection_select :teacher_profile_id, TeacherProfile.includes(:user), :id, ->(p) { p.user.full_name }, {}, class: "ds-control mt-2" %></div><% end %>
      <div><%= form.label :assessment_template_id, t("academic.fields.template"), class: "ds-label" %><%= form.collection_select :assessment_template_id, AssessmentTemplate.where(status: "active").ordered, :id, ->(template) { template.localized_name }, {}, class: "ds-control mt-2" %></div>
    <% end %>
    <div><%= form.label :assessment_date, t("academic.fields.date"), class: "ds-label" %><%= form.date_field :assessment_date, class: "ds-control mt-2", required: true %></div>
    <div class="sm:col-span-2"><%= form.label :notes, t("academic.fields.notes"), class: "ds-label" %><%= form.text_area :notes, class: "ds-control mt-2", rows: 4 %></div>
  </div>
  <% if assessment.persisted? %>
    <fieldset class="ds-card p-5"><legend class="px-2 font-bold"><%= t("academic.scores.title") %></legend>
      <div class="grid gap-5 sm:grid-cols-2">
        <% scores.each do |score| %><% rubric = score.assessment_rubric_item %>
          <div><%= hidden_field_tag "scores[#{score.id}][lock_version]", score.lock_version %><label class="ds-label" for="score_<%= score.id %>"><%= rubric.localized_name %> (<%= rubric.weight %>%)</label>
            <% if rubric.numeric? %><%= number_field_tag "scores[#{score.id}][numeric_score]", score.numeric_score, id: "score_#{score.id}", min: 0, max: rubric.maximum_score, step: 0.01, class: "ds-control mt-2" %>
            <% else %><%= select_tag "scores[#{score.id}][rating]", options_for_select(AssessmentRubricItem::RATINGS.map { |rating| [t("academic.ratings.#{rating}"), rating] }, score.rating), id: "score_#{score.id}", class: "ds-control mt-2" %><% end %>
            <%= text_area_tag "scores[#{score.id}][comments]", score.comments, class: "ds-control mt-2", rows: 2, aria: { label: t("academic.fields.comments") } %></div>
        <% end %>
      </div>
    </fieldset>
  <% end %>
  <div class="flex justify-end"><%= render "shared/components/button", label: t("actions.save"), type: "submit" %></div>
<% end %>
