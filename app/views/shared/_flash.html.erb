<div aria-live="polite" class="mb-5 space-y-2">
  <% flash.each do |type, message| %>
    <% variant = { "alert" => :error, "warning" => :warning, "info" => :information }.fetch(type.to_s, :success) %>
    <%= render "shared/components/alert", message:, variant:, dismissible: true %>
  <% end %>
</div>
