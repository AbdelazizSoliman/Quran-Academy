<% field_name = ->(field) { "student_profile[schedule_rows][][#{field}]" if local_assigns[:native_fields] } %>
<div class="grid grid-cols-[1.1fr_1fr_0.85fr_1.1fr_auto] items-center gap-2 rounded-lg border border-gray-200 bg-gray-50 p-2" data-schedule-slots-row data-action="change->schedule-slots#sync input->schedule-slots#sync"><select <%= %(name="#{field_name.call(:weekday)}").html_safe if field_name.call(:weekday) %> class="ds-control min-w-0" data-slot-field="weekday"><% StudentProfile::WEEKDAYS.each do |day| %><option value="<%= day %>" <%= "selected" if day == slot["weekday"] %>><%= t("scheduling.catalogs.weekdays.#{day}") %></option><% end %></select><input <%= %(name="#{field_name.call(:time)}").html_safe if field_name.call(:time) %> type="time" class="ds-control min-w-0" style="direction:ltr" value="<%= slot["time"] %>" data-slot-field="time"><select <%= %(name="#{field_name.call(:duration)}").html_safe if field_name.call(:duration) %> class="ds-control min-w-0" title="مدة الحصة" data-slot-field="duration"><% [15, 20, 30, 45, 60, 90, 120].each do |m| %><option value="<%= m %>" <%= "selected" if m.to_s == slot["duration"].to_s %>><%= m %> د</option><% end %></select><input <%= %(name="#{field_name.call(:subject)}").html_safe if field_name.call(:subject) %> list="mh-subjects" placeholder="المادة (حفظ، تجويد…)" class="ds-control min-w-0" value="<%= slot["subject"] %>" data-slot-field="subject"><button type="button" aria-label="حذف" class="w-8 shrink-0 text-lg font-bold text-red-500" data-action="schedule-slots#remove">×</button></div>
