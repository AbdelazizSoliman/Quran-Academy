<%= render "shared/student_profiles/errors", profile: %>
<%= form_with model: profile, url: admin_students_path, class: "space-y-6" do |f| %>
  <%= f.hidden_field :create_account, value: "1" %>
  <fieldset class="ds-card p-5"><legend class="ds-section-title">الطالب</legend><p class="mt-1 ds-caption">الاسم والحالة والبيانات الأساسية والمالية.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div><%= f.label :first_name, "الاسم الأول *", class: "ds-label" %><%= f.text_field :first_name, value: params.dig(:student_profile, :first_name), required: true, class: "ds-control mt-2" %></div>
      <div><%= f.label :last_name, "اسم العائلة *", class: "ds-label" %><%= f.text_field :last_name, value: params.dig(:student_profile, :last_name), required: true, class: "ds-control mt-2" %></div>
      <div><%= f.label :display_name, "اسم الطالب داخل الأكاديمية", class: "ds-label" %><%= f.text_field :display_name, class: "ds-control mt-2" %></div>
      <div><%= f.label :date_of_birth, "تاريخ الميلاد", class: "ds-label" %><%= f.date_field :date_of_birth, class: "ds-control mt-2" %></div>
      <div><%= f.label :gender, "النوع", class: "ds-label" %><%= f.select :gender, [["غير محدد", "unspecified"], ["ذكر", "male"], ["أنثى", "female"]], {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :learning_status, "الحالة", class: "ds-label" %><%= f.select :learning_status, StudentProfile::LEARNING_STATUSES.map { |v| [t("student_profiles.catalogs.learning_statuses.#{v}", default: v.humanize), v] }, {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :country_of_residence, "دولة الطالب", class: "ds-label" %><%= f.text_field :country_of_residence, value: "مصر", class: "ds-control mt-2" %></div>
      <div><%= f.label :current_quran_level, "المستوى", class: "ds-label" %><%= f.select :current_quran_level, StudentProfile::QURAN_LEVELS.map { |v| [v.humanize, v] }, {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :student_type, "نوع الطالب", class: "ds-label" %><%= f.select :student_type, StudentProfile::STUDENT_TYPES.map { |v| [v.humanize, v] }, {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :wallet_balance, "الرصيد في المحفظة", class: "ds-label" %><%= f.number_field :wallet_balance, min: 0, step: 0.01, class: "ds-control mt-2" %></div>
      <div><%= f.label :discount_percentage, "نسبة الخصم %", class: "ds-label" %><%= f.number_field :discount_percentage, min: 0, max: 100, step: 0.01, class: "ds-control mt-2" %></div>
      <div><%= f.label :preferred_learning_language, "لغة الدراسة", class: "ds-label" %><%= f.select :preferred_learning_language, (AcademySetting.current_or_nil&.teaching_languages || %w[ar en]).map { |v| [t("academy.languages.#{v}", default: v), v] }, {}, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">المعلم والمنهج</legend><p class="mt-1 ds-caption">اختيار المعلم المسؤول والعرض التعليمي أو الباقة.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div><%= f.label :assigned_teacher_profile_id, "المعلم المسؤول", class: "ds-label" %><%= f.collection_select :assigned_teacher_profile_id, teachers, :id, :display_name, { include_blank: "اختر معلماً" }, class: "ds-control mt-2" %></div>
      <div><%= f.label :course_offering_id, "العرض التعليمي / الكورس", class: "ds-label" %><%= f.collection_select :course_offering_id, offerings, :id, :title_ar, { include_blank: "بدون — يمكن الإلحاق لاحقاً" }, class: "ds-control mt-2" %></div>
      <div><%= f.label :package_name, "خطة الرسوم / الباقة", class: "ds-label" %><%= f.text_field :package_name, class: "ds-control mt-2", placeholder: "مثال: باقة شهرية" %></div>
      <div><%= f.label :learning_goals, "المنهج المراد تعلمه", class: "ds-label" %><%= f.text_area :learning_goals, rows: 2, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">الجدول والسعر</legend><p class="mt-1 ds-caption">إعداد مواعيد الطالب الأساسية وتفاصيل الحصة.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-4">
      <div><%= f.label :sessions_per_month, "حصص / شهر", class: "ds-label" %><%= f.number_field :sessions_per_month, min: 1, value: 8, class: "ds-control mt-2" %></div>
      <div><%= f.label :lesson_duration_minutes, "مدة الحصة (دقيقة)", class: "ds-label" %><%= f.number_field :lesson_duration_minutes, min: 1, value: 45, class: "ds-control mt-2" %></div>
      <div><%= f.label :weekly_lesson_count, "تكرار أسبوعي", class: "ds-label" %><%= f.number_field :weekly_lesson_count, min: 1, value: 2, class: "ds-control mt-2" %></div>
      <div><%= f.label :session_type, "نوع الحصة", class: "ds-label" %><%= f.select :session_type, [["فردي (1:1)", "individual"], ["جماعي", "group"]], {}, class: "ds-control mt-2" %></div>
      <div class="md:col-span-2"><%= f.label :trial_lesson_at, "موعد الحصة التجريبية", class: "ds-label" %><%= f.datetime_local_field :trial_lesson_at, class: "ds-control mt-2" %></div>
      <% weekday_options = StudentProfile::WEEKDAYS.map { |day| [I18n.t("date.day_names")[StudentProfile::WEEKDAYS.index(day)], day] } %>
      <% 3.times do |index| %>
        <% position = index + 1 %>
        <div><%= f.label "schedule_weekday_#{position}", "يوم الحصة #{position}", class: "ds-label" %><%= f.select "schedule_weekday_#{position}", weekday_options, { include_blank: position == 1 ? "اختر اليوم" : "موعد إضافي اختياري" }, class: "ds-control mt-2" %></div>
        <div><%= f.label "schedule_time_#{position}", "وقت الحصة #{position}", class: "ds-label" %><%= f.time_field "schedule_time_#{position}", class: "ds-control mt-2" %></div>
      <% end %>
      <div><%= f.label :weekly_price, "السعر الأسبوعي", class: "ds-label" %><%= f.number_field :weekly_price, min: 0, step: 0.01, class: "ds-control mt-2" %></div>
      <div><%= f.label :billing_currency, "العملة", class: "ds-label" %><%= f.select :billing_currency, %w[EGP USD EUR GBP SAR AED].map { |c| [c, c] }, {}, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">ولي الأمر والإخوة</legend><p class="mt-1 ds-caption">اربط ولي أمر موجوداً أو أنشئ واحداً جديداً، ويمكن ربط أخ أو أخت مسجلين مسبقاً.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div class="md:col-span-3"><%= f.label :existing_guardian_id, "ولي أمر موجود", class: "ds-label" %><%= f.collection_select :existing_guardian_id, guardians, :id, :full_name, { include_blank: "إنشاء ولي أمر جديد أو بدون ولي أمر" }, class: "ds-control mt-2" %></div>
      <div><%= f.label :guardian_name, "اسم ولي الأمر الجديد", class: "ds-label" %><%= f.text_field :guardian_name, class: "ds-control mt-2" %></div>
      <div><%= f.label :guardian_email, "بريد ولي الأمر", class: "ds-label" %><%= f.email_field :guardian_email, class: "ds-control mt-2", dir: "ltr" %></div>
      <div><%= f.label :guardian_phone, "هاتف / واتساب ولي الأمر", class: "ds-label" %><%= f.telephone_field :guardian_phone, class: "ds-control mt-2", dir: "ltr" %></div>
      <div class="md:col-span-3"><%= f.label :sibling_student_profile_id, "إضافة أخ أو أخت مسجلين", class: "ds-label" %><%= f.collection_select :sibling_student_profile_id, students, :id, :display_name, { include_blank: "بدون" }, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">حسابات الدخول</legend><p class="mt-1 ds-caption">سيُنشأ الحساب وتُرسل دعوة التفعيل بالطريقة المتاحة في إعدادات الأكاديمية.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div><%= f.label :email, "بريد الطالب *", class: "ds-label" %><%= f.email_field :email, value: params.dig(:student_profile, :email), required: true, class: "ds-control mt-2", dir: "ltr" %></div>
      <div><%= f.label :phone_number, "هاتف الطالب", class: "ds-label" %><%= f.telephone_field :phone_number, required: true, class: "ds-control mt-2", dir: "ltr" %></div>
      <div><%= f.label :whatsapp_number, "واتساب الطالب", class: "ds-label" %><%= f.telephone_field :whatsapp_number, class: "ds-control mt-2", dir: "ltr" %></div>
      <div><%= f.label :preferred_contact_method, "طريقة التواصل", class: "ds-label" %><%= f.select :preferred_contact_method, [["واتساب", "whatsapp"], ["البريد", "email"], ["الهاتف", "phone"]], {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :account_delivery_method, "إرسال بيانات الدخول", class: "ds-label" %><%= f.select :account_delivery_method, [["واتساب", "whatsapp"], ["البريد", "email"], ["كلاهما", "both"]], {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :preferred_interface_locale, "لغة الرسائل والواجهة", class: "ds-label" %><%= f.select :preferred_interface_locale, [["العربية", "ar"], ["English", "en"]], {}, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>
  <div class="flex gap-3"><%= render "shared/components/button", label: "حفظ الطالب وإرسال الدعوة", type: "submit" %><%= render "shared/components/button", label: "إلغاء", href: admin_students_path, variant: :secondary %></div>
<% end %>
