<%= render "shared/student_profiles/errors", profile: %>
<%= form_with model: profile, url: admin_students_path, class: "space-y-6" do |f| %>
  <%= f.hidden_field :create_account, value: "1" %>
  <fieldset class="ds-card p-5"><legend class="ds-section-title">الطالب</legend><p class="mt-1 ds-caption">الاسم والحالة وتقدّم الحفظ.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div class="md:col-span-3"><label class="ds-label" for="student_profile_full_name">اسم الطالب *</label><%= text_field_tag "student_profile[full_name]", params.dig(:student_profile, :full_name), required: true, class: "ds-control mt-2", id: "student_profile_full_name", placeholder: "اسم الطالب" %></div>
      <div><%= f.label :public_id, "كود الطالب", class: "ds-label" %><%= f.text_field :public_id, class: "ds-control mt-2", dir: "ltr", placeholder: "اتركه فارغًا للتوليد التلقائي (STD-0001)" %></div>
      <div><%= f.label :date_of_birth, "تاريخ الميلاد (اختياري)", class: "ds-label" %><%= f.date_field :date_of_birth, class: "ds-control mt-2" %></div>
      <div><%= f.label :gender, "النوع (اختياري)", class: "ds-label" %><%= f.select :gender, [["— غير محدد —", ""], ["ذكر", "male"], ["أنثى", "female"]], {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :learning_status, "الحالة", class: "ds-label" %><%= f.select :learning_status, [["نشط", "active"], ["تجريبي", "trial"], ["متعثّر", "at_risk"], ["غير نشط", "inactive"]], {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :country_of_residence, "دولة الطالب", class: "ds-label" %><%= f.select :country_of_residence, StudentProfile::COUNTRIES.map { |code, name| [name, code] }, {}, class: "ds-control mt-2" %>
        <p class="mt-1 ds-caption">تُستخدم لبيانات الإقامة؛ حدّد المنطقة الزمنية بشكل مستقل.</p></div>
      <% selected_time_zone = params.dig(:student_profile, :time_zone).presence || EffectiveTimeZone.for %>
      <div><%= label_tag "student_profile_time_zone", t("admin.users.fields.time_zone"), class: "ds-label" %><%= select_tag "student_profile[time_zone]", options_for_select(ActiveSupport::TimeZone.all.map { |zone| [zone.to_s, zone.name] }, selected_time_zone), id: "student_profile_time_zone", class: "ds-control mt-2" %></div>
      <div><%= f.label :current_quran_level, "المستوى (اختياري)", class: "ds-label" %><%= f.select :current_quran_level, [["مبتدئ", "beginner"], ["متوسط", "intermediate"], ["متقدّم", "advanced"]], { include_blank: "— بدون —" }, class: "ds-control mt-2" %></div>
      <div><%= f.label :memorized_juz_count, "الأجزاء المحفوظة", class: "ds-label" %><%= f.number_field :memorized_juz_count, min: 0, max: 30, step: 1, value: (profile.memorized_juz_count || 0), class: "ds-control mt-2" %></div>
      <div><%= f.label :attendance_percentage, "نسبة الحضور %", class: "ds-label" %><%= f.number_field :attendance_percentage, min: 0, max: 100, step: 1, value: (profile.attendance_percentage || 100), class: "ds-control mt-2" %></div>
      <div><%= f.label :preferred_learning_language, "لغة الدراسة", class: "ds-label" %><%= f.select :preferred_learning_language, (AcademySetting.current_or_nil&.teaching_languages || %w[ar en]).map { |v| [t("admin.settings.languages.#{v}", default: v), v] }, {}, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">المعلّم والمنهج</legend><p class="mt-1 ds-caption">أسند معلّمًا، وحدّد المناهج التي يدرسها الطالب، وخطة الرسوم.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-2">
      <div><%= f.label :assigned_teacher_profile_id, "المعلم المسؤول", class: "ds-label" %><%= f.collection_select :assigned_teacher_profile_id, teachers, :id, :display_name, { include_blank: "— اختر معلّمًا —" }, class: "ds-control mt-2" %></div>
      <div><%= f.label :course_offering_id, "العرض التعليمي / الكورس (اختياري)", class: "ds-label" %><%= f.collection_select :course_offering_id, offerings, :id, :title_ar, { include_blank: "بدون — يمكن الإلحاق لاحقاً" }, class: "ds-control mt-2" %></div>
      <div>
        <p class="ds-label">المناهج (اختر واحدًا أو أكثر)</p>
        <div class="mt-2 rounded-xl border border-dashed border-gray-200 bg-gray-50 px-3.5 py-3 text-xs text-gray-400">لا توجد مناهج بعد — تُنشأ من صفحة المنهج.</div>
      </div>
      <div><%= f.label :fee_plan_id, "خطة الرسوم", class: "ds-label" %><%= f.collection_select :fee_plan_id, fee_plans, :id, :name, { include_blank: "بدون" }, class: "ds-control mt-2" %></div>
      <%# Not part of the Madarak reference form, kept: required for StudentProfile#missing_required_fields, %>
      <%# which gates whether a profile can ever reach "verified" status. %>
      <div class="md:col-span-2"><%= f.label :learning_goals, "المنهج المراد تعلمه", class: "ds-label" %><%= f.text_area :learning_goals, rows: 2, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">الجدول والسعر</legend><p class="mt-1 ds-caption">تُولَّد الحصص ورابط Zoom تلقائيًا حسب الجدول.</p>
    <details class="mt-3 rounded-xl border border-gray-200 bg-gray-50 p-3.5" open>
      <summary class="ds-label cursor-pointer select-none">طالب حالي عنده حصص بالفعل؟ (اختياري)</summary>
      <p class="mt-2.5 text-xs leading-7 text-gray-500">لو الطالب قديم وعنده اشتراك جارٍ، فعّل الخيار وأدخل عدد الحصص التي أخذها والمتبقية. سيبدأ العدّاد من مكانه الصحيح، ولن تُصدر فاتورة الآن — تُصدر فاتورة التجديد تلقائيًا بعد آخر حصة متبقية.</p>
      <label class="mt-2.5 mb-2.5 flex items-center gap-2 text-sm font-bold text-gray-900"><%= f.check_box :existing_student, class: "h-4 w-4" %> نعم، طالب حالي</label>
      <div class="grid gap-3.5 md:grid-cols-2">
        <div><%= f.label :prior_sessions_taken, "حصص أخذها بالفعل", class: "ds-label" %><%= f.number_field :prior_sessions_taken, min: 0, max: 500, value: (profile.prior_sessions_taken || 0), class: "ds-control mt-2" %></div>
        <div><%= f.label :remaining_sessions_at_onboarding, "حصص متبقية له", class: "ds-label" %><%= f.number_field :remaining_sessions_at_onboarding, min: 0, max: 500, value: (profile.remaining_sessions_at_onboarding || 0), class: "ds-control mt-2" %></div>
      </div>
    </details>
    <div class="mt-4 grid gap-4 md:grid-cols-4">
      <div><%= f.label :sessions_per_month, "عدد الحصص المشتراة", class: "ds-label" %><%= f.number_field :sessions_per_month, min: 1, max: 672, value: 8, class: "ds-control mt-2" %>
        <p class="mt-1 text-[11px] leading-relaxed text-gray-400">الإجمالي، لا الشهري. المدة تُحسب من مواعيدك الأسبوعية.</p></div>
      <div><%= f.label :lesson_duration_minutes, "مدة الحصة (دقيقة)", class: "ds-label" %><%= f.number_field :lesson_duration_minutes, min: 15, max: 120, value: 45, class: "ds-control mt-2" %></div>
      <div><%= f.label :schedule_generation_weeks, "توليد لكام أسبوع", class: "ds-label" %><%= f.number_field :schedule_generation_weeks, min: 1, max: 48, value: 4, class: "ds-control mt-2" %>
        <p class="mt-1 ds-caption">حتى 48 أسبوع (سنة كاملة).</p></div>
      <div><%= f.label :session_type, "نوع الحصة", class: "ds-label" %><%= f.select :session_type, [["فردي (1:1)", "individual"], ["جماعي (حلقة)", "group"]], {}, class: "ds-control mt-2" %></div>
    </div>
    <p class="text-xs text-gray-400">«جماعي»: الطلاب اللي تحدّدهم جماعي لنفس المعلّم في نفس اليوم والوقت يدخلوا نفس الرابط تلقائيًا، وتُحتسب ساعة الحلقة للمعلّم مرة واحدة.</p>
    <div class="rounded-xl border border-emerald-200 bg-emerald-50 p-3.5">
      <%= f.label :trial_lesson_at, "موعد الحصة التجريبية (للطالب التجريبي)", class: "ds-label" %><%= f.datetime_local_field :trial_lesson_at, class: "ds-control mt-2" %>
      <p class="mt-1.5 text-xs text-emerald-800">لو حدّدته، تُنشأ حصة تجريبية تلقائيًا بالرابط، وبعد حضورها يُطلب من الطالب إن كان يرغب بالاشتراك — ويصلك إشعار لتفعيله.</p>
    </div>

    <div data-controller="schedule-slots">
      <p class="ds-label">مواعيد الحصص (يوم + وقت لكل حصة)</p>
      <%= hidden_field_tag "student_profile[slots_json]", "", data: { "schedule-slots-target": "hidden" } %>
      <datalist id="mh-subjects">
        <% %w[حفظ تجويد مراجعة نورانية تلاوة تفسير عربية فقه].each do |s| %><option value="<%= s %>"></option><% end %>
      </datalist>
      <div class="mt-2 flex flex-col gap-2" data-schedule-slots-target="container"></div>
      <template data-schedule-slots-target="template">
        <%= render "shared/student_profiles/schedule_slot_row",
                   slot: { "weekday" => StudentProfile::WEEKDAYS.first, "time" => "17:00", "duration" => "45", "subject" => nil } %>
      </template>
      <button type="button" class="mt-2.5 rounded-full bg-amber-50 px-4 py-2 text-xs font-bold text-amber-800" data-action="schedule-slots#add">+ إضافة موعد</button>
      <p class="mt-2 text-[11px] leading-relaxed text-gray-500">كل حصة ليها يومها ووقتها ومدتها ومادتها. يعني تقدر تحط الأحد ساعة حفظ، والثلاثاء نص ساعة تجويد — والحصص واللينكات بتتعمل على الأساس ده بالظبط، والمعلّم بياخد أجره على المدة الحقيقية.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-4">
      <div><%= f.label :weekly_price, "السعر الشهري", class: "ds-label" %><%= f.number_field :weekly_price, min: 0, step: 0.01, value: 60, class: "ds-control mt-2" %></div>
      <div><%= f.label :billing_currency, "العملة", class: "ds-label" %><%= f.select :billing_currency, [["EGP ج.م", "EGP"], ["USD $", "USD"], ["SAR ر.س", "SAR"], ["AED د.إ", "AED"]], {}, class: "ds-control mt-2" %></div>
    </div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">إضافة إخوة (اختياري)</legend><p class="mt-1 ds-caption">إخوة يدخلون حلقة واحدة بنفس الرابط ونفس المعلّم في نفس الموعد.</p>
    <p class="text-xs leading-7 text-gray-500">سجّل إخوة الطالب (حتى ٤) تحت نفس ولي الأمر ونفس المعلّم، ليدخلوا جميعًا حلقة واحدة بنفس الرابط في نفس الموعد.</p>
    <%# Madarak adds up to 4 NEW siblings inline (not built here — see follow-ups). QA's existing %>
    <%# link-to-an-existing-student-profile picker is kept as the closest working approximation. %>
    <div class="mt-3"><%= f.label :sibling_student_profile_id, "إضافة أخ أو أخت مسجلين", class: "ds-label" %><%= f.collection_select :sibling_student_profile_id, students, :id, :display_name, { include_blank: "بدون" }, class: "ds-control mt-2" %></div>
  </fieldset>

  <fieldset class="ds-card p-5"><legend class="ds-section-title">حسابات الدخول</legend><p class="mt-1 ds-caption">بيانات ولي الأمر اختيارية — لو الطالب معندوش ولي أمر سيبها فاضية. تُنشأ الحسابات تلقائيًا وتُرسَل الدعوات.</p>
    <div class="mt-4 grid gap-4 md:grid-cols-3">
      <div><%= f.label :guardian_name, "اسم ولي الأمر (اختياري)", class: "ds-label" %><%= f.text_field :guardian_name, class: "ds-control mt-2", placeholder: "أبو عبد الله" %></div>
      <div class="md:col-span-2">
        <%= f.label :guardian_phone, "هاتف ولي الأمر ودولته (اختياري)", class: "ds-label" %>
        <div class="mt-2 grid grid-cols-[10rem_1fr] gap-2">
          <%= f.select :guardian_phone_country_code, StudentProfile::PHONE_COUNTRY_CODES.map { |code, (name, dial)| ["#{name} +#{dial}", code] }, {}, class: "ds-control min-w-0" %>
          <%= f.telephone_field :guardian_phone, class: "ds-control min-w-0", dir: "ltr", placeholder: "1001234567" %>
        </div>
        <p class="mt-1 ds-caption">اكتب الرقم من غير كود الدولة ومن غير الصفر — مثال: 1001234567.</p>
      </div>
      <div><%= f.label :account_delivery_method, "طريقة الإشعار", class: "ds-label" %><%= f.select :account_delivery_method, [["واتساب (الأساسي)", "whatsapp"], ["واتساب والبريد", "both"]], {}, class: "ds-control mt-2" %></div>
      <div><%= f.label :preferred_interface_locale, "لغة الرسائل", class: "ds-label" %><%= f.select :preferred_interface_locale, [["العربية", "ar"], ["English", "en"]], {}, class: "ds-control mt-2" %>
        <p class="mt-1 ds-caption">لغة رسائل الواتساب والبريد لهذه العائلة.</p></div>
      <div><%= f.label :guardian_email, "بريد ولي الأمر (اختياري)", class: "ds-label" %><%= f.email_field :guardian_email, class: "ds-control mt-2", dir: "ltr", placeholder: "parent@example.com" %></div>
      <div><%= f.label :email, "بريد الطالب (اختياري)", class: "ds-label" %><%= f.email_field :email, value: params.dig(:student_profile, :email), class: "ds-control mt-2", dir: "ltr", placeholder: "student@example.com" %></div>
      <div>
        <%= f.label :whatsapp_number, "واتساب الطالب (اختياري)", class: "ds-label" %>
        <div class="mt-2 grid grid-cols-[10rem_1fr] gap-2">
          <%= f.select :whatsapp_number_country_code, StudentProfile::PHONE_COUNTRY_CODES.map { |code, (name, dial)| ["#{name} +#{dial}", code] }, {}, class: "ds-control min-w-0" %>
          <%= f.telephone_field :whatsapp_number, class: "ds-control min-w-0", dir: "ltr", placeholder: "6143715244" %>
        </div>
        <p class="mt-1 ds-caption">رقم الطالب نفسه — اكتبه من غير كود الدولة ومن غير الصفر؛ لو اتحط، رسائله تروح عليه بدل ولي الأمر.</p>
      </div>
    </div>
  </fieldset>
  <div class="flex gap-3"><%= render "shared/components/button", label: "حفظ الطالب", type: "submit" %><%= render "shared/components/button", label: "إلغاء", href: admin_students_path, variant: :secondary %></div>
<% end %>
