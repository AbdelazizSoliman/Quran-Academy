<article class="ds-card p-5" data-component="stat-card">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="ds-supporting"><%= local_assigns.fetch(:label) %></p>
      <p class="mt-2 text-3xl font-bold text-app-text"><%= local_assigns.fetch(:value) %></p>
    </div>
    <% if local_assigns[:icon] %>
      <span class="grid size-10 place-items-center rounded-xl bg-app-primary-soft text-app-primary"><%= icon local_assigns[:icon] %></span>
    <% end %>
  </div>
  <% if local_assigns[:note].present? %><p class="mt-4 ds-caption"><%= note %></p><% end %>
</article>
