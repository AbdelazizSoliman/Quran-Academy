DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
RAILS_MAX_THREADS=5
APP_HOST=localhost
APP_PORT=3000
DEFAULT_URL_OPTIONS_PROTOCOL=http
MAILER_SENDER=
RESEND_API_KEY=
# In production, replace these three with the academy's real Cloud API number and System User
# token (see README "Production cutover: replacing the Meta test number"). Keep WHATSAPP_ENABLED=false
# until the production number is verified and smoke-tested.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ENABLED=false
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_ACCOUNT_SETUP_TEMPLATE=quran_account_setup
WHATSAPP_ACCOUNT_SETUP_LANGUAGE=en_US
# Exact fixed URL prefix approved in Meta; no {{1}} placeholder.
WHATSAPP_ACCOUNT_SETUP_URL_PREFIX=http://localhost:3000/account/invitation/
WHATSAPP_LESSON_REMINDER_TEMPLATE=quran_lesson_reminder
WHATSAPP_LESSON_REMINDER_LANGUAGE=en_US
# Quran Academy origin/path prefix approved on the template's Join lesson button.
WHATSAPP_LESSON_JOIN_URL_PREFIX=http://localhost:3000/
NOTIFICATION_ACTOR_ID=

# Opt-in local demo dataset. Never enabled in production.
DEMO_DATA=false

# Optional first-administrator bootstrap values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
