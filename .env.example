DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=
RAILS_MAX_THREADS=5
APP_HOST=localhost
APP_PORT=3000
DEFAULT_URL_OPTIONS_PROTOCOL=http
MAILER_SENDER=no-reply@quran-academy.example

# Production SMTP delivery. Use a Gmail App Password, never the normal account password.
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_DOMAIN=gmail.com
SMTP_USERNAME=your-google-account@example.com
SMTP_PASSWORD=replace-with-a-google-app-password
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true

# Optional first-administrator bootstrap values.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
